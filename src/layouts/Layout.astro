---
import Header from "@/components/Navbar.astro";
import Footer from "@/sections/Footer.astro";
import ClientRouter from "astro/components/ClientRouter.astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageType?: string;
}

const {
  title,
  description,
  image = "/img/og-xauendevs.svg",
  imageType,
} = Astro.props;

const siteOrigin = import.meta.env.PROD
  ? Astro.site
  : new URL(Astro.url.origin);

const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const socialImage = new URL(image, siteOrigin).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="XauenDevs" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {imageType && <meta property="og:image:type" content={imageType} />}
    {imageType && <meta property="og:image:secure_url" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <Header />
    <main class="min-w-0 px-4 sm:px-6 md:px-10">
      <slot class="" />
    </main>
    <Footer />
    <ClientRouter />
  </body>
</html>
<style is:global>
  :root {
    --color-primary: #ddd;
    --color-secondary: #333;
    --color-accent: #f6b703;
    --color-accent-text: #6b4f00;
    --color-focus: #0d0d0d;
    --color-dark: #0d0d0d;
    --color-accent-rgb: 246, 183, 3;

    --background-color: #0a0c00;
    --background-twitch: var(--color-twitch-ice);

    --color-twitch: #9146ff;
    --color-twitch-ice: #f0f0ff;
  }

  html {
    font-family: "Roboto Flex Variable", system-ui, sans-serif;
    scroll-behavior: smooth;
  }

  :focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  ::placeholder {
    color: #666;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* Halloween: decoración temporal, sutil y sin alterar el contenido ni la navegación. */
  body {
    position: relative;
    isolation: isolate;
  }

  /* XauenDevs: Halloween editorial — noche, bruma y cobre encendido. */
  html {
    color-scheme: dark;
    background: #0b0a0a;
  }

  body {
    color: #f5f1ed;
    background:
      radial-gradient(ellipse at 12% 8%, rgba(120, 24, 15, .20), transparent 33rem),
      radial-gradient(ellipse at 92% 42%, rgba(180, 75, 14, .10), transparent 28rem),
      linear-gradient(180deg, #0c0b0b 0%, #11100f 52%, #0a0909 100%);
    position: relative;
    isolation: isolate;
  }

  /* Fine-grain atmosphere and a copper glow along the top edge. */
  body::before {
    content: "";
    position: fixed;
    z-index: 40;
    inset: 0 0 auto;
    height: 3px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent 0%, #702018 18%, #f07822 48%, #b52c1c 74%, transparent 100%);
    opacity: .95;
  }

  body::after {
    content: "✦";
    position: fixed;
    z-index: 40;
    top: 18%;
    right: clamp(18px, 4vw, 60px);
    color: #d75b2a;
    font-family: Georgia, serif;
    font-size: 25px;
    opacity: .7;
    pointer-events: none;
    text-shadow: 0 0 18px rgba(215, 91, 42, .35);
    animation: halloween-ember 5s ease-in-out infinite;
  }

  @keyframes halloween-ember {
    0%, 100% { transform: translateY(0) rotate(0deg); opacity: .38; }
    50% { transform: translateY(-12px) rotate(45deg); opacity: .9; }
  }

  header {
    border-bottom-color: rgba(224, 95, 43, .28) !important;
    box-shadow: 0 12px 38px rgba(0, 0, 0, .35);
  }

  header a[aria-label*="inicio"]::after { content: none !important; }

  /* Keep the site recognisable: Halloween accents, not a blanket black filter. */
  body main :where(p, li, small, label, dt, dd) {
    color: #e8e1db;
  }

  body main :where(h1, h2, h3, h4) {
    color: #fff8f1;
    text-wrap: pretty;
  }

  body main a {
    text-decoration-color: rgba(238, 130, 57, .65);
    text-underline-offset: 4px;
  }

  body main a:hover {
    color: #ffb56b;
    text-decoration-color: #ff8a3d;
  }

  body main [class*="text-black"],
  body main [class*="text-gray-900"],
  body main [class*="text-neutral-900"],
  body main [class*="text-stone-900"],
  body main [class*="text-zinc-900"] {
    color: #f3ece6 !important;
  }

  body main [class*="text-black/"] {
    color: #d9d0c9 !important;
  }

  body main [class*="bg-white"],
  body main [class*="bg-gray-50"],
  body main [class*="bg-stone-50"],
  body main [class*="bg-neutral-50"],
  body main [class*="bg-zinc-50"] {
    background-color: #191514 !important;
    color: #f4ede7 !important;
    border-color: rgba(232, 146, 91, .35) !important;
  }

  body main [class*="border-gray-200"],
  body main [class*="border-neutral-200"],
  body main [class*="border-stone-200"],
  body main [class*="border-zinc-200"] {
    border-color: rgba(232, 146, 91, .32) !important;
  }

  /* Event cards get a quiet ember edge and a more deliberate surface. */
  body main article,
  body main [class*="rounded-"][class*="border"] {
    border-color: rgba(232, 146, 91, .24);
  }

  body main article:hover,
  body main [class*="rounded-"][class*="border"]:hover {
    border-color: rgba(255, 138, 61, .65);
    box-shadow: 0 12px 40px rgba(0, 0, 0, .22), 0 0 24px rgba(190, 62, 25, .08);
  }

  body footer {
    color: #eee4dc;
    border-top: 1px solid rgba(224, 95, 43, .24);
    background: rgba(10, 9, 9, .92);
  }

  body footer :where(p, span, small, li, h1, h2, h3, h4, a) {
    color: #e8ded5;
  }

  body footer [class*="text-black"],
  body footer [class*="text-gray-900"],
  body footer [class*="text-neutral-900"] {
    color: #e8ded5 !important;
  }

  body footer a:hover { color: #ffb56b !important; }

  @media (max-width: 640px) {
    body::after { top: 15%; right: 14px; font-size: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    body::after { animation: none; }
  }

  #header-nav {
    animation: blur linear both;
    animation-timeline: scroll();
    animation-range: 0 500px;
  }
  @keyframes blur {
    to {
      box-shadow:
        0px 5px 50px -5px rgba(0, 0, 0, 0.1),
        0px 0px 0 1px rgba(0, 0, 0, 0.3);
      background: rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px);
    }
  }
</style>
<SpeedInsights />
<script>
  import { $, $$ } from "@/lib/dom-selector";

  const observer = new MutationObserver(() => {
    const $clipContainer = $$(".clip-container");
    if ($clipContainer) {
      initializeClipHandlers();
      observer.disconnect();
    }
  });
  observer.observe(document.body, { childList: true, subtree: true });

  const initializeClipHandlers = () => {
    const $clipContainer = $$(".clip-container");
    const $clipDialog = $(".clip-dialog") as HTMLDialogElement;
    const $closeButton = $(".close-dialog");
    let $ytFrame = $(".yt-iframe");
    const ytFrameCopy = $ytFrame;

    if (!$clipDialog) return;

    $clipDialog.addEventListener("close", () => {
      if ($ytFrame !== null) {
        $ytFrame.setAttribute("src", "");
      } else {
        ytFrameCopy?.setAttribute("src", "");
      }
    });

    $closeButton?.addEventListener("click", () => {
      $clipDialog.close();
    });

    $clipDialog.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target === $clipDialog) $clipDialog.close();
    });

    $clipContainer?.forEach((el) => {
      el.addEventListener("click", async (event) => {
        const currentTarget = event.currentTarget as HTMLElement;
        const { url } = currentTarget.dataset;
        if (!url) return;
        $ytFrame = $(".yt-iframe") as HTMLIFrameElement;
        if ($ytFrame !== null) {
          $ytFrame.setAttribute("src", `${url}&autoplay=1`);
        } else {
          if (ytFrameCopy) {
            $clipDialog?.querySelector("div")?.prepend(ytFrameCopy);
            ytFrameCopy.setAttribute("src", `${url}&autoplay=1`);
          }
        }
        $clipDialog.showModal();
      });
    });
  };

  document.addEventListener("astro:after-swap", initializeClipHandlers);
</script>
