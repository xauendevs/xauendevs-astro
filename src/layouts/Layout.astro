---
import Header from "@/components/Navbar.astro";
import Footer from "@/sections/Footer.astro";
import ClientRouter from "astro/components/ClientRouter.astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageType?: string;
}

const {
  title,
  description,
  image = "/img/og-xauendevs.svg",
  imageType,
} = Astro.props;

const siteOrigin = import.meta.env.PROD
  ? Astro.site
  : new URL(Astro.url.origin);

const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const socialImage = new URL(image, siteOrigin).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="XauenDevs" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {imageType && <meta property="og:image:type" content={imageType} />}
    {imageType && <meta property="og:image:secure_url" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <Header />
    <main class="min-w-0 px-4 sm:px-6 md:px-10">
      <slot class="" />
    </main>
    <Footer />
    <ClientRouter />
  </body>
</html>
<style is:global>
  :root {
    --color-primary: #ddd;
    --color-secondary: #333;
    --color-accent: #f6b703;
    --color-accent-text: #6b4f00;
    --color-focus: #0d0d0d;
    --color-dark: #0d0d0d;
    --color-accent-rgb: 246, 183, 3;

    --background-color: #0a0c00;
    --background-twitch: var(--color-twitch-ice);

    --color-twitch: #9146ff;
    --color-twitch-ice: #f0f0ff;
  }

  html {
    font-family: "Roboto Flex Variable", system-ui, sans-serif;
    scroll-behavior: smooth;
  }

  :focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  ::placeholder {
    color: #666;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* Halloween: decoración temporal, sutil y sin alterar el contenido ni la navegación. */
  body {
    position: relative;
    isolation: isolate;
  }

  /* Telaraña decorativa en la esquina superior derecha. */
  body::before {
    content: "";
    position: fixed;
    z-index: 50;
    top: 0;
    right: 0;
    width: clamp(90px, 15vw, 190px);
    aspect-ratio: 1;
    pointer-events: none;
    opacity: 0.48;
    background:
      repeating-conic-gradient(from 0deg at 100% 0%, transparent 0deg 14deg, rgba(120, 120, 120, .65) 14.4deg 14.9deg, transparent 15.2deg 30deg),
      repeating-radial-gradient(circle at 100% 0%, transparent 0 17px, rgba(120, 120, 120, .6) 18px 19px, transparent 20px 29px);
    mask-image: linear-gradient(135deg, #000 0%, #000 42%, transparent 78%);
  }

  /* Murciélagos discretos; no interceptan clics ni afectan al layout. */
  body::after {
    content: "🦇";
    position: fixed;
    z-index: 50;
    top: 24%;
    right: 14px;
    font-size: clamp(20px, 2.5vw, 30px);
    pointer-events: none;
    opacity: .8;
    filter: grayscale(1);
    animation: halloween-bat-flight 7s ease-in-out infinite;
  }

  /* Sangre goteando bajo el logotipo, en escritorio y móvil. */
  header a[aria-label*="inicio"] {
    position: relative;
    isolation: isolate;
  }

  header a[aria-label*="inicio"]::after {
    content: "";
    position: absolute;
    z-index: 2;
    left: 5%;
    right: 8%;
    bottom: -5px;
    height: 12px;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 13% 0%, #a20d18 0 4px, transparent 4.5px),
      radial-gradient(ellipse at 31% 0%, #b51220 0 3px, transparent 3.5px),
      radial-gradient(ellipse at 57% 0%, #a20d18 0 4px, transparent 4.5px),
      radial-gradient(ellipse at 81% 0%, #b51220 0 3px, transparent 3.5px);
    clip-path: polygon(0 0, 100% 0, 100% 20%, 84% 20%, 82% 100%, 78% 100%, 77% 20%, 59% 20%, 57% 72%, 53% 72%, 52% 20%, 33% 20%, 31% 100%, 27% 100%, 26% 20%, 15% 20%, 13% 65%, 9% 65%, 9% 20%, 0 20%);
    filter: drop-shadow(0 2px 1px rgba(80, 0, 0, .25));
  }

  @keyframes halloween-bat-flight {
    0%, 100% { transform: translate(0, 0) rotate(-8deg); }
    50% { transform: translate(-16px, 12px) rotate(8deg); }
  }

  @media (max-width: 640px) {
    body::before { opacity: .3; width: 100px; }
    body::after { top: 32%; right: 5px; font-size: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    body::after { animation: none; }
  }

  .halloween-spider {
    position: fixed;
    z-index: 51;
    top: 0;
    left: clamp(12px, 5vw, 70px);
    font-size: 24px;
    pointer-events: none;
    transform-origin: top center;
    animation: halloween-spider-drop 8s ease-in-out infinite;
  }

  .halloween-spider::before {
    content: "";
    position: absolute;
    width: 1px;
    height: 48px;
    left: 50%;
    bottom: 100%;
    background: #aaa;
    transform: translateY(0);
  }

  .halloween-ghost {
    position: fixed;
    z-index: 51;
    right: clamp(18px, 7vw, 90px);
    bottom: 18%;
    font-size: clamp(24px, 4vw, 42px);
    opacity: .45;
    pointer-events: none;
    filter: grayscale(1);
    animation: halloween-ghost-float 9s ease-in-out infinite;
  }

  @keyframes halloween-spider-drop {
    0%, 100% { transform: translateY(-8px) rotate(-5deg); }
    50% { transform: translateY(22px) rotate(6deg); }
  }

  @keyframes halloween-ghost-float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-18px, -22px); }
  }

  @media (max-width: 640px) {
    .halloween-spider { left: 8px; font-size: 20px; }
    .halloween-ghost { bottom: 24%; right: 12px; font-size: 26px; opacity: .3; }
  }

  @media (prefers-reduced-motion: reduce) {
    .halloween-spider, .halloween-ghost { animation: none; }
  }

  /* Noche de Halloween: paleta monocroma con sangre como único acento. */
  html {
    color-scheme: dark;
    background: #090909;
  }

  body {
    color: #ededed;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(65, 65, 65, .28), transparent 55%),
      #090909;
  }

  body::marker { color: #eee; }

  /* Oscurece las superficies claras existentes sin rehacer los componentes. */
  body header,
  body footer {
    color: #ededed;
    background-color: rgba(12, 12, 12, .96) !important;
    border-color: #393939 !important;
  }

  body main [class~="bg-white"],
  body main [class~="bg-gray-50"],
  body main [class~="bg-stone-50"],
  body main [class~="bg-neutral-50"],
  body main [class~="bg-zinc-50"] {
    background-color: #171717 !important;
    color: #ededed !important;
    border-color: #393939 !important;
  }

  body main [class~="text-black"],
  body main [class~="text-gray-900"],
  body main [class~="text-neutral-900"],
  body main [class~="text-stone-900"] {
    color: #f1f1f1 !important;
  }

  body main [class~="border-gray-200"],
  body main [class~="border-neutral-200"],
  body main [class~="border-stone-200"] {
    border-color: #414141 !important;
  }

  body a:hover { text-decoration-color: #b51220; }

  /* Casa encantada anclada a la parte inferior, detrás del contenido. */
  .halloween-haunted-house {
    position: fixed;
    z-index: 1;
    left: -18px;
    bottom: -10px;
    width: clamp(170px, 25vw, 340px);
    opacity: .46;
    pointer-events: none;
    filter: grayscale(1) contrast(1.15);
    animation: halloween-house-haunt 6s ease-in-out infinite;
  }

  /* Relámpago: un destello blanco breve, no una pantalla parpadeando continuamente. */
  .halloween-lightning {
    position: fixed;
    z-index: 49;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: rgba(255, 255, 255, .12);
    animation: halloween-lightning-flash 11s linear infinite;
  }

  @keyframes halloween-lightning-flash {
    0%, 17%, 17.4%, 17.8%, 18.3%, 100% { opacity: 0; }
    17.2% { opacity: .65; }
    17.6% { opacity: .08; }
    18% { opacity: .38; }
  }

  @keyframes halloween-house-haunt {
    0%, 100% { transform: translateY(0); opacity: .4; }
    50% { transform: translateY(-4px); opacity: .55; }
  }

  @media (max-width: 640px) {
    .halloween-haunted-house { width: 175px; left: -24px; bottom: -5px; opacity: .28; }
  }

  @media (prefers-reduced-motion: reduce) {
    .halloween-haunted-house,
    .halloween-lightning { animation: none; }
  }

  #header-nav {
    animation: blur linear both;
    animation-timeline: scroll();
    animation-range: 0 500px;
  }
  @keyframes blur {
    to {
      box-shadow:
        0px 5px 50px -5px rgba(0, 0, 0, 0.1),
        0px 0px 0 1px rgba(0, 0, 0, 0.3);
      background: rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px);
    }
  }
</style>
<SpeedInsights />
<script>
  import { $, $$ } from "@/lib/dom-selector";

  const observer = new MutationObserver(() => {
    const $clipContainer = $$(".clip-container");
    if ($clipContainer) {
      initializeClipHandlers();
      observer.disconnect();
    }
  });
  observer.observe(document.body, { childList: true, subtree: true });

  const initializeClipHandlers = () => {
    const $clipContainer = $$(".clip-container");
    const $clipDialog = $(".clip-dialog") as HTMLDialogElement;
    const $closeButton = $(".close-dialog");
    let $ytFrame = $(".yt-iframe");
    const ytFrameCopy = $ytFrame;

    if (!$clipDialog) return;

    $clipDialog.addEventListener("close", () => {
      if ($ytFrame !== null) {
        $ytFrame.setAttribute("src", "");
      } else {
        ytFrameCopy?.setAttribute("src", "");
      }
    });

    $closeButton?.addEventListener("click", () => {
      $clipDialog.close();
    });

    $clipDialog.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target === $clipDialog) $clipDialog.close();
    });

    $clipContainer?.forEach((el) => {
      el.addEventListener("click", async (event) => {
        const currentTarget = event.currentTarget as HTMLElement;
        const { url } = currentTarget.dataset;
        if (!url) return;
        $ytFrame = $(".yt-iframe") as HTMLIFrameElement;
        if ($ytFrame !== null) {
          $ytFrame.setAttribute("src", `${url}&autoplay=1`);
        } else {
          if (ytFrameCopy) {
            $clipDialog?.querySelector("div")?.prepend(ytFrameCopy);
            ytFrameCopy.setAttribute("src", `${url}&autoplay=1`);
          }
        }
        $clipDialog.showModal();
      });
    });
  };

  document.addEventListener("astro:after-swap", initializeClipHandlers);
</script>
