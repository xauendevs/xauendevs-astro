---
import Header from "@/components/Navbar.astro";
import Footer from "@/sections/Footer.astro";
import ClientRouter from "astro/components/ClientRouter.astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageType?: string;
}

const {
  title,
  description,
  image = "/img/og-xauendevs.svg",
  imageType,
} = Astro.props;

const siteOrigin = import.meta.env.PROD
  ? Astro.site
  : new URL(Astro.url.origin);

const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const socialImage = new URL(image, siteOrigin).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="XauenDevs" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {imageType && <meta property="og:image:type" content={imageType} />}
    {imageType && <meta property="og:image:secure_url" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <div class="halloween-lightning" aria-hidden="true"></div>
    <Header />
    <main class="min-w-0 px-4 sm:px-6 md:px-10">
      <slot class="" />
    </main>
    <Footer />
    <ClientRouter />
  </body>
</html>
<style is:global>
  :root {
    --color-primary: #ddd;
    --color-secondary: #333;
    --color-accent: #f6b703;
    --color-accent-text: #6b4f00;
    --color-focus: #0d0d0d;
    --color-dark: #0d0d0d;
    --color-accent-rgb: 246, 183, 3;

    --background-color: #0a0c00;
    --background-twitch: var(--color-twitch-ice);

    --color-twitch: #9146ff;
    --color-twitch-ice: #f0f0ff;
  }

  html {
    font-family: "Roboto Flex Variable", system-ui, sans-serif;
    scroll-behavior: smooth;
  }

  :focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  ::placeholder {
    color: #666;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* Halloween: decoración temporal, sutil y sin alterar el contenido ni la navegación. */
  body {
    position: relative;
    isolation: isolate;
  }

  /* Telaraña decorativa en la esquina superior derecha. */
  body::before {
    content: "";
    position: fixed;
    z-index: 50;
    top: 0;
    right: 0;
    width: clamp(90px, 15vw, 190px);
    aspect-ratio: 1;
    pointer-events: none;
    opacity: 0.48;
    background:
      repeating-conic-gradient(from 0deg at 100% 0%, transparent 0deg 14deg, rgba(120, 120, 120, .65) 14.4deg 14.9deg, transparent 15.2deg 30deg),
      repeating-radial-gradient(circle at 100% 0%, transparent 0 17px, rgba(120, 120, 120, .6) 18px 19px, transparent 20px 29px);
    mask-image: linear-gradient(135deg, #000 0%, #000 42%, transparent 78%);
  }

  /* Murciélagos discretos; no interceptan clics ni afectan al layout. */
  body::after {
    content: "🦇";
    position: fixed;
    z-index: 50;
    top: 24%;
    right: 14px;
    font-size: clamp(20px, 2.5vw, 30px);
    pointer-events: none;
    opacity: .8;
    filter: grayscale(1);
    animation: halloween-bat-flight 7s ease-in-out infinite;
  }

  /* Gotas de sangre separadas bajo el logo: sin tapar las letras. */
  header a[aria-label*="inicio"] { position: relative; }
  header a[aria-label*="inicio"]::after {
    content: "";
    position: absolute;
    z-index: 2;
    left: 8%;
    right: 10%;
    bottom: -7px;
    height: 13px;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 12% 0%, #bd101d 0 3px, transparent 3.5px),
      linear-gradient(#bd101d, #bd101d) 12% 0 / 6px 7px no-repeat,
      radial-gradient(ellipse at 34% 0%, #e11d2e 0 2.5px, transparent 3px),
      linear-gradient(#e11d2e, #e11d2e) 34% 0 / 5px 10px no-repeat,
      radial-gradient(ellipse at 64% 0%, #bd101d 0 3px, transparent 3.5px),
      linear-gradient(#bd101d, #bd101d) 64% 0 / 6px 6px no-repeat,
      radial-gradient(ellipse at 84% 0%, #e11d2e 0 2.5px, transparent 3px),
      linear-gradient(#e11d2e, #e11d2e) 84% 0 / 5px 9px no-repeat;
    filter: drop-shadow(0 2px 2px rgba(120, 0, 0, .4));
  }

  @keyframes halloween-bat-flight {
    0%, 100% { transform: translate(0, 0) rotate(-8deg); }
    50% { transform: translate(-16px, 12px) rotate(8deg); }
  }

  @media (max-width: 640px) {
    body::before { opacity: .3; width: 100px; }
    body::after { top: 32%; right: 5px; font-size: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    body::after { animation: none; }
  }

  /* Noche de Halloween: paleta monocroma con sangre como único acento. */
  html {
    color-scheme: dark;
    background: #090909;
  }

  body {
    color: #ededed;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(65, 65, 65, .28), transparent 55%),
      #090909;
  }

  body::marker { color: #eee; }

  /* Oscurece las superficies claras existentes sin rehacer los componentes. */
  body header,
  body footer {
    color: #ededed;
    background-color: rgba(12, 12, 12, .96) !important;
    border-color: #393939 !important;
  }

  body footer :where(p, span, small, li, h1, h2, h3, h4, a) {
    color: #ededed;
  }

  body footer .text-black\/80,
  body footer [class*="text-black"],
  body footer [class*="text-gray-900"],
  body footer [class*="text-neutral-900"] {
    color: #ededed !important;
  }

  body footer a:hover { color: #f6b703 !important; }

  body main [class~="bg-white"],
  body main [class~="bg-gray-50"],
  body main [class~="bg-stone-50"],
  body main [class~="bg-neutral-50"],
  body main [class~="bg-zinc-50"] {
    background-color: #171717 !important;
    color: #ededed !important;
    border-color: #393939 !important;
  }

  body main [class~="text-black"],
  body main [class~="text-gray-900"],
  body main [class~="text-neutral-900"],
  body main [class~="text-stone-900"] {
    color: #f1f1f1 !important;
  }

  body main [class~="border-gray-200"],
  body main [class~="border-neutral-200"],
  body main [class~="border-stone-200"] {
    border-color: #414141 !important;
  }

  body a:hover { text-decoration-color: #b51220; }

  /* Relámpago de tormenta: flash corto, visible y con doble descarga. */
  .halloween-lightning {
    position: fixed;
    z-index: 999;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background:
      radial-gradient(ellipse at 78% 10%, rgba(220, 235, 255, .55), transparent 48%),
      rgba(220, 230, 255, .24);
    mix-blend-mode: screen;
    animation: halloween-lightning-flash 9s steps(1, end) infinite;
  }

  @keyframes halloween-lightning-flash {
    0%, 31%, 31.3%, 31.8%, 32.2%, 100% { opacity: 0; }
    31.1% { opacity: .95; }
    31.5% { opacity: .12; }
    32% { opacity: .72; }
  }

  @media (prefers-reduced-motion: reduce) {
    .halloween-lightning { animation: none; opacity: 0; }
  }

  #header-nav {
    animation: blur linear both;
    animation-timeline: scroll();
    animation-range: 0 500px;
  }
  @keyframes blur {
    to {
      box-shadow:
        0px 5px 50px -5px rgba(0, 0, 0, 0.1),
        0px 0px 0 1px rgba(0, 0, 0, 0.3);
      background: rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px);
    }
  }
</style>
<SpeedInsights />
<script>
  import { $, $$ } from "@/lib/dom-selector";

  const observer = new MutationObserver(() => {
    const $clipContainer = $$(".clip-container");
    if ($clipContainer) {
      initializeClipHandlers();
      observer.disconnect();
    }
  });
  observer.observe(document.body, { childList: true, subtree: true });

  const initializeClipHandlers = () => {
    const $clipContainer = $$(".clip-container");
    const $clipDialog = $(".clip-dialog") as HTMLDialogElement;
    const $closeButton = $(".close-dialog");
    let $ytFrame = $(".yt-iframe");
    const ytFrameCopy = $ytFrame;

    if (!$clipDialog) return;

    $clipDialog.addEventListener("close", () => {
      if ($ytFrame !== null) {
        $ytFrame.setAttribute("src", "");
      } else {
        ytFrameCopy?.setAttribute("src", "");
      }
    });

    $closeButton?.addEventListener("click", () => {
      $clipDialog.close();
    });

    $clipDialog.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target === $clipDialog) $clipDialog.close();
    });

    $clipContainer?.forEach((el) => {
      el.addEventListener("click", async (event) => {
        const currentTarget = event.currentTarget as HTMLElement;
        const { url } = currentTarget.dataset;
        if (!url) return;
        $ytFrame = $(".yt-iframe") as HTMLIFrameElement;
        if ($ytFrame !== null) {
          $ytFrame.setAttribute("src", `${url}&autoplay=1`);
        } else {
          if (ytFrameCopy) {
            $clipDialog?.querySelector("div")?.prepend(ytFrameCopy);
            ytFrameCopy.setAttribute("src", `${url}&autoplay=1`);
          }
        }
        $clipDialog.showModal();
      });
    });
  };

  document.addEventListener("astro:after-swap", initializeClipHandlers);
</script>
