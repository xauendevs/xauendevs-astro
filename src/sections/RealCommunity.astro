---
import SeasonFlyer from "@/components/season/SeasonFlyer.astro";
import { getSeason, SEASON_CONTENT } from "@/lib/season";

// Solo se muestra con una temporada activa (la página decide si la incluye).
const season = (await getSeason(Astro)) ?? "halloween";
---

<section
  aria-labelledby="real-community-title"
  class="py-2"
>
  <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:gap-12">
    <div
      class="relative overflow-hidden rounded-xl border border-season/70 shadow-[0_0_30px_rgb(var(--season-rgb)_/_0.25)]"
    >
      <img
        src={SEASON_CONTENT[season].community}
        alt="Asistentes a una charla de XauenDevs en un espacio de coworking en Jaén"
        width="1280"
        height="854"
        loading="lazy"
        decoding="async"
        class="aspect-[16/10] w-full object-cover"
      />
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-gradient-to-t from-night/60 via-transparent to-season/10"
      >
      </div>
    </div>

    <div class="relative">
      <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.28em] text-season">
        Personas · Eventos · Experiencias
      </p>
      <h2 id="real-community-title" class="text-3xl font-black tracking-tight text-white sm:text-4xl">
        Una comunidad real
      </h2>
      <p class="mt-6 max-w-xl leading-relaxed text-white/70">
        Detrás de XauenDevs hay personas. Personas que se reúnen, comparten, aprenden y disfrutan de la tecnología en un
        ambiente cercano y abierto.
      </p>
      <SeasonFlyer
        class="bat-float pointer-events-none absolute -top-3 right-0 hidden h-9 w-[4.5rem] text-white/10 [animation-delay:-3s] sm:block lg:right-16"
      />
    </div>
  </div>
</section>
