---
import Bat from "@/components/halloween/Bat.astro";
import Cobweb from "@/components/halloween/Cobweb.astro";
import Code from "@/components/icons/Code.astro";
import Rocket from "@/components/icons/Rocket.astro";
import Users from "@/components/icons/Users.astro";

const pillars = [
  {
    title: "¿Qué somos?",
    text: "Una comunidad abierta de personas apasionadas por la tecnología, el desarrollo y la innovación.",
    Icon: Users,
  },
  {
    title: "¿Qué queremos?",
    text: "Fomentar el talento, el conocimiento y las oportunidades en el ecosistema tecnológico de Jaén.",
    Icon: Rocket,
  },
  {
    title: "¿Cómo lo hacemos?",
    text: "Organizando charlas, eventos, meetups y actividades para conectar a la comunidad.",
    Icon: Code,
  },
];
---

<section
  id="own-mission"
  aria-labelledby="own-mission-title"
  class="relative mx-auto w-full max-w-[1398px] scroll-mt-6 px-4 py-12 sm:px-6 lg:py-14"
>
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.8fr)] lg:gap-12">
    <div class="relative">
      <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.28em] text-pumpkin">
        Comunidad · Tecnología · Jaén
      </p>
      <h2 id="own-mission-title" class="text-3xl font-black tracking-tight text-white sm:text-4xl">
        Nuestra misión
      </h2>
      <p class="mt-6 max-w-md leading-relaxed text-white/70">
        Impulsar la comunidad de desarrolladores y profesionales de la tecnología en Jaén, creando un espacio abierto
        para aprender, compartir y crecer juntos.
      </p>
      <Bat
        class="bat-float pointer-events-none absolute -top-2 right-6 hidden h-8 w-16 text-white/10 sm:block lg:right-12"
      />
    </div>

    <ul class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        pillars.map(({ title, text, Icon }) => (
          <li class="relative overflow-hidden rounded-xl border border-pumpkin/70 bg-gradient-to-b from-white/[0.03] to-transparent p-5 shadow-[0_0_24px_rgba(255,138,31,0.18),inset_0_0_30px_rgba(255,138,31,0.05)]">
            <Cobweb
              class="pointer-events-none absolute right-0 top-0 h-20 w-20 -scale-x-100 text-pumpkin/25"
            />
            <Icon class="relative size-9 text-pumpkin" />
            <h3 class="relative mt-6 font-bold text-white">{title}</h3>
            <p class="relative mt-3 text-sm leading-relaxed text-white/70">{text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
