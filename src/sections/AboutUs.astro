---
import SeasonFlyer from "@/components/season/SeasonFlyer.astro";

// Mismo contenido, marcado y distribución con o sin temporada. Con una temporada activa solo cambian
// los colores (clases `fest:`), la foto (--season-community-photo) y un murciélago/copo decorativo.
// Son tres párrafos cortos: se leen abiertos, sin acordeón.
const items = [
  {
    title: "¿Qué somos?",
    text: "XauenDevs nace en 2017 como comunidad de desarrolladores de software en la provincia de Jaén. Nuestro principal objetivo es difundir conocimiento sobre desarrollo y tecnología en general.",
  },
  {
    title: "¿Qué hacemos?",
    text: "Organizamos charlas mensuales, las Pivo&Code, con diferentes temáticas y profesionales de distintos campos, siempre relacionados con la tecnología.",
  },
  {
    title: "¿Quiénes somos?",
    text: "XauenDevs lo formamos 4 personas: Alberto Tejero, Alejandro, Adrián y Alberto. Nos apasionan el desarrollo y la tecnología y tratamos de transmitirlo en cada actividad que hacemos.",
  },
];
---

<section
  class="grid grid-cols-1 gap-6 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-8"
  id="own-mission"
  aria-labelledby="mission-title"
>
  <div class="relative rounded-3xl bg-black/5 p-7 lg:p-10 fest:bg-white/[0.04] fest:ring-1 fest:ring-season-alt/50">
    <h2 id="mission-title" class="text-3xl font-black tracking-tight">Nuestra misión</h2>
    <SeasonFlyer
      class="bat-float pointer-events-none absolute right-6 top-6 hidden h-8 w-16 text-white/10 sm:block lg:right-10 lg:top-10"
    />
    <div class="mt-6 flex flex-col gap-6">
      {
        items.map(({ title, text }) => (
          <div>
            <h3 class="text-lg font-bold fest:text-season">{title}</h3>
            <p class="mt-1.5 text-base leading-relaxed text-black/80 fest:text-white/80">{text}</p>
          </div>
        ))
      }
    </div>
  </div>
  <div class="relative min-h-[280px] overflow-hidden rounded-3xl fest:ring-1 fest:ring-season/50">
    <div
      role="img"
      aria-label="La sala llena durante una Pivo&Code en Cuatro Gatos Coworking"
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style="background-image:var(--season-community-photo, url('/img/home.webp'))"
    >
    </div>
  </div>
</section>
