---
import FromFor from "../components/FromFor.astro";
import FestiveHero from "@/components/season/FestiveHero.astro";
import { getSeason } from "@/lib/season";

// Con una temporada activa el hero es el mismo; solo cambian el fondo (capas de <FestiveHero />),
// los colores y el FROM :XAUEN FOR DEVS, que pasa a neón parpadeante.
const festive = !!(await getSeason(Astro));
---

<header
  class="relative isolate flex min-h-[540px] flex-col justify-end overflow-hidden rounded-3xl bg-black fest:bg-night px-7 py-10 md:min-h-[580px] md:px-12 md:py-14"
>
  {
    festive ? (
      <FestiveHero />
    ) : (
      <>
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-center bg-cover bg-no-repeat opacity-80 saturate-50 brightness-75"
          style="background-image:url('/img/header.webp')"
        ></div>
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black via-black/45 to-black/10"></div>
      </>
    )
  }

  <div class="relative z-10 max-w-4xl">
    <div class="mb-5 flex flex-wrap items-center gap-3">
      <span class="rounded-full bg-accent px-3 py-1 text-xs font-bold uppercase tracking-[0.16em] text-black fest:text-season-ink">
        XauenDevs
      </span>
      <span class="text-sm font-semibold text-white/70">Jaén · Desarrollo · Tecnología</span>
    </div>
    <h1 class="text-4xl font-black tracking-tight text-white md:text-6xl lg:text-7xl fest:[text-shadow:0_2px_18px_rgba(0,0,0,0.85)]">
      La comunidad de desarrollo y tecnología de Jaén.
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/75 md:text-xl fest:[text-shadow:0_2px_14px_rgba(0,0,0,0.9)]">
      Compartimos conocimiento, organizamos eventos y conectamos a personas con ganas de aprender, enseñar y crear.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/eventos"
        class="inline-flex rounded-full bg-accent px-6 py-3 font-bold text-black fest:text-season-ink transition hover:-translate-y-0.5 hover:shadow-lg fest:shadow-[0_0_28px_rgb(var(--season-rgb)_/_0.4)] fest:hover:shadow-[0_0_36px_rgb(var(--season-rgb)_/_0.6)] motion-reduce:transition-none"
      >
        Ver próximos eventos →
      </a>
      <a
        href="https://discord.gg/CC9e6dtqxQ"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex rounded-full border border-white/30 bg-white/10 px-6 py-3 font-bold text-white backdrop-blur-sm transition hover:-translate-y-0.5 hover:border-white/60 hover:bg-white/15 fest:border-season-alt fest:bg-season-alt/15 fest:hover:border-season-alt fest:hover:bg-season-alt/30 motion-reduce:transition-none"
      >
        Únete a la comunidad
      </a>
    </div>
  </div>

  <div class="relative z-10 mt-10 hidden md:block">
    {
      festive ? (
        <div class="relative w-fit" role="img" aria-label="From XauenDevs for Devs">
          <FromFor
            variant="festive"
            part="light"
            aria-hidden="true"
            class="[filter:drop-shadow(0_2px_10px_rgb(0_0_0_/_0.9))_drop-shadow(0_0_22px_rgb(var(--season-rgb)_/_0.35))]"
          />
          <!-- Capa naranja aparte: el neón parpadea animando solo su opacidad (compositor) -->
          <FromFor
            variant="festive"
            part="orange"
            aria-hidden="true"
            class="fromfor-orange absolute left-0 top-0 [filter:drop-shadow(0_2px_10px_rgb(0_0_0_/_0.8))_drop-shadow(0_0_22px_rgb(var(--season-rgb)_/_0.55))]"
          />
        </div>
      ) : (
        <FromFor />
      )
    }
  </div>
</header>
