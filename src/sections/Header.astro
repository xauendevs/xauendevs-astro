---
import FromFor from "../components/FromFor.astro";
import NextEventPill from "../components/NextEventPill.astro";
import Bat from "../components/halloween/Bat.astro";

// Brasas: posiciones deterministas (sin Math.random) para que el HTML sea estable entre builds.
const rand = (i: number, n: number) => {
  const x = Math.sin(i * 97.13 + n * 13.7) * 10000;
  return x - Math.floor(x);
};
const embers = Array.from({ length: 20 }, (_, i) => ({
  left: 3 + rand(i, 1) * 94, // % del ancho
  size: 2 + rand(i, 2) * 3.5, // px
  delay: -rand(i, 3) * 16, // s (negativo: ya están en marcha al cargar)
  duration: 9 + rand(i, 4) * 9, // s
  drift: (rand(i, 5) - 0.5) * 120, // px
}));

const bats = [
  { top: "14%", duration: 26, delay: -4, size: "h-7 w-14" },
  { top: "34%", duration: 34, delay: -19, size: "h-5 w-10" },
  { top: "9%", duration: 41, delay: -30, size: "h-6 w-12" },
];
---

<header
  data-hero
  class="hero relative isolate flex min-h-[620px] flex-col justify-center overflow-hidden rounded-3xl bg-night px-7 py-10 md:px-12 md:py-14 lg:aspect-[1983/793] lg:max-h-[820px] lg:min-h-[600px] lg:pb-24"
>
  <!-- 1. Foto: monocroma + duotono morado→naranja (sin tonos verdes) -->
  <div aria-hidden="true" class="layer hero-photo" style="background-image:url('/img/header.webp')"></div>
  <div aria-hidden="true" class="layer hero-tint"></div>
  <div aria-hidden="true" class="layer hero-scrim"></div>

  <!-- 2. Foco de luz que sigue al cursor -->
  <div aria-hidden="true" class="layer hero-spotlight"></div>

  <!-- 3. Niebla en movimiento -->
  <div aria-hidden="true" class="hero-fog"></div>

  <!-- 4. Overlay de diseño: telarañas, luna, murciélagos, calabazas, tumbas y niebla -->
  <div
    aria-hidden="true"
    class="layer hero-overlay"
    style="background-image:url('/img/halloween-overlay.webp')"
  >
  </div>

  <!-- 5. Luz de las calabazas (solo cuando el hero mantiene la proporción del overlay) -->
  <div aria-hidden="true" class="pglow" style="--x:4.8%;--y:82%"></div>
  <div aria-hidden="true" class="pglow" style="--x:93%;--y:87%"></div>
  <div aria-hidden="true" class="pglow pglow-sm" style="--x:88.5%;--y:93%"></div>

  <!-- 6. Brasas y murciélagos -->
  <div aria-hidden="true" class="hero-fx">
    {
      embers.map((e) => (
        <span
          class="ember"
          style={`--l:${e.left.toFixed(1)};--s:${e.size.toFixed(1)};--d:${e.delay.toFixed(1)};--t:${e.duration.toFixed(1)};--x:${e.drift.toFixed(0)}`}
        />
      ))
    }
    {
      bats.map((b) => (
        <div class="bat-fly" style={`--y:${b.top};--t:${b.duration};--d:${b.delay}`}>
          <Bat class:list={["bat-flap text-black [filter:drop-shadow(0_0_6px_rgba(255,138,31,0.55))]", b.size]} />
        </div>
      ))
    }
  </div>

  <div class="relative z-10 max-w-[min(100%,60rem)]">
    <div class="reveal" style="--i:0">
      <NextEventPill server:defer>
        <span
          slot="fallback"
          class="inline-flex rounded-full border border-pumpkin/60 px-5 py-2 text-xs font-bold uppercase tracking-[0.18em] text-pumpkin"
        >
          Próximo evento
        </span>
      </NextEventPill>
    </div>

    <h1
      class="reveal mt-6 max-w-xl text-lg text-white/95 [text-shadow:0_2px_14px_rgba(0,0,0,0.9)] sm:text-xl"
      style="--i:1"
    >
      La comunidad de desarrollo y tecnología de Jaén.
    </h1>

    <div class="reveal" style="--i:2">
      <FromFor
        variant="halloween"
        role="img"
        aria-label="From XauenDevs for Devs"
        class="mt-2 h-auto w-full max-w-[min(100%,clamp(560px,40vw,880px))] [filter:drop-shadow(0_0_22px_rgba(255,138,31,0.55))]"
      />
    </div>

    <p
      class="reveal mt-5 max-w-[34rem] text-base leading-relaxed text-white/80 [text-shadow:0_2px_14px_rgba(0,0,0,0.95)] sm:text-lg"
      style="--i:3"
    >
      Charlas, eventos y personas que comparten la misma pasión por la tecnología en la provincia de Jaén.
    </p>

    <div class="reveal mt-7 flex flex-wrap gap-3" style="--i:4">
      <a
        href="/eventos"
        class="inline-flex items-center gap-2.5 rounded-full bg-gradient-to-r from-pumpkin to-[#ffa63d] px-6 py-3 font-semibold text-black shadow-[0_0_28px_rgba(255,138,31,0.4)] transition hover:-translate-y-0.5 hover:shadow-[0_0_36px_rgba(255,138,31,0.6)] motion-reduce:transition-none"
      >
        <span aria-hidden="true">🎃</span>
        Ver próximos eventos
        <span aria-hidden="true">→</span>
      </a>
      <a
        href="/#own-mission"
        class="inline-flex items-center rounded-full border border-pumpkin/70 bg-night/40 px-6 py-3 font-semibold text-white backdrop-blur-sm transition hover:-translate-y-0.5 hover:border-pumpkin hover:bg-pumpkin/10 motion-reduce:transition-none"
      >
        Conoce nuestra misión
      </a>
    </div>
  </div>
</header>

<style>
  .layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* --- Foto en duotono ------------------------------------------------ */
  .hero-photo {
    inset: -5%;
    z-index: -30;
    background-size: cover;
    background-position: 72% 30%;
    background-repeat: no-repeat;
    filter: grayscale(1) contrast(1.2) brightness(0.95);
    transform: translate3d(calc(var(--px, 0) * -22px), calc(var(--py, 0) * -14px), 0);
    transition: transform 0.25s ease-out;
    will-change: transform;
  }
  .hero-tint {
    z-index: -29;
    background: linear-gradient(118deg, #3b0764 0%, #6d28d9 38%, #c2410c 78%, #ff8a1f 100%);
    mix-blend-mode: color;
    opacity: 0.92;
  }
  /* Legibilidad del texto a la izquierda + fundido con el resto de la página */
  .hero-scrim {
    z-index: -28;
    background:
      linear-gradient(90deg, rgba(8, 8, 11, 0.94) 0%, rgba(8, 8, 11, 0.72) 30%, rgba(8, 8, 11, 0.12) 62%, transparent 100%),
      linear-gradient(0deg, rgba(8, 8, 11, 0.7) 0%, transparent 38%),
      linear-gradient(180deg, rgba(8, 8, 11, 0.55) 0%, transparent 22%);
  }

  /* --- Foco con el cursor ---------------------------------------------- */
  .hero-spotlight {
    z-index: -20;
    background: radial-gradient(
      440px circle at var(--mx, 74%) var(--my, 36%),
      rgba(255, 176, 90, 0.3),
      rgba(255, 138, 31, 0.09) 46%,
      transparent 72%
    );
    mix-blend-mode: screen;
  }

  /* --- Niebla ----------------------------------------------------------- */
  .hero-fog {
    position: absolute;
    inset: auto -10% -10% -10%;
    height: 48%;
    z-index: -15;
    pointer-events: none;
    background:
      radial-gradient(42% 75% at 18% 100%, rgba(124, 58, 237, 0.55), transparent 70%),
      radial-gradient(46% 85% at 76% 100%, rgba(168, 85, 247, 0.42), transparent 70%);
    filter: blur(20px);
    animation: fog-drift 26s ease-in-out infinite alternate;
  }
  @keyframes fog-drift {
    from {
      transform: translate3d(-3%, 0, 0);
    }
    to {
      transform: translate3d(3%, -3%, 0);
    }
  }

  /* --- Overlay de diseño ---------------------------------------------- */
  .hero-overlay {
    z-index: -10;
    background-size: cover;
    background-position: 100% 100%;
    background-repeat: no-repeat;
    transform: translate3d(calc(var(--px, 0) * 8px), calc(var(--py, 0) * 5px), 0) scale(1.02);
    transition: transform 0.25s ease-out;
    will-change: transform;
  }
  @media (min-width: 768px) {
    .hero-overlay {
      background-position: 50% 100%;
    }
  }

  /* --- Luz de calabazas --------------------------------------------------- */
  .pglow {
    display: none;
    position: absolute;
    z-index: -9;
    left: var(--x);
    top: var(--y);
    width: 17%;
    aspect-ratio: 1;
    translate: -50% -50%;
    pointer-events: none;
    background: radial-gradient(circle, rgba(255, 150, 40, 0.6), rgba(255, 100, 0, 0.2) 40%, transparent 68%);
    mix-blend-mode: screen;
    animation: pglow 3.4s ease-in-out infinite alternate;
  }
  .pglow-sm {
    width: 9%;
    animation-duration: 2.6s;
    animation-delay: -1.2s;
  }
  @media (min-width: 1024px) {
    .pglow {
      display: block;
    }
  }
  @keyframes pglow {
    from {
      opacity: 0.5;
      scale: 0.92;
    }
    to {
      opacity: 1;
      scale: 1.08;
    }
  }

  /* --- Brasas y murciélagos ------------------------------------------------ */
  .hero-fx {
    position: absolute;
    inset: 0;
    z-index: -8;
    overflow: hidden;
    pointer-events: none;
  }
  .ember {
    position: absolute;
    bottom: -10px;
    left: calc(var(--l) * 1%);
    width: calc(var(--s) * 1px);
    height: calc(var(--s) * 1px);
    border-radius: 50%;
    background: radial-gradient(circle, #ffe2b0, #ff8a1f 60%, transparent 72%);
    box-shadow: 0 0 8px 2px rgba(255, 138, 31, 0.7);
    opacity: 0;
    animation: ember-rise calc(var(--t) * 1s) linear calc(var(--d) * 1s) infinite;
  }
  @keyframes ember-rise {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0;
    }
    10% {
      opacity: 0.95;
    }
    70% {
      opacity: 0.55;
    }
    100% {
      transform: translate3d(calc(var(--x) * 1px), -620px, 0) scale(0.3);
      opacity: 0;
    }
  }

  .bat-fly {
    position: absolute;
    left: -10%;
    top: var(--y);
    animation: bat-cross calc(var(--t) * 1s) linear calc(var(--d) * 1s) infinite;
  }
  @keyframes bat-cross {
    0% {
      transform: translate3d(0, 0, 0);
    }
    25% {
      transform: translate3d(30vw, -28px, 0);
    }
    50% {
      transform: translate3d(62vw, 16px, 0);
    }
    75% {
      transform: translate3d(92vw, -20px, 0);
    }
    100% {
      transform: translate3d(128vw, 6px, 0);
    }
  }
  .bat-fly :global(.bat-flap) {
    animation: bat-flap 0.3s ease-in-out infinite alternate;
  }
  @keyframes bat-flap {
    from {
      transform: scaleY(1);
    }
    to {
      transform: scaleY(0.45);
    }
  }

  /* --- Neón parpadeante en :XAUEN y \ -------------------------------------- */
  .hero :global(.fromfor-orange) {
    animation: neon 8s steps(1, end) infinite;
  }
  @keyframes neon {
    0%,
    91%,
    100% {
      opacity: 1;
    }
    92% {
      opacity: 0.55;
    }
    93% {
      opacity: 1;
    }
    95% {
      opacity: 0.7;
    }
    96% {
      opacity: 1;
    }
  }

  /* --- Entrada escalonada del contenido ------------------------------------ */
  .reveal {
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i, 0) * 110ms + 120ms);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translate3d(0, 18px, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fog,
    .pglow,
    .reveal,
    .bat-fly,
    .bat-fly :global(.bat-flap),
    .hero :global(.fromfor-orange) {
      animation: none !important;
    }
    .ember,
    .bat-fly {
      display: none;
    }
    .hero-photo,
    .hero-overlay {
      transition: none;
      transform: none;
    }
    .hero-overlay {
      transform: scale(1.02);
    }
  }
</style>

<script>
  // Foco de luz + parallax siguiendo al cursor. Solo con ratón y sin "reducir movimiento".
  function initHero() {
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    if (!hero || hero.dataset.fx === "on") return;
    hero.dataset.fx = "on";

    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!canHover || reduced) return;

    let raf = 0;
    hero.addEventListener("pointermove", (event) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const rect = hero.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        hero.style.setProperty("--mx", `${x}px`);
        hero.style.setProperty("--my", `${y}px`);
        hero.style.setProperty("--px", (x / rect.width - 0.5).toFixed(3));
        hero.style.setProperty("--py", (y / rect.height - 0.5).toFixed(3));
      });
    });

    hero.addEventListener("pointerleave", () => {
      cancelAnimationFrame(raf);
      ["--mx", "--my", "--px", "--py"].forEach((name) => hero.style.removeProperty(name));
    });
  }

  document.addEventListener("astro:page-load", initHero);
</script>
