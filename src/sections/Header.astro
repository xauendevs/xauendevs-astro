---
import FromFor from "../components/FromFor.astro";
import NextEventPill from "../components/NextEventPill.astro";
import Bat from "../components/halloween/Bat.astro";

// Brasas: posiciones deterministas (sin Math.random) para que el HTML sea estable entre builds.
const rand = (i: number, n: number) => {
  const x = Math.sin(i * 97.13 + n * 13.7) * 10000;
  return x - Math.floor(x);
};
const embers = Array.from({ length: 12 }, (_, i) => ({
  left: 3 + rand(i, 1) * 94, // % del ancho
  size: 2 + rand(i, 2) * 3.5, // px
  delay: -rand(i, 3) * 16, // s (negativo: ya están en marcha al cargar)
  duration: 9 + rand(i, 4) * 9, // s
  drift: (rand(i, 5) - 0.5) * 120, // px
}));

const bats = [
  { top: "14%", duration: 26, delay: -4, size: "h-7 w-14" },
  { top: "34%", duration: 34, delay: -19, size: "h-5 w-10" },
  { top: "9%", duration: 41, delay: -30, size: "h-6 w-12" },
];
---

<header
  data-hero
  class="hero relative isolate flex min-h-[620px] flex-col justify-center overflow-hidden rounded-3xl bg-night px-7 py-10 md:px-12 md:py-14 lg:aspect-[1983/793] lg:max-h-[820px] lg:min-h-[600px] lg:pb-24"
>
  <!-- 1. Foto en duotono morado→naranja (horneado en la imagen: sin filtros ni blend en tiempo real) -->
  <div aria-hidden="true" class="layer hero-photo" data-fx="photo" style="background-image:url('/img/hero-halloween.webp')"></div>
  <div aria-hidden="true" class="layer hero-scrim"></div>

  <!-- 2. Foco de luz que sigue al cursor -->
  <div aria-hidden="true" class="hero-spotlight" data-fx="spot"></div>

  <!-- 3. Niebla en movimiento -->
  <div aria-hidden="true" class="hero-fog"></div>

  <!-- 4. Overlay de diseño: telarañas, luna, murciélagos, calabazas, tumbas y niebla -->
  <div
    aria-hidden="true"
    class="layer hero-overlay"
    data-fx="overlay"
    style="background-image:url('/img/halloween-overlay.webp')"
  >
  </div>

  <!-- 5. Luz de las calabazas (solo cuando el hero mantiene la proporción del overlay) -->
  <div aria-hidden="true" class="pglow" style="--x:4.8%;--y:82%"></div>
  <div aria-hidden="true" class="pglow" style="--x:93%;--y:87%"></div>
  <div aria-hidden="true" class="pglow pglow-sm" style="--x:88.5%;--y:93%"></div>

  <!-- 6. Brasas y murciélagos -->
  <div aria-hidden="true" class="hero-fx">
    {
      embers.map((e) => (
        <span
          class="ember"
          style={`--l:${e.left.toFixed(1)};--s:${e.size.toFixed(1)};--d:${e.delay.toFixed(1)};--t:${e.duration.toFixed(1)};--x:${e.drift.toFixed(0)}`}
        />
      ))
    }
    {
      bats.map((b) => (
        <div class="bat-fly" style={`--y:${b.top};--t:${b.duration};--d:${b.delay}`}>
          <Bat class:list={["bat-flap text-black", b.size]} />
        </div>
      ))
    }
  </div>

  <div class="relative z-10 max-w-[min(100%,60rem)]">
    <div class="reveal" style="--i:0">
      <NextEventPill server:defer>
        <span
          slot="fallback"
          class="inline-flex rounded-full border border-pumpkin/60 px-5 py-2 text-xs font-bold uppercase tracking-[0.18em] text-pumpkin"
        >
          Próximo evento
        </span>
      </NextEventPill>
    </div>

    <h1
      class="reveal mt-6 max-w-xl text-lg text-white/95 [text-shadow:0_2px_14px_rgba(0,0,0,0.9)] sm:text-xl"
      style="--i:1"
    >
      La comunidad de desarrollo y tecnología de Jaén.
    </h1>

    <div
      class="reveal relative mt-2 w-full max-w-[min(100%,clamp(560px,40vw,880px))]"
      style="--i:2"
      role="img"
      aria-label="From XauenDevs for Devs"
    >
      <FromFor
        variant="halloween"
        part="light"
        aria-hidden="true"
        class="block h-auto w-full [filter:drop-shadow(0_0_22px_rgba(255,138,31,0.55))]"
      />
      <!-- Capa naranja aparte: el neón parpadea animando solo su opacidad (compositor) -->
      <FromFor
        variant="halloween"
        part="orange"
        aria-hidden="true"
        class="fromfor-orange absolute inset-0 block h-auto w-full [filter:drop-shadow(0_0_22px_rgba(255,138,31,0.55))]"
      />
    </div>

    <p
      class="reveal mt-5 max-w-[34rem] text-base leading-relaxed text-white/80 [text-shadow:0_2px_14px_rgba(0,0,0,0.95)] sm:text-lg"
      style="--i:3"
    >
      Charlas, eventos y personas que comparten la misma pasión por la tecnología en la provincia de Jaén.
    </p>

    <div class="reveal mt-7 flex flex-wrap gap-3" style="--i:4">
      <a
        href="/eventos"
        class="inline-flex items-center gap-2.5 rounded-full bg-gradient-to-r from-pumpkin to-[#ffa63d] px-6 py-3 font-semibold text-black shadow-[0_0_28px_rgba(255,138,31,0.4)] transition hover:-translate-y-0.5 hover:shadow-[0_0_36px_rgba(255,138,31,0.6)] motion-reduce:transition-none"
      >
        <span aria-hidden="true">🎃</span>
        Ver próximos eventos
        <span aria-hidden="true">→</span>
      </a>
      <a
        href="/#own-mission"
        class="inline-flex items-center rounded-full border border-pumpkin/70 bg-night/60 px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:border-pumpkin hover:bg-pumpkin/10 motion-reduce:transition-none"
      >
        Conoce nuestra misión
      </a>
    </div>
  </div>
</header>

<style>
  .layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* --- Foto en duotono ------------------------------------------------ */
  .hero-photo {
    inset: -5%;
    z-index: -30;
    background-size: cover;
    background-position: 72% 30%;
    background-repeat: no-repeat;
    transition: transform 0.25s ease-out;
    will-change: transform;
  }
  /* Legibilidad del texto a la izquierda + fundido con el resto de la página */
  .hero-scrim {
    z-index: -28;
    background:
      linear-gradient(90deg, rgba(8, 8, 11, 0.94) 0%, rgba(8, 8, 11, 0.72) 30%, rgba(8, 8, 11, 0.12) 62%, transparent 100%),
      linear-gradient(0deg, rgba(8, 8, 11, 0.7) 0%, transparent 38%),
      linear-gradient(180deg, rgba(8, 8, 11, 0.55) 0%, transparent 22%);
  }

  /* --- Foco con el cursor ---------------------------------------------- */
  /* Se mueve solo con transform (compositor); el degradado se pinta una vez */
  .hero-spotlight {
    position: absolute;
    left: 74%;
    top: 36%;
    width: 880px;
    height: 880px;
    margin: -440px 0 0 -440px;
    z-index: -20;
    pointer-events: none;
    background: radial-gradient(circle, rgba(255, 176, 90, 0.3), rgba(255, 138, 31, 0.09) 38%, transparent 66%);
    transition: transform 0.18s ease-out;
    will-change: transform;
  }

  /* --- Niebla ----------------------------------------------------------- */
  .hero-fog {
    position: absolute;
    inset: auto -10% -10% -10%;
    height: 48%;
    z-index: -15;
    pointer-events: none;
    background:
      radial-gradient(42% 75% at 18% 100%, rgba(124, 58, 237, 0.55), transparent 70%),
      radial-gradient(46% 85% at 76% 100%, rgba(168, 85, 247, 0.42), transparent 70%);
    will-change: transform;
    animation: fog-drift 26s ease-in-out infinite alternate;
  }
  @keyframes fog-drift {
    from {
      transform: translate3d(-3%, 0, 0);
    }
    to {
      transform: translate3d(3%, -3%, 0);
    }
  }

  /* --- Overlay de diseño ---------------------------------------------- */
  .hero-overlay {
    z-index: -10;
    background-size: cover;
    background-position: 100% 100%;
    background-repeat: no-repeat;
    transform: scale(1.02);
    transition: transform 0.25s ease-out;
    will-change: transform;
  }
  @media (min-width: 768px) {
    .hero-overlay {
      background-position: 50% 100%;
    }
  }

  /* --- Luz de calabazas --------------------------------------------------- */
  .pglow {
    display: none;
    position: absolute;
    z-index: -9;
    left: var(--x);
    top: var(--y);
    width: 17%;
    aspect-ratio: 1;
    translate: -50% -50%;
    pointer-events: none;
    background: radial-gradient(circle, rgba(255, 150, 40, 0.6), rgba(255, 100, 0, 0.2) 40%, transparent 68%);
    animation: pglow 3.4s ease-in-out infinite alternate;
  }
  .pglow-sm {
    width: 9%;
    animation-duration: 2.6s;
    animation-delay: -1.2s;
  }
  @media (min-width: 1024px) {
    .pglow {
      display: block;
    }
  }
  @keyframes pglow {
    from {
      opacity: 0.5;
    }
    to {
      opacity: 1;
    }
  }

  /* --- Brasas y murciélagos ------------------------------------------------ */
  .hero-fx {
    position: absolute;
    inset: 0;
    z-index: -8;
    overflow: hidden;
    pointer-events: none;
  }
  .ember {
    position: absolute;
    bottom: -10px;
    left: calc(var(--l) * 1%);
    width: calc(var(--s) * 1px);
    height: calc(var(--s) * 1px);
    border-radius: 50%;
    background: radial-gradient(circle, #fff0d0 0%, #ffb15c 35%, rgba(255, 138, 31, 0.55) 60%, transparent 75%);
    opacity: 0;
    animation: ember-rise calc(var(--t) * 1s) linear calc(var(--d) * 1s) infinite;
  }
  @keyframes ember-rise {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0;
    }
    10% {
      opacity: 0.95;
    }
    70% {
      opacity: 0.55;
    }
    100% {
      transform: translate3d(calc(var(--x) * 1px), -620px, 0) scale(0.3);
      opacity: 0;
    }
  }

  .bat-fly {
    position: absolute;
    left: -10%;
    top: var(--y);
    animation: bat-cross calc(var(--t) * 1s) linear calc(var(--d) * 1s) infinite;
  }
  @keyframes bat-cross {
    0% {
      transform: translate3d(0, 0, 0);
    }
    25% {
      transform: translate3d(30vw, -28px, 0);
    }
    50% {
      transform: translate3d(62vw, 16px, 0);
    }
    75% {
      transform: translate3d(92vw, -20px, 0);
    }
    100% {
      transform: translate3d(128vw, 6px, 0);
    }
  }
  .bat-fly :global(.bat-flap) {
    animation: bat-flap 0.3s ease-in-out infinite alternate;
  }
  /* Borde naranja vectorial en lugar de drop-shadow (los filtros animados repintan cada fotograma) */
  .bat-fly :global(.bat-flap path) {
    stroke: rgba(255, 138, 31, 0.75);
    stroke-width: 1.4px;
    paint-order: stroke;
  }
  @keyframes bat-flap {
    from {
      transform: scaleY(1);
    }
    to {
      transform: scaleY(0.45);
    }
  }

  /* --- Neón parpadeante en :XAUEN y \ -------------------------------------- */
  .hero :global(.fromfor-orange) {
    animation: neon 8s steps(1, end) infinite;
  }
  @keyframes neon {
    0%,
    91%,
    100% {
      opacity: 1;
    }
    92% {
      opacity: 0.55;
    }
    93% {
      opacity: 1;
    }
    95% {
      opacity: 0.7;
    }
    96% {
      opacity: 1;
    }
  }

  /* --- Entrada escalonada del contenido ------------------------------------ */
  .reveal {
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i, 0) * 110ms + 120ms);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translate3d(0, 18px, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  /* Pausa los efectos cuando el hero no se ve (ahorra GPU/CPU al hacer scroll) */
  .hero.is-paused .ember,
  .hero.is-paused .hero-fog,
  .hero.is-paused .pglow,
  .hero.is-paused .bat-fly,
  .hero.is-paused :global(.bat-flap),
  .hero.is-paused :global(.fromfor-orange) {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fog,
    .pglow,
    .reveal,
    .bat-fly,
    .bat-fly :global(.bat-flap),
    .hero :global(.fromfor-orange) {
      animation: none !important;
    }
    .ember,
    .bat-fly {
      display: none;
    }
    .hero-photo,
    .hero-overlay,
    .hero-spotlight {
      transition: none;
    }
  }
</style>

<script>
  // Foco de luz + parallax con el cursor. Solo escribe `transform` (sin variables CSS ni repintados).
  // Solo con ratón y sin "reducir movimiento".
  function initHero() {
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    if (!hero || hero.dataset.fx === "on") return;
    hero.dataset.fx = "on";

    // Pausa las animaciones cuando el hero sale de pantalla.
    new IntersectionObserver(([entry]) => hero.classList.toggle("is-paused", !entry.isIntersecting)).observe(hero);

    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!canHover || reduced) return;

    const photo = hero.querySelector<HTMLElement>('[data-fx="photo"]');
    const overlay = hero.querySelector<HTMLElement>('[data-fx="overlay"]');
    const spot = hero.querySelector<HTMLElement>('[data-fx="spot"]');
    if (!photo || !overlay || !spot) return;

    const apply = (px: number, py: number, dx: number, dy: number) => {
      photo.style.transform = `translate3d(${px * -22}px, ${py * -14}px, 0)`;
      overlay.style.transform = `translate3d(${px * 8}px, ${py * 5}px, 0) scale(1.02)`;
      spot.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
    };

    let raf = 0;
    hero.addEventListener("pointermove", (event) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const rect = hero.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        // El foco parte de (74 %, 36 %): se mueve la diferencia respecto a esa posición.
        apply(x / rect.width - 0.5, y / rect.height - 0.5, x - rect.width * 0.74, y - rect.height * 0.36);
      });
    });

    hero.addEventListener("pointerleave", () => {
      cancelAnimationFrame(raf);
      apply(0, 0, 0, 0);
    });
  }

  document.addEventListener("astro:page-load", initHero);
</script>
