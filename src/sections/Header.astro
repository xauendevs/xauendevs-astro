---
import FromFor from "../components/FromFor.astro";
import FestiveHero from "@/components/season/FestiveHero.astro";
import { getSeason } from "@/lib/season";
import { getPivosStrapi } from "@/lib/get-info-pivos";
import { slugify } from "@/lib/event-slug";
import { formatDate, formatTime } from "@/lib/format-date";
import { DISCORD_URL } from "@/consts/social-links";

// Con una temporada activa el hero es el mismo; solo cambian el fondo (capas de <FestiveHero />),
// los colores y el FROM :XAUEN FOR DEVS, que pasa a neón parpadeante.
const festive = !!(await getSeason(Astro));

// La próxima Pivo&Code va en la propia cabecera: es lo que viene a buscar casi todo el mundo.
const { STRAPI_HOST } = import.meta.env;
const now = Date.now();
const next = ((await getPivosStrapi()) ?? [])
  .filter((pivo) => pivo.date.getTime() > now)
  .sort((a, b) => a.date.getTime() - b.date.getTime())[0];
const nextHref = next ? `/eventos/${slugify(next.title)}` : "/eventos";
const speaker = next?.speakers?.[0];

// «Hoy», «Mañana», «En 5 días»… según el calendario de Madrid.
const dayKey = (d: Date) => d.toLocaleDateString("en-CA", { timeZone: "Europe/Madrid" });
const daysLeft = next ? Math.round((Date.parse(dayKey(next.date)) - Date.parse(dayKey(new Date()))) / 86400000) : 0;
const when = daysLeft <= 0 ? "Hoy" : daysLeft === 1 ? "Mañana" : `En ${daysLeft} días`;
---

<header
  class="relative isolate flex min-h-[540px] flex-col justify-end overflow-hidden rounded-3xl bg-black fest:bg-night px-7 py-10 md:min-h-[580px] md:px-12 md:py-14"
>
  {
    festive ? (
      <FestiveHero />
    ) : (
      <>
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-center bg-cover bg-no-repeat opacity-80 saturate-50 brightness-75"
          style="background-image:url('/img/header.webp')"
        ></div>
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black via-black/45 to-black/10"></div>
      </>
    )
  }

  <div class="relative z-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(320px,400px)] lg:items-end">
    <div class="max-w-3xl">
      <h1 class="text-4xl font-black tracking-tight text-white md:text-6xl fest:[text-shadow:0_2px_18px_rgba(0,0,0,0.85)]">
        La comunidad de desarrollo de Jaén.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/85 md:text-xl fest:[text-shadow:0_2px_14px_rgba(0,0,0,0.9)]">
        Cada mes, una charla Pivo&Code: alguien comparte lo que sabe y luego seguimos la conversación. Abierta a
        cualquiera con ganas de aprender.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={nextHref}
          class="inline-flex min-h-12 items-center rounded-full bg-accent px-6 py-3 font-bold text-black fest:text-season-ink transition hover:-translate-y-0.5 fest:shadow-[0_0_28px_rgb(var(--season-rgb)_/_0.4)] motion-reduce:transition-none"
        >
          {next ? "Apuntarme a la próxima" : "Ver próximos eventos"} <span aria-hidden="true" class="ml-1">→</span>
        </a>
        <a
          href={DISCORD_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-12 items-center rounded-full border border-white/40 px-6 py-3 font-bold text-white transition hover:-translate-y-0.5 hover:border-white hover:bg-white/10 fest:border-season-alt fest:hover:bg-season-alt/30 motion-reduce:transition-none"
        >
          Únete al Discord
        </a>
      </div>
    </div>

    {
      next ? (
        <a
          href={nextHref}
          class="group block rounded-2xl bg-white p-5 text-black transition hover:-translate-y-1 fest:bg-night/95 fest:text-white fest:ring-1 fest:ring-season/60 motion-reduce:transition-none sm:p-6"
          aria-label={`Próxima Pivo&Code: ${next.title}, ${formatDate(next.date)} a las ${formatTime(next.date)}`}
        >
          <div class="flex items-center justify-between gap-3">
            <span class="text-sm font-bold">Próxima Pivo&Code</span>
            <span class="rounded-full bg-accent px-3 py-1 text-sm font-bold text-black fest:text-season-ink">{when}</span>
          </div>
          <p class="mt-3 text-xl font-bold leading-snug group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">
            {next.title}
          </p>
          <dl class="mt-4 grid gap-2 text-base">
            <div class="flex items-center gap-2.5">
              <dt class="sr-only">Cuándo</dt>
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
              <dd class="font-semibold first-letter:uppercase">{formatDate(next.date)} · {formatTime(next.date)}</dd>
            </div>
            {next.place && (
              <div class="flex items-center gap-2.5">
                <dt class="sr-only">Dónde</dt>
                <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
                <dd>{next.place}</dd>
              </div>
            )}
            {speaker && (
              <div class="flex items-center gap-2.5">
                <dt class="sr-only">Ponente</dt>
                {speaker.photo ? (
                  <img src={STRAPI_HOST + speaker.photo} alt="" class="size-6 shrink-0 rounded-full object-cover" />
                ) : null}
                <dd>Con {next.speakers?.map((s) => s.name).join(", ")}</dd>
              </div>
            )}
          </dl>
          <span class="mt-5 flex min-h-12 items-center justify-center rounded-full bg-black px-5 font-bold text-white fest:bg-season fest:text-season-ink">
            Ver detalles y apuntarme <span aria-hidden="true" class="ml-1.5 transition-transform group-hover:translate-x-0.5">→</span>
          </span>
        </a>
      ) : (
        <div class="rounded-2xl bg-white p-6 text-black fest:bg-night/95 fest:text-white fest:ring-1 fest:ring-season/60">
          <p class="text-xl font-bold">Estamos preparando la próxima Pivo&Code.</p>
          <p class="mt-2">Te avisamos en el Discord en cuanto tengamos fecha.</p>
        </div>
      )
    }
  </div>

  <div class="relative z-10 mt-10 hidden md:block">
    {
      festive ? (
        <div class="relative w-fit" role="img" aria-label="From XauenDevs for Devs">
          <FromFor
            variant="festive"
            part="light"
            aria-hidden="true"
            class="[filter:drop-shadow(0_2px_10px_rgb(0_0_0_/_0.9))_drop-shadow(0_0_22px_rgb(var(--season-rgb)_/_0.35))]"
          />
          <!-- Capa naranja aparte: el neón parpadea animando solo su opacidad (compositor) -->
          <FromFor
            variant="festive"
            part="orange"
            aria-hidden="true"
            class="fromfor-orange absolute left-0 top-0 [filter:drop-shadow(0_2px_10px_rgb(0_0_0_/_0.8))_drop-shadow(0_0_22px_rgb(var(--season-rgb)_/_0.55))]"
          />
        </div>
      ) : (
        <FromFor />
      )
    }
  </div>
</header>
