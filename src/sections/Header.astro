---
import FromFor from "../components/FromFor.astro";
import NextEventPill from "../components/NextEventPill.astro";
---

<header
  class="relative isolate flex min-h-[580px] flex-col justify-center overflow-hidden rounded-3xl bg-night px-7 py-10 md:px-12 md:py-14"
>
  <!-- Foto de la comunidad, virada a morado/naranja -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-30 bg-cover bg-[position:70%_40%] bg-no-repeat [filter:hue-rotate(90deg)_saturate(1.4)_brightness(0.8)_contrast(1.1)]"
    style="background-image:url('/img/header.webp')"
  >
  </div>
  <div aria-hidden="true" class="absolute inset-0 -z-20 bg-gradient-to-r from-night via-night/70 to-transparent"></div>
  <div aria-hidden="true" class="absolute inset-0 -z-20 bg-gradient-to-t from-night via-transparent to-night/50"></div>

  <!-- Overlay de diseño: telarañas, luna, murciélagos, calabazas, tumbas y niebla -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-cover bg-[position:100%_50%] bg-no-repeat md:bg-center"
    style="background-image:url('/img/halloween-overlay.webp')"
  >
  </div>

  <div class="relative z-10 max-w-4xl">
    <NextEventPill server:defer>
      <span
        slot="fallback"
        class="inline-flex rounded-full border border-pumpkin/60 px-5 py-2 text-xs font-bold uppercase tracking-[0.18em] text-pumpkin"
      >
        Próximo evento
      </span>
    </NextEventPill>

    <h1 class="mt-6 max-w-xl text-lg text-white/95 [text-shadow:0_2px_14px_rgba(0,0,0,0.9)] sm:text-xl">
      La comunidad de desarrollo y tecnología de Jaén.
    </h1>

    <FromFor
      variant="halloween"
      role="img"
      aria-label="From XauenDevs for Devs"
      class="mt-2 h-auto w-full max-w-[min(100%,640px)] [filter:drop-shadow(0_0_20px_rgba(255,138,31,0.6))]"
    />

    <p class="mt-5 max-w-[34rem] text-base leading-relaxed text-white/80 [text-shadow:0_2px_14px_rgba(0,0,0,0.95)] sm:text-lg">
      Charlas, eventos y personas que comparten la misma pasión por la tecnología en la provincia de Jaén.
    </p>

    <div class="mt-7 flex flex-wrap gap-3">
      <a
        href="/eventos"
        class="inline-flex items-center gap-2.5 rounded-full bg-gradient-to-r from-pumpkin to-[#ffa63d] px-6 py-3 font-semibold text-black shadow-[0_0_28px_rgba(255,138,31,0.4)] transition hover:-translate-y-0.5 hover:shadow-[0_0_36px_rgba(255,138,31,0.6)] motion-reduce:transition-none"
      >
        <span aria-hidden="true">🎃</span>
        Ver próximos eventos
        <span aria-hidden="true">→</span>
      </a>
      <a
        href="/#own-mission"
        class="inline-flex items-center rounded-full border border-pumpkin/70 bg-night/40 px-6 py-3 font-semibold text-white backdrop-blur-sm transition hover:-translate-y-0.5 hover:border-pumpkin hover:bg-pumpkin/10 motion-reduce:transition-none"
      >
        Conoce nuestra misión
      </a>
    </div>
  </div>
</header>
