---
import PressCard from "@/components/PressCard.astro";
import { getPress } from "@/lib/press";

// Portada: las tres últimas apariciones en prensa. Va como server island (server:defer) para que leer
// las noticias no retrase la portada. Sin noticias no pinta nada.
const items = await getPress(3);
---

{
  items.length > 0 && (
    <section id="prensa" aria-labelledby="press-title">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <h2 id="press-title" class="text-4xl font-black tracking-tight md:text-5xl">En los medios</h2>
          <p class="mt-3 text-lg text-black/75 fest:text-white/75">Lo último que se ha publicado sobre XauenDevs.</p>
        </div>
        <a
          href="/prensa"
          class="inline-flex min-h-11 shrink-0 items-center self-start rounded-full border-2 border-black px-5 font-bold transition hover:bg-black hover:text-white fest:border-white fest:hover:bg-white fest:hover:text-black md:self-auto"
        >
          Ver toda la prensa <span aria-hidden="true" class="ml-1.5">→</span>
        </a>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((item) => <PressCard item={item} />)}
      </div>
    </section>
  )
}
