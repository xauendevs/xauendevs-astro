---
import PivosContainer from "@/components/PivosContainer.astro";
---

<section
  id="pivos"
  aria-labelledby="pivos-title"
  class="mx-auto w-full max-w-[1398px] px-4 py-8 sm:px-6"
>
  <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div class="max-w-2xl">
      <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.28em] text-pumpkin">
        Comunidad · Tecnología · Jaén
      </p>
      <h2 id="pivos-title" class="text-3xl font-black tracking-tight text-white sm:text-4xl md:text-5xl">
        Pivo&Code
      </h2>
      <p class="mt-3 text-base text-white/70 md:text-lg">
        Charlas para aprender, compartir lo que sabes y conocer a la gente que
        hace tecnología en nuestra provincia.
      </p>
    </div>

    <a
      data-astro-reload
      href="/eventos?tipo=xauen"
      class="shrink-0 font-semibold underline text-white decoration-pumpkin decoration-2 underline-offset-4 hover:text-pumpkin"
    >
      Ver todas las charlas →
    </a>
  </div>

  <PivosContainer server:defer />
</section>
