---
import PivosContainer from "@/components/PivosContainer.astro";
---

<section id="pivos" aria-labelledby="pivos-title">
  <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div class="max-w-2xl">
      <p class="mb-2 text-sm font-bold uppercase tracking-[0.2em] text-accent">
        Comunidad · Tecnología · Jaén
      </p>
      <h2 id="pivos-title" class="text-4xl font-black tracking-tight md:text-5xl">
        Pivo&Code
      </h2>
      <p class="mt-3 text-base text-black/65 md:text-lg">
        Charlas para aprender, compartir lo que sabes y conocer a la gente que
        hace tecnología en nuestra provincia.
      </p>
    </div>

    <a
      data-astro-reload
      href="/eventos?tipo=xauen"
      class="shrink-0 font-semibold underline decoration-accent decoration-2 underline-offset-4 hover:text-accent"
    >
      Ver todas las charlas →
    </a>
  </div>

  <PivosContainer server:defer />
</section>
