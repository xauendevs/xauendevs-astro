---
import ArrowRight from "@/components/icons/ArrowRight.astro";
import PivosContainer from "@/components/PivosContainer.astro";

import SectionTitle from "@/components/SectionTitle.astro";
---

<section id="pivos" class="bg-black/5 rounded-3xl p-7 lg:p-10 overflow-hidden">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <SectionTitle title="Pivo&Code" />
    <a data-astro-reload href="/eventos?tipo=xauen" class="font-semibold underline decoration-accent decoration-2 underline-offset-4">Ver todas las charlas →</a>
  </div>
  <div class="flex justify-between w-full">
    <div class="flex">
      <p class="lg:max-w-[40%] text-sm lg:text-base">
        Sumérgete en la tecnología con nuestras charlas PivoAndCode. Explora
        temas de vanguardia mientras haces conexiones significativas. Únete a
        nosotros para aprender y ampliar tu red. ¡Te esperamos en nuestras
        próximas charlas!
      </p>
    </div>
    <div class="hidden md:flex gap-2">
      <button type="button" id="left-scroll" aria-label="Charla anterior" disabled class="rounded-full focus-visible:outline-3 focus-visible:outline-offset-3 disabled:cursor-default">
        <ArrowRight aria-hidden="true" class="size-10 text-accent rotate-180 transition-all duration-400" />
      </button>
      <button type="button" id="right-scroll" aria-label="Charla siguiente" class="rounded-full focus-visible:outline-3 focus-visible:outline-offset-3 disabled:cursor-default">
        <ArrowRight aria-hidden="true" class="size-10 text-accent transition-all duration-400" />
      </button>
    </div>
    <div>
      <span></span>
    </div>
  </div>
  <PivosContainer server:defer />
</section>
