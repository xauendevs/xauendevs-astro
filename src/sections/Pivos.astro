---
import PivosContainer from "@/components/PivosContainer.astro";
---

<section id="pivos" aria-labelledby="pivos-title">
  <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div class="max-w-2xl">
      <p class="mb-2 text-sm hw:text-[11px] hw:leading-normal font-bold uppercase tracking-[0.2em] hw:tracking-[0.28em] text-accent hw:text-pumpkin">
        Comunidad · Tecnología · Jaén
      </p>
      <h2 id="pivos-title" class="text-4xl hw:text-3xl hw:sm:text-4xl font-black tracking-tight hw:text-white md:text-5xl hw:md:text-5xl">
        Pivo&Code
      </h2>
      <p class="mt-3 text-base text-black/65 hw:text-white/70 md:text-lg">
        Charlas para aprender, compartir lo que sabes y conocer a la gente que
        hace tecnología en nuestra provincia.
      </p>
    </div>

    <a
      data-astro-reload
      href="/eventos?tipo=xauen"
      class="shrink-0 font-semibold underline hw:text-white decoration-accent hw:decoration-pumpkin decoration-2 underline-offset-4 hover:text-accent hw:hover:text-pumpkin"
    >
      Ver todas las charlas →
    </a>
  </div>

  <PivosContainer server:defer />
</section>
