---
import PivosContainer from "@/components/PivosContainer.astro";
---

<section id="pivos" aria-labelledby="pivos-title">
  <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div class="max-w-2xl">
      <p class="mb-2 text-sm fest:text-[11px] fest:leading-normal font-bold uppercase tracking-[0.2em] fest:tracking-[0.28em] text-accent fest:text-season">
        Comunidad · Tecnología · Jaén
      </p>
      <h2 id="pivos-title" class="text-4xl fest:text-3xl fest:sm:text-4xl font-black tracking-tight fest:text-white md:text-5xl fest:md:text-5xl">
        Pivo&Code
      </h2>
      <p class="mt-3 text-base text-black/65 fest:text-white/70 md:text-lg">
        Charlas para aprender, compartir lo que sabes y conocer a la gente que
        hace tecnología en nuestra provincia.
      </p>
    </div>

    <a
      data-astro-reload
      href="/eventos?tipo=xauen"
      class="shrink-0 font-semibold underline fest:text-white decoration-accent fest:decoration-season decoration-2 underline-offset-4 hover:text-accent fest:hover:text-season"
    >
      Ver todas las charlas →
    </a>
  </div>

  <PivosContainer server:defer />
</section>
