---
import PartnerItem from "@/components/PartnerItem.astro";
import { getPartners } from "@/lib/get-partner";

const partners = await getPartners();
---

<section
  class="flex w-full flex-col justify-between gap-8 py-4 lg:flex-row lg:items-center lg:gap-10"
  aria-labelledby="partners-title"
>
  <div class="lg:max-w-[620px]">
    <h2 id="partners-title" class="text-3xl font-black tracking-tight">Partners</h2>
    <p class="mt-3 text-base text-black/80 fest:text-white/80 md:text-lg">
      Gracias a estas organizaciones podemos seguir organizando charlas y compartiendo conocimiento con la comunidad
      de desarrollo de Jaén.
    </p>
  </div>
  <div class="grid h-20 grid-cols-2 items-center gap-8 lg:max-w-[520px] lg:gap-10">
    {partners?.map(({ name, logo, url }) => <PartnerItem name={name} logo={logo} url={url} />)}
  </div>
</section>
