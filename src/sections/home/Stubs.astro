---
import { slugify } from "@/lib/event-slug";
import { formatDay, formatHour, shortPlace, yearOf, type Edition } from "@/lib/pivo-edition";

interface Props {
  past: Edition[];
}

const { past } = Astro.props;
// Las seis últimas, de la más reciente a la más antigua, como resguardos que asoman por abajo.
const stubs = [...past].reverse().slice(0, 6);
const heights = [40, 30, 44, 34, 26, 38];
const tilts = [0, -1.5, 0, 1.2, 0, -1];
---

<section class="stubs" aria-labelledby="stubs-title">
  <img
    class="stubs-photo"
    data-drift
    src="/img/home/pivo-charla.webp"
    alt=""
    width="2000"
    height="1334"
    loading="lazy"
    decoding="async"
  />

  <div class="stubs-copy">
    <h2 id="stubs-title" class="poster stubs-title" data-reveal>Lo último</h2>
    <p data-reveal style="--i:1">
      Lo último que hemos contado. Cada Pivo&amp;Code deja su resguardo: una charla, preguntas y alguien nuevo en el Discord.
    </p>
  </div>

  <ol class="stub-row" aria-label="Últimas Pivo&Code">
    {
      stubs.map((e, i) => (
        <li
          class="slip"
          style={`--h:${heights[i]}svh;--r:${tilts[i]}deg;--i:${i}`}
          data-reveal
        >
          <a href={`/eventos/${slugify(e.title)}`} class="slip-link">
            <span class="poster slip-head">Pivo&amp;Code {e.roman}</span>
            <span class="slip-dots" aria-hidden="true">· · · · · · · · · · · · · · ·</span>
            <span class="slip-title">{e.shortTitle}</span>
            {e.speakers && e.speakers.length > 0 && (
              <span>Con {e.speakers.map((s) => s.name).join(" y ")}</span>
            )}
            <span>
              <time datetime={e.date.toISOString()}>
                {formatDay(e.date)} {yearOf(e.date)}
              </time>
              , {formatHour(e.date)}
            </span>
            <span>{shortPlace(e.place)}</span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .stubs {
    position: relative;
    overflow: hidden;
    min-height: 96svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: var(--on-ground);
    isolation: isolate;
  }
  .stubs-photo {
    position: absolute;
    inset: -6% 0 0;
    width: 100%;
    height: 112%;
    object-fit: cover;
    z-index: -2;
    will-change: transform;
  }

  .stubs-copy {
    position: relative;
    margin: clamp(72px, 10vh, 120px) 0 48px 18%;
    width: min(760px, 74%);
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 32px 36px;
    background: rgb(8 8 11 / 0.78);
  }
  .stubs-title {
    font-size: var(--step-head);
    color: var(--paper);
  }
  .stubs-copy p {
    font-size: var(--step-lead);
    line-height: 1.3;
    font-weight: 500;
  }

  .stub-row {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--gap);
    padding: 0 var(--m);
    align-items: end;
    margin-bottom: -2px;
  }
  .slip {
    min-height: max(var(--h), 260px);
    background: var(--sheet);
    color: var(--sheet-ink);
    transform-origin: 50% 100%;
    rotate: var(--r);
    translate: 0 20px;
    transition: translate 0.35s var(--ease-out);
  }
  .slip:hover,
  .slip:focus-within {
    translate: 0 0;
  }
  .slip-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 20px 18px 56px;
    font-size: var(--step-small);
    line-height: 1.4;
    overflow: hidden;
  }
  .slip-head {
    font-size: 1.5rem;
  }
  .slip-dots {
    color: var(--sheet-soft);
    white-space: nowrap;
    overflow: hidden;
  }
  .slip-title {
    font-weight: 750;
    font-size: var(--step-body);
    line-height: 1.25;
    margin-bottom: 6px;
  }

  @media (max-width: 900px) {
    .stubs {
      min-height: 100svh;
    }
    .stubs-copy {
      margin: 64px var(--m) 32px;
      width: auto;
      padding: 24px;
    }
    .stubs-copy p {
      font-size: 1.25rem;
    }
    .stub-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-top: 24px;
    }
    .slip {
      height: auto;
      min-height: 0;
      translate: 0 0;
    }
    .slip:nth-child(n + 5) {
      display: none;
    }
    .slip-link {
      padding: 16px 14px 28px;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .slip {
      transition: none;
    }
  }
</style>
