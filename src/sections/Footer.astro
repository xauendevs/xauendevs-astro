---
import PreFooter from "@/components/PreFooter.astro";

interface Props {
  theme?: "default" | "halloween";
}

const { theme = "default" } = Astro.props;
const isHalloween = theme === "halloween";
---

<footer class="flex flex-col items-center p-8 md:p-10 gap-5">
  <PreFooter />
  <div class="flex group">
    <span
      class:list={["grayscale group-hover:grayscale-0 transition-all duration-500", isHalloween ? "text-pumpkin" : "text-accent"]}
      >:X\D &gt;_ &nbsp;
    </span>
    <span
      class:list={[
        "font-extralight grayscale group-hover:grayscale-0 transition-all duration-500",
        isHalloween ? "text-white/80" : "text-black/80",
      ]}
      >hecho con 💚 en Jaén</span
    >
  </div>
</footer>
