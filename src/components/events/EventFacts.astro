---
interface Props {
  date: string;
  time: string;
  duration?: string;
  place?: string;
  organizer: string;
  mapsUrl?: string;
}

const { date, time, duration, place, organizer, mapsUrl } = Astro.props;
---

<section aria-labelledby="event-facts-title">
  <h2 id="event-facts-title" class="text-accent-text text-xs font-bold uppercase tracking-[0.16em]">
    Datos del evento
  </h2>

  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    <div class="rounded-2xl border border-primary/10 bg-primary/[0.025] p-5">
      <span class="text-xs font-semibold uppercase tracking-wide text-primary/45">Cuándo</span>
      <p class="mt-2 text-lg font-bold capitalize">{date}</p>
      <p class="mt-1 text-sm text-primary/55">A las {time}</p>
      {duration && <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-primary/45">{duration}</p>}
    </div>

    <div class="rounded-2xl border border-primary/10 bg-primary/[0.025] p-5">
      <span class="text-xs font-semibold uppercase tracking-wide text-primary/45">Dónde</span>
      <p class="mt-2 text-lg font-bold">{place || "Por confirmar"}</p>
      {
        place && mapsUrl && (
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-flex items-center gap-1 text-sm font-bold text-primary/65 underline decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-primary"
          >
            Cómo llegar <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </div>

    <div class="rounded-2xl border border-primary/10 bg-primary/[0.025] p-5 sm:col-span-2">
      <span class="text-xs font-semibold uppercase tracking-wide text-primary/45">Organiza</span>
      <p class="mt-2 text-lg font-bold">{organizer}</p>
    </div>
  </div>
</section>
