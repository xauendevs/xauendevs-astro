---
import Rsvp from "@/components/events/Rsvp.astro";

interface Props {
  isExternal: boolean;
  externalUrl?: string;
  saraosLink?: string;
  eventId: string;
  isPast: boolean;
  googleCalendarUrl: string;
  icsUrl: string;
  icsFilename: string;
  eventPlace?: string;
  mapsEmbedUrl: string;
  mapsUrl: string;
  shareMessage: string;
  eventTitle: string;
  eventDate: string;
  eventTime: string;
  eventUrl: string;
  calendarUrl: string;
  eventStart: string;
  eventEnd: string;
  videoId?: string;
}

const {
  isExternal,
  externalUrl,
  saraosLink,
  eventId,
  isPast,
  googleCalendarUrl,
  icsUrl,
  icsFilename,
  eventPlace,
  mapsEmbedUrl,
  mapsUrl,
  shareMessage,
  videoId,
} = Astro.props;
---

<aside class="flex h-fit flex-col gap-4 rounded-[2rem] bg-accent p-6">
  <span class="text-xs font-bold uppercase tracking-[0.16em]">
    {isExternal ? "Evento externo" : "XauenDevs"}
  </span>

  <h2 class="text-2xl font-black leading-tight">
    {isExternal
      ? "Consulta todos los detalles del evento."
      : isPast
        ? "Esta charla ya se ha celebrado."
        : "Descubre esta charla."}
  </h2>

  <p class="text-sm leading-relaxed text-black/65">
    {isExternal
      ? "Fecha, ubicación, programa e información actualizada directamente en la web oficial del evento."
      : isPast
        ? "Consulta los materiales y recursos disponibles. Las acciones de asistencia ya están cerradas."
        : "Consulta los detalles de la charla y, si quieres asistir, añade el evento directamente a tu calendario."}
  </p>

  {
    isExternal ? (
      <a
        href={externalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex w-fit rounded-full !bg-black px-5 py-3 font-bold !text-white transition-transform hover:-translate-y-0.5 hover:!bg-black"
      >
        Web del evento ↗
      </a>
    ) : saraosLink ? (
      <a
        href={saraosLink}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex w-fit rounded-full !bg-black px-5 py-3 font-bold !text-white transition-transform hover:-translate-y-0.5 hover:!bg-black"
      >
        Más información ↗
      </a>
    ) : null
  }

  {!isExternal && !isPast && <Rsvp eventId={eventId} />}

  {!isExternal && isPast && videoId && (
    <a
      href="#video"
      class="mt-2 inline-flex w-fit rounded-full !bg-black px-5 py-3 font-bold !text-white transition-transform hover:-translate-y-0.5 hover:!bg-black"
    >
      Ver grabación ↓
    </a>
  )}

  {(!isPast || isExternal) && (
    <div class="mt-2 border-t border-black/10 pt-4">
      <span class="text-xs font-bold uppercase tracking-[0.14em]">
        Añadir al calendario
      </span>
      <div class="mt-3 flex flex-wrap gap-2">
        <a href={googleCalendarUrl} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full bg-black px-4 py-2 text-xs font-bold text-white transition-transform hover:-translate-y-0.5">
          Google Calendar
        </a>
        <a href={icsUrl} download={icsFilename} class="inline-flex rounded-full border border-black/20 px-4 py-2 text-xs font-bold transition-colors hover:bg-black/10">
          Descargar .ics
        </a>
      </div>
    </div>
  )}

  {!isExternal && isPast && (
    <div class="rounded-2xl border border-black/10 bg-white/30 p-4">
      <p class="text-sm font-bold">Evento celebrado</p>
      <p class="mt-1 text-sm leading-relaxed text-black/60">
        Ya no admite nuevas inscripciones ni acciones de asistencia.
      </p>
    </div>
  )}

  {eventPlace && (
    <div class="mt-2 overflow-hidden rounded-2xl border border-black/10 bg-white/30">
      <div class="h-64 w-full md:h-72">
        <iframe
          src={mapsEmbedUrl}
          title={`Mapa de ${eventPlace}`}
          class="size-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between px-4 py-3 text-sm font-bold text-primary transition-colors hover:bg-white/30">
        <span>Cómo llegar</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  )}

  <div class="mt-2 border-t border-black/10 pt-5">
    <span class="text-xs font-bold uppercase tracking-[0.14em]">
      Compartir evento
    </span>
    <p class="mt-2 text-sm leading-relaxed text-black/60">
      WhatsApp lleva el texto listo. En LinkedIn copiamos el mensaje y abrimos el editor para que solo tengas que pegarlo.
    </p>
    <div class="mt-3 flex flex-wrap gap-2">
      <a href={`https://api.whatsapp.com/send/?text=${encodeURIComponent(shareMessage)}`} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full bg-black px-4 py-2 text-xs font-bold text-white transition-transform hover:-translate-y-0.5">
        WhatsApp
      </a>
      <button type="button" data-linkedin-share={shareMessage} class="inline-flex rounded-full bg-black px-4 py-2 text-xs font-bold text-white transition-transform hover:-translate-y-0.5">
        LinkedIn
      </button>
      <button type="button" data-copy-share-message={shareMessage} class="inline-flex rounded-full border border-black/20 px-4 py-2 text-xs font-bold transition-colors hover:bg-black/10">
        Copiar mensaje
      </button>
    </div>
  </div>
</aside>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-share-message]").forEach((button) => {
    button.addEventListener("click", async () => {
      const message = button.dataset.copyShareMessage;
      if (!message) return;
      try {
        await navigator.clipboard.writeText(message);
        const originalText = button.textContent;
        button.textContent = "Mensaje copiado ✓";
        window.setTimeout(() => { button.textContent = originalText; }, 2000);
      } catch {
        button.textContent = "No se pudo copiar";
        window.setTimeout(() => { button.textContent = "Copiar mensaje"; }, 2000);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-linkedin-share]").forEach((button) => {
    button.addEventListener("click", async () => {
      const message = button.dataset.linkedinShare;
      if (!message) return;
      window.open(
        "https://www.linkedin.com/sharing/share-offsite/?url=" + encodeURIComponent(window.location.href),
        "_blank",
        "noopener,noreferrer",
      );
      try {
        await navigator.clipboard.writeText(message);
        const originalText = button.textContent;
        button.textContent = "Texto copiado ✓";
        window.setTimeout(() => { button.textContent = originalText; }, 2000);
      } catch {
        button.textContent = "No se pudo copiar";
        window.setTimeout(() => { button.textContent = "LinkedIn"; }, 2000);
      }
    });
  });
</script>
