---
import Rsvp from "@/components/events/Rsvp.astro";

interface Props {
  isExternal: boolean;
  externalUrl?: string;
  saraosLink?: string;
  eventId: string;
  isPast: boolean;
  googleCalendarUrl: string;
  icsUrl: string;
  icsFilename: string;
  eventPlace?: string;
  mapsEmbedUrl: string;
  mapsUrl: string;
  shareMessage: string;
  eventTitle: string;
  eventDate: string;
  eventTime: string;
  eventUrl: string;
  calendarUrl: string;
  eventStart: string;
  eventEnd: string;
  videoId?: string;
  class?: string;
}

const {
  isExternal,
  externalUrl,
  saraosLink,
  eventId,
  isPast,
  googleCalendarUrl,
  icsUrl,
  icsFilename,
  eventPlace,
  mapsEmbedUrl,
  mapsUrl,
  shareMessage,
  videoId,
  class: className,
} = Astro.props;
---

<aside class:list={["flex h-fit min-w-0 flex-col gap-4 rounded-3xl bg-accent p-4 text-black fest:text-season-ink sm:rounded-[2rem] sm:p-6", className]}>
  {
    (isExternal || isPast) && (
      <div>
        <h2 class="break-words text-2xl font-black leading-tight">
          {isExternal ? "Información y entradas" : "Esta charla ya se celebró"}
        </h2>
        <p class="mt-2 text-base leading-relaxed text-black/80">
          {isExternal
            ? "Programa, fechas e inscripción, al día, en la web oficial del evento."
            : videoId
              ? "Ya no admite inscripciones, pero puedes ver la grabación."
              : "Ya no admite inscripciones."}
        </p>
      </div>
    )
  }

  {
    isExternal ? (
      <a
        href={externalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex w-full items-center justify-center rounded-full sm:w-fit !bg-black px-5 py-3 font-bold !text-white transition-transform hover:-translate-y-0.5 hover:!bg-black"
      >
        Web del evento ↗
      </a>
    ) : saraosLink ? (
      <a
        href={saraosLink}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex w-full items-center justify-center rounded-full !bg-black px-5 py-3 text-center font-bold !text-white transition-transform hover:-translate-y-0.5 hover:!bg-black sm:w-fit"
      >
        Más información ↗
      </a>
    ) : null
  }

  {!isExternal && !isPast && <Rsvp eventId={eventId} />}

  {!isExternal && isPast && videoId && (
    <a
      href="#video"
      class="inline-flex min-h-12 w-fit items-center rounded-full !bg-black px-5 py-3 font-bold !text-white transition-transform hover:-translate-y-0.5 hover:!bg-black"
    >
      Ver grabación ↓
    </a>
  )}

  {(!isPast || isExternal) && (
    <div class="mt-2 border-t border-black/10 pt-4">
      <h3 class="text-base font-bold">Añadir al calendario</h3>
      <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:flex-wrap">
        <a href={googleCalendarUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-w-0 items-center justify-center rounded-full bg-black min-h-11 px-4 py-2 text-center text-sm font-bold text-white transition-transform hover:-translate-y-0.5">
          Google Calendar
        </a>
        <a href={icsUrl} download={icsFilename} class="inline-flex min-w-0 items-center justify-center rounded-full border border-black/20 min-h-11 px-4 py-2 text-center text-sm font-bold transition-colors hover:bg-black/10">
          Descargar .ics
        </a>
      </div>
    </div>
  )}


  {eventPlace && (
    <div class="mt-2 overflow-hidden rounded-2xl border border-black/10 bg-white/30">
      <div class="h-56 w-full sm:h-64 md:h-72">
        <iframe
          src={mapsEmbedUrl}
          title={`Mapa de ${eventPlace}`}
          class="size-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between px-4 py-3 text-sm font-bold text-primary fest:text-season-ink transition-colors hover:bg-white/30">
        <span>Cómo llegar</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  )}

  <div class="mt-2 min-w-0 border-t border-black/10 pt-5">
    <h3 class="text-base font-bold">Compartir</h3>
    <p class="mt-1 text-sm leading-relaxed text-black/75">
      En LinkedIn copiamos el mensaje y abrimos el editor: solo tienes que pegarlo.
    </p>
    <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:flex-wrap">
      <a href={`https://api.whatsapp.com/send/?text=${encodeURIComponent(shareMessage)}`} target="_blank" rel="noopener noreferrer" class="inline-flex min-w-0 items-center justify-center rounded-full bg-black min-h-11 px-4 py-2 text-center text-sm font-bold text-white transition-transform hover:-translate-y-0.5">
        WhatsApp
      </a>
      <button type="button" data-linkedin-share={shareMessage} class="inline-flex min-h-11 items-center justify-center rounded-full bg-black px-4 py-2 text-sm font-bold text-white transition-transform hover:-translate-y-0.5">
        LinkedIn
      </button>
      <button type="button" data-copy-share-message={shareMessage} class="inline-flex min-w-0 items-center justify-center rounded-full border border-black/20 min-h-11 px-4 py-2 text-center text-sm font-bold transition-colors hover:bg-black/10">
        Copiar mensaje
      </button>
    </div>
  </div>
</aside>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-share-message]").forEach((button) => {
    button.addEventListener("click", async () => {
      const message = button.dataset.copyShareMessage;
      if (!message) return;
      try {
        await navigator.clipboard.writeText(message);
        const originalText = button.textContent;
        button.textContent = "Mensaje copiado ✓";
        window.setTimeout(() => { button.textContent = originalText; }, 2000);
      } catch {
        button.textContent = "No se pudo copiar";
        window.setTimeout(() => { button.textContent = "Copiar mensaje"; }, 2000);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-linkedin-share]").forEach((button) => {
    button.addEventListener("click", async () => {
      const message = button.dataset.linkedinShare;
      if (!message) return;
      window.open(
        "https://www.linkedin.com/sharing/share-offsite/?url=" + encodeURIComponent(window.location.href),
        "_blank",
        "noopener,noreferrer",
      );
      try {
        await navigator.clipboard.writeText(message);
        const originalText = button.textContent;
        button.textContent = "Texto copiado ✓";
        window.setTimeout(() => { button.textContent = originalText; }, 2000);
      } catch {
        button.textContent = "No se pudo copiar";
        window.setTimeout(() => { button.textContent = "LinkedIn"; }, 2000);
      }
    });
  });
</script>
