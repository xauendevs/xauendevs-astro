---
interface Props { eventId: string; }
const { eventId } = Astro.props;
---

<section
  class="mt-2 rounded-2xl bg-black/5 p-5"
  data-rsvp
  data-event-id={eventId}
  data-event-title={eventTitle}
  data-event-date={eventDate}
  data-event-time={eventTime}
  data-event-place={eventPlace}
  data-event-url={eventUrl}
  data-calendar-url={calendarUrl}
  data-event-start={eventStart}
  data-event-end={eventEnd}
>
  <span class="text-xs font-bold uppercase tracking-[0.14em]">Asistencia</span>
  <h3 class="mt-2 text-xl font-black">¿Te apuntas?</h3>
  <p class="mt-1 text-sm leading-relaxed text-black/60">
    Reserva tu plaza para esta Pivo&Code.
  </p>
  <p class="mt-3 text-sm font-semibold" data-rsvp-count>Comprobando plazas…</p>
  <form class="mt-4 flex flex-col gap-3" data-rsvp-form>
    <label class="flex flex-col gap-1.5"
      ><span class="text-xs font-bold uppercase tracking-wide text-black/60"
        >Nombre</span
      ><input
        required
        name="name"
        autocomplete="name"
        maxlength="100"
        placeholder="Tu nombre"
        class="rounded-xl border border-black/10 bg-white/60 px-3 py-2.5 text-sm outline-none transition focus:border-black/30 focus:ring-2 focus:ring-black/10"
      /></label
    >
    <label class="flex flex-col gap-1.5"
      ><span class="text-xs font-bold uppercase tracking-wide text-black/60"
        >Email</span
      ><input
        required
        name="email"
        type="email"
        autocomplete="email"
        maxlength="254"
        placeholder="tu@email.com"
        class="rounded-xl border border-black/10 bg-white/60 px-3 py-2.5 text-sm outline-none transition focus:border-black/30 focus:ring-2 focus:ring-black/10"
      /></label
    >
    <label class="flex items-start gap-2 text-xs leading-relaxed text-black/60"
      ><input
        required
        name="consent"
        type="checkbox"
        class="mt-0.5 accent-black"
      /><span
        >Acepto la <a
          href="/privacidad"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold underline underline-offset-2"
          >política de privacidad</a
        > y que XauenDevs guarde estos datos para gestionar mi asistencia a este
        evento.</span
      ></label
    >
    <button
      type="submit"
      class="mt-1 rounded-full bg-black px-5 py-3 text-sm font-bold text-white transition-transform hover:-translate-y-0.5 disabled:cursor-wait disabled:opacity-60"
      >Quiero asistir →</button
    >
  </form>

  <div
    class="pointer-events-none fixed left-1/2 top-5 z-[9999] w-[min(calc(100vw-2rem),30rem)] -translate-x-1/2 translate-y-[-12px] rounded-2xl border-2 border-black bg-[#f4d400] px-5 py-4 text-center text-sm font-black text-black opacity-0 shadow-[6px_6px_0_#000] transition-all duration-300 sm:top-6"
    data-rsvp-toast
    role="status"
    aria-live="polite"
  >
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-rsvp]").forEach((rsvp) => {
    const eventId = rsvp.dataset.eventId;
    const eventTitle = rsvp.dataset.eventTitle ?? "";
    const eventDate = rsvp.dataset.eventDate ?? "";
    const eventTime = rsvp.dataset.eventTime ?? "";
    const eventPlace = rsvp.dataset.eventPlace ?? "";
    const eventUrl = rsvp.dataset.eventUrl ?? "";
    const calendarUrl = rsvp.dataset.calendarUrl ?? "";
    const eventStart = rsvp.dataset.eventStart ?? "";
    const eventEnd = rsvp.dataset.eventEnd ?? "";
    const form = rsvp.querySelector<HTMLFormElement>("[data-rsvp-form]");
    const count = rsvp.querySelector<HTMLElement>("[data-rsvp-count]");
    const toast = rsvp.querySelector<HTMLElement>("[data-rsvp-toast]");
    if (!eventId || !form || !count || !toast) return;

    let toastTimeout: ReturnType<typeof setTimeout> | undefined;

    document.body.appendChild(toast);

    const hideToast = () => {
      toast.style.opacity = "0";
      toast.style.transform = "translate(-50%, -12px)";
    };

    const showToast = (text: string, type: "success" | "error") => {
      if (toastTimeout) clearTimeout(toastTimeout);
      toast.textContent = text;
      toast.className =
        "pointer-events-none fixed left-1/2 top-5 z-[9999] w-[min(calc(100vw-2rem),30rem)] -translate-x-1/2 rounded-2xl border-2 px-5 py-4 text-center text-sm font-black shadow-[6px_6px_0_#000] transition-all duration-300 sm:top-6 " +
        (type === "success"
          ? "border-black bg-[#f4d400] text-black"
          : "border-white bg-red-700 text-white");

      toast.style.opacity = "0";
      toast.style.transform = "translate(-50%, -12px)";

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          toast.style.opacity = "1";
          toast.style.transform = "translate(-50%, 0)";
        });
      });

      toastTimeout = setTimeout(hideToast, 3500);
    };

    const loadCount = async () => {
      try {
        const response = await fetch(
          "/api/rsvp?eventId=" + encodeURIComponent(eventId),
        );
        if (!response.ok) throw new Error();
        const data = await response.json();
        count.textContent =
          data.count +
          " " +
          (data.count === 1 ? "persona apunta" : "personas apuntadas");
      } catch {
        count.textContent = "No se pudo consultar la asistencia.";
      }
    };
    void loadCount();

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submit = form.querySelector<HTMLButtonElement>(
        "button[type=submit]",
      );
      const formData = new FormData(form);
      submit?.setAttribute("disabled", "true");

      try {
        const response = await fetch("/api/rsvp", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            eventId,
            eventTitle,
            eventDate,
            eventTime,
            eventPlace,
            eventUrl,
            calendarUrl,
            eventStart,
            eventEnd,
            name: formData.get("name"),
            email: formData.get("email"),
            consent: formData.get("consent") === "on",
          }),
        });
        const data = await response.json();
        if (!response.ok)
          throw new Error(data.error || "No se pudo completar la inscripción.");

        form.reset();
        count.textContent =
          data.count +
          " " +
          (data.count === 1 ? "persona apunta" : "personas apuntadas");
        showToast(
          data.emailSent
            ? "¡Apuntado! Te hemos enviado la confirmación por email. ✓"
            : "¡Apuntado! Tu plaza está confirmada. ✓",
          "success",
        );
      } catch (error) {
        showToast(
          error instanceof Error
            ? error.message
            : "No se pudo completar la inscripción.",
          "error",
        );
      } finally {
        submit?.removeAttribute("disabled");
      }
    });
  });
</script>
