---
interface Props {
  eventId: string;
}
const { eventId } = Astro.props;
---

<section class="mt-2 rounded-2xl bg-black/5 p-5" data-rsvp data-event-id={eventId} aria-labelledby="rsvp-title">
  <span class="text-xs font-bold uppercase tracking-[0.14em]">Asistencia</span>
  <h3 id="rsvp-title" class="mt-2 text-xl font-black">¿Te apuntas?</h3>
  <p class="mt-1 text-sm leading-relaxed text-black/60">Reserva tu asistencia a esta Pivo&Code.</p>
  <p class="mt-3 text-sm font-semibold" data-rsvp-count aria-live="polite">Comprobando asistencia…</p>

  <form class="mt-4 flex flex-col gap-3" data-rsvp-form novalidate>
    <div class="flex flex-col gap-1.5">
      <label for={`rsvp-name-${eventId}`} class="text-xs font-bold uppercase tracking-wide text-black/60">Nombre</label>
      <input
        id={`rsvp-name-${eventId}`}
        required
        name="name"
        autocomplete="name"
        maxlength="100"
        placeholder="Tu nombre"
        aria-describedby={`rsvp-name-error-${eventId}`}
        class="rounded-xl border border-black/10 bg-white/60 px-3 py-2.5 text-sm outline-none transition focus:border-black/30 focus:ring-2 focus:ring-black/10"
      />
      <p id={`rsvp-name-error-${eventId}`} class="hidden text-xs font-semibold text-red-700" data-rsvp-error="name"></p>
    </div>

    <div class="flex flex-col gap-1.5">
      <label for={`rsvp-email-${eventId}`} class="text-xs font-bold uppercase tracking-wide text-black/60">Email</label>
      <input
        id={`rsvp-email-${eventId}`}
        required
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        maxlength="254"
        placeholder="tu@email.com"
        aria-describedby={`rsvp-email-error-${eventId}`}
        class="rounded-xl border border-black/10 bg-white/60 px-3 py-2.5 text-sm outline-none transition focus:border-black/30 focus:ring-2 focus:ring-black/10"
      />
      <p id={`rsvp-email-error-${eventId}`} class="hidden text-xs font-semibold text-red-700" data-rsvp-error="email"></p>
    </div>

    <div class="flex flex-col gap-1.5">
      <label class="flex items-start gap-2 text-xs leading-relaxed text-black/60">
        <input
          required
          name="consent"
          type="checkbox"
          aria-describedby={`rsvp-consent-error-${eventId}`}
          class="mt-0.5 accent-black"
        />
        <span>Acepto la <a href="/privacidad" target="_blank" rel="noopener noreferrer" class="font-bold underline underline-offset-2">política de privacidad</a> y que XauenDevs guarde estos datos para gestionar mi asistencia a este evento.</span>
      </label>
      <p id={`rsvp-consent-error-${eventId}`} class="hidden text-xs font-semibold text-red-700" data-rsvp-error="consent"></p>
    </div>

    <button
      type="submit"
      class="mt-1 rounded-full bg-black px-5 py-3 text-sm font-bold text-white transition-transform hover:-translate-y-0.5 disabled:cursor-wait disabled:opacity-60"
    >
      Quiero asistir →
    </button>
  </form>

  <div
    class="mt-4 hidden rounded-2xl border border-black/10 bg-white/40 p-4"
    data-rsvp-result
    role="status"
    tabindex="-1"
    aria-live="polite"
  ></div>

  <div class="pointer-events-none fixed left-1/2 top-5 z-[9999] w-[min(calc(100vw-2rem),30rem)] -translate-x-1/2 translate-y-[-12px] rounded-2xl border-2 border-black bg-[#f4d400] px-5 py-4 text-center text-sm font-black text-black opacity-0 shadow-[6px_6px_0_#000] transition-all duration-300 sm:top-6" data-rsvp-toast aria-live="polite"></div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-rsvp]").forEach((rsvp) => {
    const eventId = rsvp.dataset.eventId;
    const form = rsvp.querySelector<HTMLFormElement>("[data-rsvp-form]");
    const count = rsvp.querySelector<HTMLElement>("[data-rsvp-count]");
    const result = rsvp.querySelector<HTMLElement>("[data-rsvp-result]");
    const toast = rsvp.querySelector<HTMLElement>("[data-rsvp-toast]");
    if (!eventId || !form || !count || !result || !toast) return;

    const showToast = (text: string) => {
      toast.textContent = text;
      toast.style.opacity = "1";
      toast.style.transform = "translate(-50%, 0)";
      window.setTimeout(() => {
        toast.style.opacity = "0";
        toast.style.transform = "translate(-50%, -12px)";
      }, 3500);
    };

    const setFieldError = (field: "name" | "email" | "consent", message = "") => {
      const input = form.elements.namedItem(field) as HTMLInputElement | null;
      const error = form.querySelector<HTMLElement>(`[data-rsvp-error="${field}"]`);
      if (!input || !error) return;

      const hasError = Boolean(message);
      input.setAttribute("aria-invalid", String(hasError));
      error.textContent = message;
      error.classList.toggle("hidden", !hasError);
      input.classList.toggle("border-red-600", hasError);
      input.classList.toggle("border-black/10", !hasError);
    };

    const validate = () => {
      const name = form.elements.namedItem("name") as HTMLInputElement | null;
      const email = form.elements.namedItem("email") as HTMLInputElement | null;
      const consent = form.elements.namedItem("consent") as HTMLInputElement | null;
      if (!name || !email || !consent) return false;

      setFieldError("name", name.value.trim() ? "" : "Escribe tu nombre.");
      setFieldError("email", email.validity.valid && email.value.trim() ? "" : "Introduce un email válido.");
      setFieldError("consent", consent.checked ? "" : "Acepta el tratamiento para gestionar la asistencia.");

      const firstError = [name, email, consent].find((input) => input.getAttribute("aria-invalid") === "true");
      firstError?.focus();
      return !firstError;
    };

    const loadCount = async () => {
      try {
        const response = await fetch("/api/rsvp?eventId=" + encodeURIComponent(eventId));
        if (!response.ok) throw new Error();
        const data = await response.json();
        count.textContent = data.count + " " + (data.count === 1 ? "persona confirmada" : "personas confirmadas");
      } catch {
        count.textContent = "No se pudo consultar la asistencia.";
      }
    };
    void loadCount();

    form.querySelectorAll<HTMLInputElement>("input").forEach((input) => {
      input.addEventListener("input", () => setFieldError(input.name as "name" | "email" | "consent"));
      input.addEventListener("change", () => setFieldError(input.name as "name" | "email" | "consent"));
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!validate()) return;

      const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
      const formData = new FormData(form);
      submit?.setAttribute("disabled", "true");
      form.setAttribute("aria-busy", "true");
      if (submit) submit.textContent = "Reservando tu asistencia…";

      try {
        const response = await fetch("/api/rsvp", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            eventId,
            name: formData.get("name"),
            email: formData.get("email"),
            consent: formData.get("consent") === "on",
          }),
        });

        const data = await response.json();

        if (!response.ok) {
          if (response.status === 409) {
            result.innerHTML = "<strong>Ya tienes una inscripción para esta charla.</strong><p class='mt-1 text-sm text-black/60'>Revisa tu correo para encontrar el enlace de gestión de tu inscripción.</p>";
            result.classList.remove("hidden");
            result.focus();
            return;
          }
          throw new Error(data.error || "No se pudo completar la inscripción.");
        }

        form.classList.add("hidden");
        result.innerHTML = data.emailSent
          ? "<strong>Solicitud recibida ✓</strong><p class='mt-1 text-sm text-black/60'>Te hemos enviado un email. Abre el enlace del correo para confirmar tu asistencia.</p>"
          : "<strong>Solicitud recibida ✓</strong><p class='mt-1 text-sm text-black/60'>Tu inscripción está pendiente de confirmación. Revisa tu correo para continuar.</p>";
        result.classList.remove("hidden");
        result.focus();
        void loadCount();
      } catch (error) {
        showToast(error instanceof Error ? error.message : "No se pudo completar la inscripción.");
      } finally {
        form.removeAttribute("aria-busy");
        submit?.removeAttribute("disabled");
        if (submit) submit.textContent = "Quiero asistir →";
      }
    });
  });
</script>
