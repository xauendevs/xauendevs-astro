---
import { DISCORD_URL, SOCIAL_LINKS } from "@/consts/social-links";
import Cobweb from "./halloween/Cobweb.astro";
import Spider from "./halloween/Spider.astro";
import Pumpkin from "./halloween/Pumpkin.astro";
import Discord from "./icons/Discord.astro";
import Github from "./icons/Github.astro";
import Instagram from "./icons/Instagram.astro";
import Linkedin from "./icons/Linkedin.astro";
import X from "./icons/X.astro";
import Youtube from "./icons/Youtube.astro";
import HamburgerButton from "./HamburgerButton.astro";
import Logo from "./Logo.astro";
import NextEvent from "./NextEvent.astro";

interface Props {
  variant?: "default" | "halloween";
}

const { variant = "default" } = Astro.props;
const isHalloween = variant === "halloween";

const socialIcons = {
  Discord,
  X,
  GitHub: Github,
  YouTube: Youtube,
  Instagram,
  LinkedIn: Linkedin,
} as const;
const socials = SOCIAL_LINKS.filter((link) => link.href);
---

<header
  class:list={[
    "relative z-20 h-auto max-w-[100vw]",
    isHalloween
      ? "border-b border-white/10 bg-night/90 px-4 py-4 text-white sm:px-6 lg:px-10 lg:py-5"
      : "bg-white/85 p-4 sm:p-6 lg:p-10",
  ]}
>
  {
    isHalloween && (
      <>
        <Cobweb
          class="pointer-events-none absolute left-0 top-0 h-24 w-24 text-pumpkin/60 sm:h-32 sm:w-32 lg:h-40 lg:w-40"
        />
        <Cobweb
          class="pointer-events-none absolute right-0 top-0 h-24 w-24 -scale-x-100 text-pumpkin/60 sm:h-32 sm:w-32 lg:h-40 lg:w-40"
        />
        <Spider
          class="spider-swing pointer-events-none absolute right-3 top-0 hidden h-16 w-5 text-pumpkin lg:block"
        />
      </>
    )
  }

  <nav
    class:list={["hidden justify-between text-nowrap lg:flex", isHalloween && "relative mx-auto max-w-[1234px]"]}
    aria-label="Navegación principal"
  >
    <div class="flex items-center gap-10">
      <a href="/" aria-label="XauenDevs, inicio" class="flex shrink-0 items-center gap-2">
        <Logo
          width="230"
          class:list={[
            "transition-colors duration-300 motion-reduce:duration-0",
            isHalloween ? "text-white hover:text-pumpkin" : "text-primary hover:text-accent",
          ]}
        />
        {isHalloween && <Pumpkin class="pumpkin-flicker -mt-1 h-8 w-auto" />}
      </a>
      <div class:list={["flex items-center gap-5", isHalloween && "text-sm font-medium text-white/90"]}>
        <a class:list={[isHalloween && "transition-colors hover:text-pumpkin"]} href="/#own-mission">
          Nuestra misión
        </a>
        <a
          class:list={[isHalloween && "transition-colors hover:text-pumpkin"]}
          data-astro-reload
          href="/eventos?tipo=xauen"
        >
          Charlas
        </a>
        <a class:list={[isHalloween && "transition-colors hover:text-pumpkin"]} href="/eventos">Eventos</a>
      </div>
    </div>
    {
      isHalloween ? (
        <div class="flex items-center gap-6">
          <ul class="flex items-center gap-5 text-white/85">
            {socials.map(({ name, href }) => {
              const Icon = socialIcons[name as keyof typeof socialIcons];
              return (
                <li>
                  <a
                    href={href!}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`XauenDevs en ${name}`}
                    class="block transition-colors hover:text-pumpkin"
                  >
                    <Icon class="size-[18px]" />
                  </a>
                </li>
              );
            })}
          </ul>
          <a
            href={DISCORD_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-pumpkin px-5 py-2 text-sm font-bold text-black shadow-[0_0_24px_rgba(255,138,31,0.35)] transition hover:-translate-y-0.5 hover:bg-[#ffa042] motion-reduce:transition-none"
          >
            Únete <span aria-hidden="true">→</span>
          </a>
        </div>
      ) : (
        <div>
          <NextEvent />
        </div>
      )
    }
  </nav>

  <nav
    class:list={["flex items-center justify-between lg:hidden", isHalloween && "relative"]}
    aria-label="Navegación principal"
  >
    <a href="/" aria-label="XauenDevs, ir a inicio" class="flex shrink-0 items-center gap-2">
      <Logo
        width="190"
        class:list={[
          "transition-colors duration-300 motion-reduce:duration-0 sm:w-[230px]",
          isHalloween ? "text-white hover:text-pumpkin" : "text-primary hover:text-accent",
        ]}
      />
      {isHalloween && <Pumpkin class="pumpkin-flicker -mt-1 h-7 w-auto" />}
    </a>
    <HamburgerButton class:list="block lg:hidden" id="menuButton" />
    <div
      id="menuMobileContent"
      aria-hidden="true"
      class="fixed inset-0 z-[888] flex h-[100dvh] w-screen flex-col items-center overflow-y-auto overflow-x-hidden px-5 pb-10 lg:hidden"
    >
      <div class="absolute inset-0 bg-black/90" aria-hidden="true"></div>
      <div class="relative z-[888] flex w-full items-center justify-between py-6 text-white">
        <a href="/" aria-label="XauenDevs, ir a inicio" class="block shrink-0">
          <Logo
            width="190"
            class="text-accent transition-colors duration-300 hover:text-accent motion-reduce:duration-0 sm:w-[230px]"
          />
        </a>
        <HamburgerButton id="innerMenuButton" />
      </div>
      <div class="relative z-[888] mb-12 flex flex-col items-center gap-5 text-center text-2xl uppercase text-white">
        <a class="transition duration-300 hover:text-accent" href="/#own-mission">Nuestra misión</a>
        <a class="transition duration-300 hover:text-accent" data-astro-reload href="/eventos?tipo=xauen">Charlas</a>
        <a class="transition duration-300 hover:text-accent" href="/eventos">Eventos</a>
      </div>
      <hr class="relative z-[888] mb-12 h-px w-1/2 border-0 bg-white" />
      <div class="relative z-[888]">
        {
          isHalloween ? (
            <div class="flex flex-col items-center gap-8">
              <ul class="flex items-center gap-6 text-white">
                {socials.map(({ name, href }) => {
                  const Icon = socialIcons[name as keyof typeof socialIcons];
                  return (
                    <li>
                      <a
                        href={href!}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`XauenDevs en ${name}`}
                        class="block transition-colors hover:text-accent"
                      >
                        <Icon class="size-6" />
                      </a>
                    </li>
                  );
                })}
              </ul>
              <a
                href={DISCORD_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full bg-pumpkin px-6 py-3 font-bold text-black"
              >
                Únete <span aria-hidden="true">→</span>
              </a>
            </div>
          ) : (
            <NextEvent />
          )
        }
      </div>
    </div>
  </nav>
</header>

<style>
  #menuMobileContent {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    overscroll-behavior: contain;
  }

  #menuMobileContent.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    #menuMobileContent {
      transition: none;
    }
  }
</style>

<script>
  // Use document-level delegation: Astro's ClientRouter swaps page DOM without
  // re-running already-loaded scripts, so listeners attached to old buttons go stale.
  function setMenuOpen(isOpen: boolean) {
    const menu = document.getElementById("menuMobileContent");
    if (!menu) return;

    menu.classList.toggle("open", isOpen);
    menu.setAttribute("aria-hidden", String(!isOpen));
    document.body.style.overflow = isOpen ? "hidden" : "";

    document.querySelectorAll<HTMLElement>(".hamburgerButton").forEach((button) => {
      button.classList.toggle("open", isOpen);
      button.setAttribute("aria-expanded", String(isOpen));
      button.setAttribute(
        "aria-label",
        isOpen ? "Cerrar menú de navegación" : "Abrir menú de navegación"
      );
    });
  }

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLElement>(".hamburgerButton");
    if (button) {
      event.preventDefault();
      const menu = document.getElementById("menuMobileContent");
      setMenuOpen(!menu?.classList.contains("open"));
      return;
    }

    if (target.closest("#menuMobileContent a")) {
      setMenuOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenuOpen(false);
  });

  // Reset after every Astro client-side navigation, when the new DOM is in place.
  document.addEventListener("astro:page-load", () => setMenuOpen(false));
  document.addEventListener("astro:after-swap", () => setMenuOpen(false));
  setMenuOpen(false);
</script>
