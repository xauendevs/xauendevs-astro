---
import PivoCard from "@/components/PivoCard.astro";
import { getPivosStrapi } from "@/lib/get-info-pivos";
import { slugify } from "@/lib/event-slug";
import { formatDate, formatTime } from "@/lib/format-date";
import LocationPin from "@/components/icons/LocationPin.astro";

const { STRAPI_HOST } = import.meta.env;
const pivos = await getPivosStrapi();
const now = new Date();

const nextEvent = pivos?.find((pivo) => pivo.date.getTime() > now.getTime());
const nextSpeaker = nextEvent?.speakers?.[0];
const pastPivos = pivos?.filter((pivo) => pivo.date.getTime() < now.getTime()).slice(0, 3);
---

<div class="mt-6 min-w-0 space-y-8 sm:mt-8 sm:space-y-12">
  {
    nextEvent && (
      <article class="grid min-w-0 grid-cols-1 overflow-hidden rounded-3xl bg-black/5 fest:ring-1 fest:ring-season/40 fest:bg-white/5 md:grid-cols-[1.35fr_0.65fr]">
        <div class="relative min-h-[220px] min-w-0 overflow-hidden sm:min-h-[280px] md:min-h-[410px]">
          <div
            aria-hidden="true"
            class="absolute inset-0 bg-cover bg-center transition-transform duration-700 ease-out hover:scale-[1.02] motion-reduce:transition-none"
            style={"background-image:url('" + STRAPI_HOST + nextEvent.image + "'),url('/img/pivos/default.png')"}
          ></div>
          <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent"></div>
          <span class="absolute bottom-5 left-5 rounded-full bg-accent fest:bg-season px-3 py-1.5 text-xs font-black uppercase tracking-wide text-black fest:text-season-ink">
            Próxima Pivo&Code
          </span>
        </div>

        <div class="flex min-w-0 flex-col justify-between border-l-0 border-accent fest:border-season p-4 sm:p-6 md:border-l-4 md:p-8">
          <div>
            <p class="break-words text-xs font-black uppercase tracking-[0.12em] text-accent fest:text-season sm:tracking-[0.18em]">
              {formatDate(nextEvent.date)} · {formatTime(nextEvent.date)}
            </p>
            <h3 class="mt-3 break-words text-2xl font-black leading-tight sm:text-3xl">
              {nextEvent.title}
            </h3>

            {
              nextSpeaker && (
                <div class="mt-7 flex items-center gap-3">
                  <img
                    src={STRAPI_HOST + nextSpeaker.photo}
                    class="size-11 rounded-full object-cover"
                    alt={nextSpeaker.name}
                  />
                  <div>
                    <p class="text-xs uppercase tracking-wide text-black/45 fest:text-white/50">Con</p>
                    <p class="font-bold">{nextSpeaker.name}</p>
                  </div>
                </div>
              )
            }

            {
              nextEvent.place && (
                <div class="mt-5 flex min-w-0 items-start gap-2 text-sm text-black/60 fest:text-white/60">
                  <LocationPin class="size-4 shrink-0" />
                  <span class="min-w-0 break-words">{nextEvent.place}</span>
                </div>
              )
            }
          </div>

          <a
            href={"/eventos/" + slugify(nextEvent.title)}
            class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-full bg-black fest:bg-season px-5 py-3 text-center font-bold text-white fest:text-season-ink transition-transform hover:scale-[1.02] motion-reduce:transition-none sm:w-fit"
          >
            Ver la charla <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    )
  }

  {
    pastPivos && pastPivos.length > 0 && (
      <div>
        <div class="mb-5 flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-end sm:gap-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-black/40 fest:text-white/40">
              Archivo reciente
            </p>
            <h3 class="mt-1 text-xl font-bold sm:text-2xl md:text-3xl">
              Lo último que hemos compartido
            </h3>
          </div>
          <a
            data-astro-reload
            href="/eventos?tipo=xauen"
            class="font-semibold text-black/65 fest:text-white/70 underline decoration-accent fest:decoration-season underline-offset-4 hover:text-black fest:hover:text-white"
          >
            Explorar archivo →
          </a>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            pastPivos.map(({ id, title, image, date, speakers, place, videoId }) => (
              <PivoCard
                id={id}
                title={title}
                image={image}
                speakers={speakers}
                place={place}
                date={date}
                videoId={videoId}
                detailUrl={"/eventos/" + slugify(title)}
                customClass="!min-w-0 !max-w-none !w-full"
              />
            ))
          }
        </div>
      </div>
    )
  }
</div>
