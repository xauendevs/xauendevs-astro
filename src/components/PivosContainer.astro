---
import PivoCard from "@/components/PivoCard.astro";
import { getPivosStrapi } from "@/lib/get-info-pivos";
import { slugify } from "@/lib/event-slug";
import { formatDate, formatTime } from "@/lib/format-date";
import LocationPin from "@/components/icons/LocationPin.astro";

const { STRAPI_HOST } = import.meta.env;
const pivos = await getPivosStrapi();
const now = new Date();

const nextEvent = pivos?.find((pivo) => pivo.date.getTime() > now.getTime());
const pastPivos = pivos?.filter((pivo) => pivo.date.getTime() < now.getTime()).slice(0, 3);
---

<div class="mt-8 space-y-12">
  {
    nextEvent && (
      <article class="grid overflow-hidden rounded-3xl bg-black/5 md:grid-cols-[1.35fr_0.65fr]">
        <div class="relative min-h-[300px] overflow-hidden md:min-h-[410px]">
          <div
            aria-hidden="true"
            class="absolute inset-0 bg-cover bg-center transition-transform duration-700 ease-out hover:scale-[1.02] motion-reduce:transition-none"
            style={"background-image:url('" + STRAPI_HOST + nextEvent.image + "'),url('/img/pivos/default.png')"}
          ></div>
          <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent"></div>
          <span class="absolute bottom-5 left-5 rounded-full bg-accent px-3 py-1.5 text-xs font-black uppercase tracking-wide text-black">
            Próxima Pivo&Code
          </span>
        </div>

        <div class="flex flex-col justify-between border-l-0 border-accent p-6 md:border-l-4 md:p-8">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.18em] text-accent">
              {formatDate(nextEvent.date)} · {formatTime(nextEvent.date)}
            </p>
            <h3 class="mt-3 text-3xl font-black leading-tight">
              {nextEvent.title}
            </h3>

            {
              nextEvent.speakers?.length > 0 && (
                <div class="mt-7 flex items-center gap-3">
                  <img
                    src={STRAPI_HOST + nextEvent.speakers[0].photo}
                    class="size-11 rounded-full object-cover"
                    alt={nextEvent.speakers[0].name}
                  />
                  <div>
                    <p class="text-xs uppercase tracking-wide text-black/45">Con</p>
                    <p class="font-bold">{nextEvent.speakers[0].name}</p>
                  </div>
                </div>
              )
            }

            {
              nextEvent.place && (
                <div class="mt-5 flex items-center gap-2 text-sm text-black/60">
                  <LocationPin class="size-4 shrink-0" />
                  <span>{nextEvent.place}</span>
                </div>
              )
            }
          </div>

          <a
            href={"/eventos/" + slugify(nextEvent.title)}
            class="mt-8 inline-flex w-fit items-center gap-2 rounded-full bg-black px-5 py-3 font-bold text-white transition-transform hover:scale-105 motion-reduce:transition-none"
          >
            Ver la charla <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    )
  }

  {
    pastPivos && pastPivos.length > 0 && (
      <div>
        <div class="mb-5 flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-black/40">
              Archivo reciente
            </p>
            <h3 class="mt-1 text-2xl font-bold md:text-3xl">
              Lo último que hemos compartido
            </h3>
          </div>
          <a
            data-astro-reload
            href="/eventos?tipo=xauen"
            class="font-semibold text-black/65 underline decoration-accent underline-offset-4 hover:text-black"
          >
            Explorar archivo →
          </a>
        </div>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
          {
            pastPivos.map(({ id, title, image, date, speakers, place, videoId }) => (
              <PivoCard
                id={id}
                title={title}
                image={image}
                speakers={speakers}
                place={place}
                date={date}
                videoId={videoId}
                detailUrl={"/eventos/" + slugify(title)}
                customClass="md:min-w-0 md:max-w-none md:w-full"
              />
            ))
          }
        </div>
      </div>
    )
  }
</div>
