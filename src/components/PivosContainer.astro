---
import PivoCard from "@/components/PivoCard.astro";
import { getPivosStrapi } from "@/lib/get-info-pivos";
import { slugify } from "@/lib/event-slug";

// La próxima Pivo ya está en la cabecera de la portada; aquí van las últimas charlas.
const pivos = await getPivosStrapi();
const now = new Date();
const pastPivos = pivos?.filter((pivo) => pivo.date.getTime() < now.getTime()).slice(0, 3);
---

{
  pastPivos && pastPivos.length > 0 && (
    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {pastPivos.map(({ id, title, image, date, speakers, place, videoId }) => (
        <PivoCard
          id={id}
          title={title}
          image={image}
          speakers={speakers}
          place={place}
          date={date}
          videoId={videoId}
          detailUrl={"/eventos/" + slugify(title)}
        />
      ))}
    </div>
  )
}
