---
import { formatDateTime } from "@/lib/format-date";
import { getPivosStrapi } from "@/lib/get-info-pivos";
import { slugify } from "@/lib/event-slug";

const now = Date.now();
const nextEvent = ((await getPivosStrapi()) ?? [])
  .filter((pivo) => pivo.date.getTime() > now)
  .sort((a, b) => a.date.getTime() - b.date.getTime())[0];
---

<a
  href={nextEvent ? `/eventos/${slugify(nextEvent.title)}` : "/eventos"}
  aria-label={nextEvent ? `Próxima Pivo&Code: ${nextEvent.title}, ${formatDateTime(nextEvent.date)}` : "Ver la agenda"}
  class="group inline-flex min-h-11 items-center gap-2 rounded-full bg-accent px-5 text-sm text-black transition hover:-translate-y-0.5 fest:text-season-ink motion-reduce:transition-none"
>
  {
    nextEvent ? (
      <>
        <span class="font-bold">Próxima Pivo</span>
        <span aria-hidden="true">·</span>
        <span class="font-semibold">{formatDateTime(nextEvent.date)}</span>
      </>
    ) : (
      <span class="font-bold">Ver la agenda</span>
    )
  }
  <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
</a>
