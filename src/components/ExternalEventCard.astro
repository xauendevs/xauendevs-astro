---
import type { ExternalEvent } from "@/types/ExternalEvent";
import { slugify } from "@/lib/event-slug";

interface Props {
  event: ExternalEvent;
}

const { event } = Astro.props;
const month = event.date
  .toLocaleDateString("es-ES", { month: "short" })
  .replace(".", "")
  .toUpperCase();
const day = event.date.toLocaleDateString("es-ES", { day: "2-digit" });
const endDay = event.endDate
  ? event.endDate.toLocaleDateString("es-ES", { day: "2-digit" })
  : null;
---

<article
  data-event-tags={event.tags.join(",")}
  class="group relative flex h-full min-w-0 flex-col overflow-hidden rounded-3xl border border-primary/10 hw:border-white/10 bg-white hw:bg-white/[0.04] p-4 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-xl sm:rounded-[2rem] sm:p-5"
>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-1 bg-accent transition-all duration-300 group-hover:h-1.5"></div>

  {event.image && (
    <div class="mb-5 overflow-hidden rounded-2xl border border-primary/10 hw:border-white/10 bg-primary/[0.025] hw:bg-white/[0.025]">
      <img
        src={event.image}
        alt=""
        class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        loading="lazy"
      />
    </div>
  )}

  <div class="flex min-w-0 items-start justify-between gap-3 sm:gap-4">
    <div class="flex min-w-[68px] shrink-0 flex-col items-center rounded-2xl bg-accent px-2.5 py-3 text-primary hw:text-black sm:min-w-[76px] sm:px-3">
      <span class="text-3xl font-black leading-none">{day}</span>
      <span class="mt-1 text-xs font-bold tracking-[0.18em]">{month}</span>
      {endDay && (
        <span class="mt-2 border-t border-primary/20 hw:border-black/20 pt-2 text-[10px] font-semibold">
          HASTA {endDay}
        </span>
      )}
    </div>

    <span class="rounded-full border border-accent/40 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-primary/60 hw:text-white/60">
      Externo
    </span>
  </div>

  <div class="mt-6 flex flex-1 flex-col">
    <h3 class="break-words text-lg font-bold leading-tight transition-colors group-hover:text-primary/80 hw:group-hover:text-white/80 sm:text-xl">
      {event.title}
    </h3>

    <div class="mt-3 flex flex-wrap gap-1.5">
      {event.tags.map((tag) => (
        <span class="rounded-full bg-primary/[0.06] hw:bg-white/[0.06] px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-primary/60 hw:text-white/60">
          {tag}
        </span>
      ))}
    </div>

    <p class="mt-3 break-words text-sm leading-relaxed text-primary/65 hw:text-white/65">
      {event.description}
    </p>
  </div>

  <div class="mt-6 space-y-2 border-t border-primary/10 hw:border-white/10 pt-4 text-sm">
    <div class="flex gap-2">
      <span class="text-primary/35 hw:text-white/35">●</span>
      <span class="min-w-0 break-words text-primary/65 hw:text-white/65">{event.organizer}</span>
    </div>
    <div class="flex gap-2">
      <span class="text-primary/35 hw:text-white/35">●</span>
      <span class="min-w-0 break-words text-primary/65 hw:text-white/65">{event.place}</span>
    </div>
  </div>

  <a
    href={`/eventos/${slugify(event.title)}`}
    class="mt-5 inline-flex max-w-full items-center gap-2 font-semibold underline decoration-accent decoration-2 underline-offset-4 transition-all group-hover:gap-3"
  >
    Ver evento <span aria-hidden="true">↗</span>
  </a>
</article>
