---
import type { ExternalEvent } from "@/types/ExternalEvent";
import { slugify } from "@/lib/event-slug";
import { formatDate, formatTime } from "@/lib/format-date";

interface Props {
  event: ExternalEvent;
}

// Misma forma que <PivoCard />: imagen, fecha, título y datos. Toda la tarjeta lleva a la ficha.
const { event } = Astro.props;
const endsAnotherDay = event.endDate && formatDate(event.endDate) !== formatDate(event.date);
---

<article
  data-event-tags={event.tags.join(",")}
  class="group relative flex h-full w-full min-w-0 flex-col overflow-hidden rounded-3xl bg-black/5 transition-transform duration-200 hover:-translate-y-1 fest:bg-white/5 fest:ring-1 fest:ring-white/10 motion-reduce:transition-none"
>
  {
    event.image && (
      <div class="aspect-[16/10] overflow-hidden bg-black/10">
        <img
          src={event.image}
          alt=""
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none"
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col gap-3 p-5">
    <p class="text-sm font-semibold text-black/70 first-letter:uppercase fest:text-white/70">
      <time datetime={event.date.toISOString()}>
        {formatDate(event.date)} · {formatTime(event.date)}
        {endsAnotherDay && ` al ${formatDate(event.endDate!)}`}
      </time>
    </p>

    <h3 class="text-lg font-bold leading-snug">
      <a
        href={`/eventos/${slugify(event.title)}`}
        class="after:absolute after:inset-0 after:content-[''] group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4"
      >
        {event.title}
      </a>
    </h3>

    {event.description && <p class="line-clamp-3 text-sm leading-relaxed text-black/75 fest:text-white/75">{event.description}</p>}

    <div class="mt-auto flex flex-col gap-2 pt-1 text-sm text-black/75 fest:text-white/75">
      <p>
        Organiza <span class="font-medium text-black fest:text-white">{event.organizer}</span>
      </p>
      {
        event.place && (
          <p class="flex min-w-0 items-center gap-2">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
            <span class="min-w-0 truncate">{event.place}</span>
          </p>
        )
      }
      {
        event.tags.length > 0 && (
          <ul class="flex flex-wrap gap-1.5 pt-1" aria-label="Temas">
            {event.tags.slice(0, 3).map((tag) => (
              <li class="rounded-full bg-black/[0.07] px-2.5 py-0.5 text-[13px] font-medium fest:bg-white/10">{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>
