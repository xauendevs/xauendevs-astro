---
import { formatDate, formatTime } from "@/lib/format-date";
import type { Charlante } from "@/types/Charlante";
import LocationPin from "./icons/LocationPin.astro";
import PivoVideoModal from "./PivoVideoModal.astro";

const { STRAPI_HOST } = import.meta.env;

interface Props {
  id: number;
  title: string;
  image: string;
  speakers?: Charlante[];
  place?: string;
  videoId?: string;
  date: Date;
  tags?: string[];
  detailUrl?: string;
  isNext?: boolean;
  customClass?: string;
}

const {
  id,
  title,
  image,
  isNext,
  speakers,
  place,
  date,
  videoId,
  tags = [],
  detailUrl,
  customClass,
} = Astro.props;

const speakerNames = speakers?.map((speaker) => speaker.name).join(", ");
const speakerName = speakers?.[0]?.name;
const eventLabel = isNext ? "Próximo evento" : "Pivo&Code";
---

{videoId && !detailUrl && <PivoVideoModal />}

<article
  id={id.toString()}
  data-url={videoId && !detailUrl ? `https://www.youtube.com/embed/${videoId}?si=NjLzFU-ifS-QmXD6` : undefined}
  data-clip-item={videoId && !detailUrl ? true : undefined}
  data-event-tags={tags.join(",")}
  class:list={[
    "group relative flex min-h-[350px] min-w-[200px] max-w-[200px] flex-col overflow-hidden rounded-3xl bg-[#356154] select-none md:min-h-[460px] md:max-h-[460px] md:min-w-[330px] md:max-w-[330px]",
    isNext && "next-pivo",
    videoId && !detailUrl && "cursor-pointer",
    customClass,
  ]}
>
  <div
    aria-hidden="true"
    class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat opacity-90 transition-transform duration-500 ease-out group-hover:scale-105 motion-reduce:transition-none"
    style={`background-image:url('${STRAPI_HOST}${image}'),url('/img/pivos/default.png')`}
  ></div>

  <div
    aria-hidden="true"
    class="absolute inset-0 z-10 bg-gradient-to-b from-black/5 via-black/15 to-black/90"
  ></div>

  <div class="relative z-10 mt-auto flex flex-col gap-4 p-4 text-white md:p-5">
    <div class="flex flex-wrap gap-1.5">
      <span class="rounded-full bg-white/15 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide backdrop-blur-sm">
        {eventLabel}
      </span>
      {tags.slice(0, 3).map((tag) => (
        <span class="rounded-full bg-white/15 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide backdrop-blur-sm">
          {tag}
        </span>
      ))}
    </div>

    <h3 class="line-clamp-2 min-h-[3.5rem] text-xl font-bold leading-tight md:text-2xl">
      {title}
    </h3>

    <div class="grid grid-cols-1 gap-3 border-t border-white/15 pt-3">
      <div class="flex min-w-0 items-center gap-3">
        {
          speakers && speakers.length > 0 ? (
            <div class="flex min-w-0 items-center gap-2">
              {speakers.length === 1 ? (
                <img
                  src={`${STRAPI_HOST}${speakers[0].photo}`}
                  class="size-9 shrink-0 rounded-full border border-white/30 object-cover"
                  alt={speakers[0].name}
                />
              ) : (
                <div class="flex -space-x-3">
                  <img
                    src={`${STRAPI_HOST}${speakers[0].photo}`}
                    class="size-9 rounded-full border-2 border-white object-cover"
                    alt={speakers[0].name}
                  />
                  <span class="flex size-9 items-center justify-center rounded-full border-2 border-white bg-black/60 text-[10px] font-bold">
                    +{speakers.length - 1}
                  </span>
                </div>
              )}
              <span class="min-w-0 truncate text-sm font-medium" title={speakerNames}>
                {speakerName}
                {speakers.length > 1 && " y más"}
              </span>
            </div>
          ) : (
            <span class="text-sm text-white/60">XauenDevs</span>
          )
        }
      </div>

      <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs font-medium text-white/75">
        <span class="inline-flex items-center gap-1.5">
          <span aria-hidden="true">📅</span>
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span aria-hidden="true">🕐</span>
          <time>{formatTime(date)}</time>
        </span>
        {place && (
          <span class="inline-flex min-w-0 items-center gap-1.5">
            <LocationPin class="size-3.5 shrink-0" />
            <span class="truncate">{place}</span>
          </span>
        )}
      </div>
    </div>
  </div>

  {
    detailUrl && (
      <>
        <a
          href={detailUrl}
          aria-label={`Ver evento: ${title}`}
          class="absolute inset-0 z-20"
        >
          <span class="sr-only">Ver evento: {title}</span>
        </a>
        <span class="pointer-events-none absolute bottom-4 right-4 z-30 rounded-full bg-white/90 px-4 py-2 text-xs font-bold text-primary shadow-lg backdrop-blur-sm transition-colors group-hover:bg-accent">
          Ver evento ↗
        </span>
      </>
    )
  }
</article>

<style>
  .next-pivo::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    border: 2px solid var(--color-accent);
    border-radius: 1.5rem;
    opacity: 0.85;
  }

  .next-pivo {
    box-shadow: 0 0 0 1px rgb(246 183 3 / 0.2), 0 20px 50px rgb(0 0 0 / 0.2);
  }

  article:not(.next-pivo) > div:first-child {
    filter: grayscale(100%);
    transition-property: transform, filter;
  }

  article:not(.next-pivo):hover > div:first-child {
    filter: grayscale(0%);
  }

  @media (prefers-reduced-motion: reduce) {
    article > div:first-child {
      transition: none;
    }
  }
</style>
