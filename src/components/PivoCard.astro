---
import { formatDate, formatTime } from "@/lib/format-date";
import type { Charlante } from "@/types/Charlante";
import PivoVideoModal from "./PivoVideoModal.astro";

const { STRAPI_HOST } = import.meta.env;

interface Props {
  id: number;
  title: string;
  image: string;
  speakers?: Charlante[];
  place?: string;
  videoId?: string;
  date: Date;
  tags?: string[];
  detailUrl?: string;
  isNext?: boolean;
  customClass?: string;
}

const { id, title, image, isNext, speakers, place, date, videoId, tags = [], detailUrl, customClass } = Astro.props;

const speakerNames = speakers?.map((speaker) => speaker.name).join(", ");
// Sin ficha propia, la tarjeta abre el vídeo en el modal (comportamiento de siempre).
const opensVideo = Boolean(videoId && !detailUrl);
---

{opensVideo && <PivoVideoModal />}

<article
  id={id.toString()}
  data-url={opensVideo ? `https://www.youtube.com/embed/${videoId}?si=NjLzFU-ifS-QmXD6` : undefined}
  data-clip-item={opensVideo ? true : undefined}
  data-event-tags={tags.join(",")}
  class:list={[
    "group relative flex w-full min-w-0 flex-col overflow-hidden rounded-3xl bg-black/5 transition-transform duration-200 hover:-translate-y-1 fest:bg-white/5 fest:ring-1 fest:ring-white/10 motion-reduce:transition-none",
    isNext && "ring-2 ring-accent",
    opensVideo && "clip-container cursor-pointer",
    customClass,
  ]}
>
  <div class="relative aspect-[16/10] overflow-hidden bg-black/10">
    <img
      src={`${STRAPI_HOST}${image}`}
      onerror="this.onerror=null;this.src='/img/pivos/default.png'"
      alt=""
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none"
    />
    {
      videoId && (
        <span class="absolute bottom-3 left-3 inline-flex items-center gap-1.5 rounded-full bg-black/75 px-3 py-1 text-[13px] font-semibold text-white">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-3.5" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
          Con vídeo
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <p class="text-sm font-semibold first-letter:uppercase text-black/70 fest:text-white/70">
      <time datetime={date.toISOString()}>{formatDate(date)} · {formatTime(date)}</time>
    </p>

    <h3 class="text-lg font-bold leading-snug">
      {
        detailUrl ? (
          <a href={detailUrl} class="after:absolute after:inset-0 after:content-[''] group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>

    <div class="mt-auto flex flex-col gap-2 pt-1 text-sm text-black/75 fest:text-white/75">
      {
        speakers && speakers.length > 0 && (
          <p class="flex min-w-0 items-center gap-2" title={speakerNames}>
            {speakers[0].photo && (
              <img src={`${STRAPI_HOST}${speakers[0].photo}`} class="size-7 shrink-0 rounded-full object-cover" alt="" />
            )}
            <span class="min-w-0 truncate font-medium text-black fest:text-white">{speakerNames}</span>
          </p>
        )
      }
      {
        place && (
          <p class="flex min-w-0 items-center gap-2">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
            <span class="min-w-0 truncate">{place}</span>
          </p>
        )
      }
      {
        tags.length > 1 && (
          <ul class="flex flex-wrap gap-1.5 pt-1" aria-label="Temas">
            {tags.filter((tag) => tag !== "Charlas").slice(0, 3).map((tag) => (
              <li class="rounded-full bg-black/[0.07] px-2.5 py-0.5 text-[13px] font-medium fest:bg-white/10">{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>
