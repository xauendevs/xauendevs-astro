---
interface Props {
  name: string;
  url: string;
  mainColor?: string;
  logo: string;
}

const { name, logo, url } = Astro.props;
const { STRAPI_HOST } = import.meta.env;
---

<a href={url} class="h-full fest:flex fest:items-center fest:justify-center fest:rounded-2xl fest:bg-white fest:p-4">
  <img src={`${STRAPI_HOST}${logo}`} alt={`Logo de ${name}`} class="h-full" />
</a>
