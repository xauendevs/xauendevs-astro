---
interface Props {
  name: string;
  url: string;
  mainColor?: string;
  logo: string;
}

const { name, logo, url } = Astro.props;
const { STRAPI_HOST } = import.meta.env;
---

<a href={url} class="flex h-full items-center justify-center rounded-2xl bg-white p-4">
  <img src={`${STRAPI_HOST}${logo}`} alt={`Logo de ${name}`} class="h-full" />
</a>
