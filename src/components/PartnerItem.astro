---
interface Props {
  name: string;
  url: string;
  mainColor?: string;
  logo: string;
}

const { name, logo, url } = Astro.props;
const { STRAPI_HOST } = import.meta.env;
---

<a href={url} class="h-full hw:flex hw:items-center hw:justify-center hw:rounded-2xl hw:bg-white hw:p-4">
  <img src={`${STRAPI_HOST}${logo}`} alt={`Logo de ${name}`} class="h-full" />
</a>
