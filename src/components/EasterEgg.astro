---
/**
 * Easter egg: lluvia de aceitunas 🫒 (src/scripts/easter-egg.ts).
 *
 * - Se activa con el código Konami (↑ ↑ ↓ ↓ ← → ← → B A) o tocando 5 veces la firma del footer
 *   (cualquier elemento con `data-easter-egg`), para que también se pueda en el móvil.
 * - Además, deja un saludo en la consola para los devs curiosos.
 * - El código de la animación solo se descarga cuando se activa.
 */
---

<script>
  const KONAMI = ["arrowup", "arrowup", "arrowdown", "arrowdown", "arrowleft", "arrowright", "arrowleft", "arrowright", "b", "a"];
  const TAPS = 5;
  const TAP_WINDOW = 2000;

  const launch = () => import("../scripts/easter-egg").then((module) => module.runEasterEgg());

  // Los scripts de módulo se ejecutan una sola vez aunque haya navegación con ClientRouter,
  // así que los listeners van al `document` y sobreviven a los cambios de página.
  let progress = 0;
  document.addEventListener("keydown", (event) => {
    const { target } = event;
    if (target instanceof Element && target.closest("input, textarea, select, [contenteditable]")) return;
    const key = event.key.toLowerCase();
    progress = key === KONAMI[progress] ? progress + 1 : key === KONAMI[0] ? 1 : 0;
    if (progress === KONAMI.length) {
      progress = 0;
      launch();
    }
  });

  let taps: number[] = [];
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element && event.target.closest("[data-easter-egg]"))) return;
    const now = Date.now();
    taps = [...taps.filter((t) => now - t < TAP_WINDOW), now];
    if (taps.length >= TAPS) {
      taps = [];
      launch();
    }
  });

  console.log(
    "%c:X\\D >_%c\n\n¿Curioseando el código? Eres de los nuestros 💚\nEsta web es open source: https://github.com/xauendevs/xauendevs-astro\nPista: ↑ ↑ ↓ ↓ ← → ← → B A",
    "font: 700 28px ui-monospace, monospace; color: #f6b703;",
    "font: 13px ui-monospace, monospace;",
  );
</script>

<style is:global>
  #xd-egg {
    position: fixed;
    inset: 0;
    z-index: 2147482000;
    overflow: hidden;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }
  #xd-egg.is-leaving,
  .xd-egg-toast.is-leaving {
    opacity: 0;
  }
  .xd-olive {
    position: absolute;
    top: -60px;
    line-height: 1;
    animation: xd-olive-fall linear both;
    will-change: transform;
  }
  @keyframes xd-olive-fall {
    to {
      transform: translate3d(var(--drift), calc(100vh + 120px), 0) rotate(var(--spin));
    }
  }
  .xd-egg-toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 2147482001;
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: min(420px, calc(100vw - 32px));
    padding: 16px 20px;
    border-radius: 16px;
    background: #0d0d0d;
    color: #fff;
    font-size: 14px;
    line-height: 1.45;
    box-shadow: 0 12px 40px -8px rgba(0, 0, 0, 0.5), 0 0 0 2px var(--color-accent);
    transform: translateX(-50%);
    animation: xd-toast-in 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.3) both;
    transition: opacity 0.6s ease;
  }
  .xd-egg-toast strong {
    color: var(--color-accent);
    font-size: 16px;
  }
  @keyframes xd-toast-in {
    from {
      opacity: 0;
      transform: translate(-50%, 24px);
    }
  }
</style>
