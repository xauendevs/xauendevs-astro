---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { isHalloweenSeason } from "@/lib/season";

export const prerender = false;
const halloween = await isHalloweenSeason(Astro);
---

<Layout
  title="XauenDevs 🫒 Desarrollo en Jaén"
  description="Comunidad de desarrollo y tecnología de la provincia de Jaén. ¡Únete!"
>
  {
    halloween ? (
      <PageHeader eyebrow="XauenDevs" title="Blog">Estamos trabajando en nuestro blog.</PageHeader>
    ) : (
      <main class="flex flex-col gap-8">ESTAMOS TRABAJANDO EN NUESTRO BLOG</main>
    )
  }
</Layout>
