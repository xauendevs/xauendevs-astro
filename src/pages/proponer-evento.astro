---
import Layout from "@/layouts/Layout.astro";
import SeasonOverlay from "@/components/season/SeasonOverlay.astro";
---

<Layout
  title="Propón un evento · XauenDevs"
  description="Propón un evento tecnológico para incluirlo en la agenda de Jaén Tech Events."
>
  <main class="flex flex-col gap-12">
    <header class="relative overflow-hidden rounded-3xl bg-black fest:bg-night px-7 py-10 text-white md:px-12 md:py-14">
      <SeasonOverlay />

      <div class="relative max-w-3xl">
        <h1 class="text-4xl font-black tracking-tight md:text-6xl">
          Propón un evento
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/85 md:text-xl">
          ¿Organizas algo tech en Jaén o quieres dar una charla en una Pivo&Code? Cuéntanoslo y te respondemos por email.
        </p>
      </div>
    </header>

    <section class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px]">
      <form
        id="event-proposal-form"
        class="flex flex-col gap-7 rounded-3xl bg-black/[0.04] p-6 fest:bg-white/[0.04] fest:ring-1 fest:ring-season/40 md:p-8"
        novalidate
      >
        <div>
          <h2 class="text-2xl font-bold">Cuéntanos sobre el evento</h2>
          <p class="mt-2 text-base text-black/80 fest:text-white/80">
            Los campos con * son obligatorios. Tardarás un par de minutos.
          </p>
        </div>

        <div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden">
          <label>
            No rellenar este campo
            <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          <label class="flex flex-col gap-2">
            <span class="text-base font-semibold">Título del evento o charla *</span>
            <input
              required
              name="title"
              type="text"
              placeholder="Ej. Introducción a Rust"
              class="min-h-12 rounded-2xl border border-black/20 bg-white px-4 py-3 text-base text-black outline-none transition focus:border-black focus:ring-2 focus:ring-accent aria-[invalid=true]:border-red-700 fest:border-white/20 fest:bg-white/[0.06] fest:text-white"
            />
          </label>

          <label class="flex flex-col gap-2">
            <span class="text-base font-semibold">Quién lo organiza *</span>
            <input
              required
              name="organizer"
              type="text"
              placeholder="Tu nombre, comunidad o empresa"
              class="min-h-12 rounded-2xl border border-black/20 bg-white px-4 py-3 text-base text-black outline-none transition focus:border-black focus:ring-2 focus:ring-accent aria-[invalid=true]:border-red-700 fest:border-white/20 fest:bg-white/[0.06] fest:text-white"
            />
          </label>

          <label class="flex flex-col gap-2">
            <span class="text-base font-semibold">Email de contacto *</span>
            <input
              required
              name="email"
              type="email"
              autocomplete="email"
              placeholder="tu@email.com"
              class="min-h-12 rounded-2xl border border-black/20 bg-white px-4 py-3 text-base text-black outline-none transition focus:border-black focus:ring-2 focus:ring-accent aria-[invalid=true]:border-red-700 fest:border-white/20 fest:bg-white/[0.06] fest:text-white"
            />
          </label>

        </div>

        <div class="grid gap-6 md:grid-cols-2">
          <label class="flex flex-col gap-2">
            <span class="text-base font-semibold">Fecha prevista *</span>
            <input
              required
              name="date"
              type="date"
              data-min-today
              class="min-h-12 rounded-2xl border border-black/20 bg-white px-4 py-3 text-base text-black outline-none transition focus:border-black focus:ring-2 focus:ring-accent aria-[invalid=true]:border-red-700 fest:border-white/20 fest:bg-white/[0.06] fest:text-white"
            />
          </label>

          <label class="flex flex-col gap-2">
            <span class="text-base font-semibold">Lugar *</span>
            <input
              required
              name="place"
              type="text"
              placeholder="Jaén, Universidad de Jaén..."
              class="min-h-12 rounded-2xl border border-black/20 bg-white px-4 py-3 text-base text-black outline-none transition focus:border-black focus:ring-2 focus:ring-accent aria-[invalid=true]:border-red-700 fest:border-white/20 fest:bg-white/[0.06] fest:text-white"
            />
          </label>
        </div>

        <label class="flex flex-col gap-2">
          <span class="text-base font-semibold">Web del evento</span>
          <input
            name="url"
            type="url"
            placeholder="https://..."
            class="min-h-12 rounded-2xl border border-black/20 bg-white px-4 py-3 text-base text-black outline-none transition focus:border-black focus:ring-2 focus:ring-accent aria-[invalid=true]:border-red-700 fest:border-white/20 fest:bg-white/[0.06] fest:text-white"
          />
        </label>

        <label class="flex flex-col gap-2">
          <span class="text-base font-semibold">Cuéntanos un poco más *</span>
          <textarea
            required
            name="description"
            rows="5"
            placeholder="¿De qué trata? ¿A quién va dirigido? ¿Qué tipo de evento es?"
            class="resize-y rounded-2xl border border-black/20 bg-white px-4 py-3 text-base text-black outline-none transition focus:border-black focus:ring-2 focus:ring-accent aria-[invalid=true]:border-red-700 fest:border-white/20 fest:bg-white/[0.06] fest:text-white"
          ></textarea>
        </label>

        <button
          type="submit"
          class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-black px-6 py-3 font-bold text-white transition hover:-translate-y-0.5 disabled:cursor-wait disabled:opacity-60 fest:bg-season fest:text-season-ink sm:w-fit"
        >
          Enviar propuesta →
        </button>

        <p
          id="proposal-status"
          class="hidden rounded-2xl border-l-4 border-accent bg-white p-4 text-base font-semibold text-black"
          tabindex="-1"
          role="status"
          aria-live="polite"
        ></p>
      </form>

      <aside class="flex h-fit flex-col gap-4 rounded-3xl bg-accent p-7 text-black fest:bg-season fest:text-season-ink">
        <h2 class="text-2xl font-black leading-tight">
          ¿Qué buscamos?
        </h2>
        <p class="text-base">Cosas que muevan la comunidad tech de Jaén:</p>
        <ul class="flex flex-col gap-2 text-base leading-relaxed">
          <li>→ Charlas y meetups</li>
          <li>→ Talleres y workshops</li>
          <li>→ Hackathons y retos</li>
          <li>→ Conferencias</li>
          <li>→ Actividades de comunidades tech</li>
        </ul>
        <p class="border-t border-black/15 pt-5 text-base fest:border-season-ink/15">
          Revisamos cada propuesta antes de añadirla a la agenda y te escribimos si necesitamos algo más.
        </p>
      </aside>
    </section>
  </main>

  <script>
    const form = document.querySelector<HTMLFormElement>("#event-proposal-form");
    const status = document.querySelector<HTMLElement>("#proposal-status");
    const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

    // Rellenar desde ?titulo= (enlaces desde la portada) y no dejar elegir fechas pasadas.
    const params = new URLSearchParams(location.search);
    const titleInput = form?.querySelector<HTMLInputElement>('input[name="title"]');
    if (titleInput && params.get("titulo")) titleInput.value = params.get("titulo")!.slice(0, 120);
    const dateInput = form?.querySelector<HTMLInputElement>("[data-min-today]");
    if (dateInput) dateInput.min = new Date().toLocaleDateString("en-CA");

    // Marca los campos que fallan y lleva el foco al primero; el navegador muestra el motivo.
    const markInvalid = () => {
      if (!form) return false;
      const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input:not([tabindex='-1']), textarea"));
      fields.forEach((field) => field.setAttribute("aria-invalid", String(!field.checkValidity())));
      return form.reportValidity();
    };
    form?.addEventListener("input", (event) => {
      const field = event.target as HTMLInputElement;
      if (field.getAttribute("aria-invalid") === "true" && field.checkValidity()) field.setAttribute("aria-invalid", "false");
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!markInvalid() || !status || !submitButton) return;

      const data = Object.fromEntries(new FormData(form).entries());
      status.classList.remove("hidden");
      status.textContent = "Enviando propuesta…";
      submitButton.disabled = true;
      submitButton.textContent = "Enviando…";

      try {
        const response = await fetch("/api/proponer-evento", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const result = await response.json();

        if (!response.ok) throw new Error(result.error || "No se pudo enviar la propuesta.");

        status.textContent = "¡Gracias! Hemos recibido tu propuesta. Te escribiremos al email que nos has dejado.";
        form.reset();
        status.focus();
      } catch (error) {
        status.textContent = error instanceof Error
          ? error.message
          : "No se pudo enviar la propuesta. Inténtalo de nuevo.";
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Enviar propuesta →";
      }
    });
  </script>
</Layout>
