---
import Layout from "@/layouts/Layout.astro";
import { getPivosStrapi } from "@/lib/get-info-pivos";
import { getPivoTags } from "@/lib/get-pivo-tags";
import { externalEvents } from "@/data/external-events";
import { slugify } from "@/lib/event-slug";
import type { Pivo } from "@/types/Pivo";
import type { ExternalEvent } from "@/data/external-events";

export const prerender = true;

export async function getStaticPaths() {
  const events = (await getPivosStrapi()) ?? [];

  return [
    ...events.map((event) => ({
      params: { slug: slugify(event.title) },
      props: {
        kind: "pivo" as const,
        event: { ...event, tags: getPivoTags(event.title) },
      },
    })),
    ...externalEvents.map((event) => ({
      params: { slug: slugify(event.id) },
      props: {
        kind: "external" as const,
        event,
      },
    })),
  ];
}

interface Props {
  kind: "pivo" | "external";
  event: Pivo | ExternalEvent;
}

const { kind, event } = Astro.props;
const STRAPI_HOST = import.meta.env.STRAPI_HOST;
const isExternal = kind === "external";
const pivoEvent = event as Pivo;
const externalEvent = event as ExternalEvent;
const tags = "tags" in event ? (event.tags ?? []) : getPivoTags(event.title);
const date = event.date;

const formattedDate = date.toLocaleDateString("es-ES", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});

const formattedTime = date.toLocaleTimeString("es-ES", {
  hour: "2-digit",
  minute: "2-digit",
  timeZone: "Europe/Madrid",
});

const description =
  event.description ||
  (isExternal
    ? "Evento tecnológico en Jaén."
    : `Charla de XauenDevs: ${event.title}.`);

const title = `${event.title} · XauenDevs`;
const locationQuery = (isExternal ? externalEvent.mapQuery : undefined) || [event.place, "Jaén, España"].filter(Boolean).join(", ");
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(locationQuery)}`;
const mapsEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(locationQuery)}&output=embed`;
const eventImage = isExternal
  ? externalEvent.image
  : pivoEvent.image
    ? `${STRAPI_HOST}${pivoEvent.image}`
    : undefined;

const ogParams = new URLSearchParams({
  title: event.title,
  date: `${formattedDate} · ${formattedTime}`,
  place: event.place || "Jaén",
  organizer: isExternal ? externalEvent.organizer : "XauenDevs",
  description: description,
  label: isExternal ? "EVENTO EXTERNO" : "PIVO&CODE",
});

if (tags.length > 0) {
  ogParams.set("tags", tags.slice(0, 3).join(" · "));
}

const socialImage = `/api/og.png?${ogParams.toString()}`;

const calendarEnd = "endDate" in event && event.endDate
  ? event.endDate
  : new Date(date.getTime() + 60 * 60 * 1000);
const calendarStart = date.toISOString().replace(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z");
const calendarEndValue = calendarEnd.toISOString().replace(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z");
const calendarLocation = encodeURIComponent(event.place || "Jaén, España");
const calendarTitle = encodeURIComponent(event.title);
const calendarDescription = encodeURIComponent(description);
const googleCalendarUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${calendarTitle}&dates=${calendarStart}/${calendarEndValue}&details=${calendarDescription}&location=${calendarLocation}`;
const escapeIcs = (value: string) =>
  value.replace(/\\/g, "\\\\").replace(/;/g, "\\;").replace(/,/g, "\\,").replace(/\r?\n/g, "\\n");
const icsContent = [
  "BEGIN:VCALENDAR",
  "VERSION:2.0",
  "PRODID:-//XauenDevs//Eventos//ES",
  "BEGIN:VEVENT",
  `UID:${slugify(event.title)}@xauendevs.io`,
  `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z")}`,
  `DTSTART:${calendarStart}`,
  `DTEND:${calendarEndValue}`,
  `SUMMARY:${escapeIcs(event.title)}`,
  `DESCRIPTION:${escapeIcs(description)}`,
  `LOCATION:${escapeIcs(event.place || "Jaén, España")}`,
  "END:VEVENT",
  "END:VCALENDAR",
].join("\r\n");
const icsUrl = `data:text/calendar;charset=utf-8,${encodeURIComponent(icsContent)}`;
const eventOrigin = import.meta.env.PROD ? Astro.site : new URL(Astro.url.origin);
const eventUrl = new URL(Astro.url.pathname, eventOrigin).href;
const eventId = slugify(event.title);
const eventDate = date.toLocaleDateString("es-ES", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const eventTime = date.toLocaleTimeString("es-ES", {
  hour: "2-digit",
  minute: "2-digit",
  timeZone: "Europe/Madrid",
});
const shareMessage = [
  "🚨 Ojo con esto…",
  "",
  `¿Te apuntas a *${event.title}*? 👀`,
  "",
  description,
  "",
  `📆 ${eventDate}, ${eventTime}`,
  `📍 ${event.place || "Jaén"}`,
  "",
  "Organizado por:",
  `📣 ${isExternal ? externalEvent.organizer : "XauenDevs"}`,
  "",
  "Más información y apuntes:",
  eventUrl,
].join("\n");
const encodedShareMessage = encodeURIComponent(shareMessage);
const whatsappUrl = `https://api.whatsapp.com/send/?text=${encodedShareMessage}`;
---

<Layout title={title} description={description} image={socialImage} imageType="image/png">
  <main class="flex flex-col gap-10 pb-16">
    <a
      href="/eventos"
      class="inline-flex w-fit items-center gap-2 text-sm font-semibold text-primary/55 transition-colors hover:text-primary"
    >
      ← Volver a eventos
    </a>

    <article class="overflow-hidden rounded-[2.5rem] border border-primary/10 bg-primary/[0.025]">
      {eventImage && (
        <div class="relative aspect-[1200/630] overflow-hidden bg-primary md:h-[26rem] md:aspect-auto">
          <img
            src={eventImage}
            alt=""
            class="size-full object-cover object-bottom"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/35 to-transparent"></div>
          <div class="absolute inset-0 bg-primary/10"></div>
        </div>
      )}

      <div class="relative overflow-hidden bg-[#0d0d0d] px-7 py-8 text-white md:px-12 md:py-10">
        <div class="pointer-events-none absolute -right-24 -top-32 h-80 w-80 rounded-full bg-accent/25 blur-3xl"></div>

        <div class="relative max-w-5xl">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-accent px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-primary">
              {isExternal ? "Evento externo" : "XauenDevs"}
            </span>
            {tags.map((tag) => (
              <span class="rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-semibold text-white/80">
                {tag}
              </span>
            ))}
          </div>

          <h1 class="mt-7 max-w-5xl text-4xl font-black tracking-tight md:text-6xl">
            {event.title}
          </h1>

        </div>
      </div>

      <div class="grid gap-10 p-7 md:p-10 lg:grid-cols-[minmax(0,1fr)_320px]">
        <div class="flex flex-col gap-8">
          <section>
            <span class="text-accent text-xs font-bold uppercase tracking-[0.16em]">
              Cuándo
            </span>
            <p class="mt-2 text-2xl font-bold">{formattedDate}</p>
            <p class="mt-1 text-primary/55">A las {formattedTime}</p>
          </section>

          <section>
            <span class="text-accent text-xs font-bold uppercase tracking-[0.16em]">
              Dónde
            </span>
            <p class="mt-2 text-xl font-semibold">{event.place || "Por confirmar"}</p>
            {event.place && (
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex items-center gap-2 text-sm font-bold text-primary/60 underline decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-primary"
              >
                Cómo llegar ↗
              </a>
            )}
          </section>

          <section>
            <span class="text-accent text-xs font-bold uppercase tracking-[0.16em]">
              Organiza
            </span>
            <p class="mt-2 text-xl font-semibold">
              {isExternal ? externalEvent.organizer : "XauenDevs"}
            </p>
          </section>

          <section class="rounded-[2rem] border border-primary/10 bg-primary/[0.025] p-6 md:p-7">
            <span class="text-accent text-xs font-bold uppercase tracking-[0.16em]">
              Sobre el evento
            </span>
            <p class="mt-3 max-w-3xl text-base leading-relaxed text-primary/65 md:text-lg">
              {description}
            </p>
          </section>

          {
            !isExternal && pivoEvent.speakers && pivoEvent.speakers.length > 0 && (
              <section>
                <span class="text-accent text-xs font-bold uppercase tracking-[0.16em]">
                  Ponentes
                </span>
                <div class="mt-4 flex flex-wrap gap-4">
                  {pivoEvent.speakers?.map((speaker) => (
                    <div class="flex items-center gap-3 rounded-2xl border border-primary/10 px-4 py-3">
                      <img
                        src={`${import.meta.env.STRAPI_HOST}${speaker.photo}`}
                        alt={speaker.name}
                        class="size-10 rounded-full object-cover"
                      />
                      <span class="font-semibold">{speaker.name}</span>
                    </div>
                  ))}
                </div>
              </section>
            )
          }
        </div>

        <aside class="flex h-fit flex-col gap-4 rounded-[2rem] bg-accent p-6">
          <span class="text-xs font-bold uppercase tracking-[0.16em]">
            {isExternal ? "Evento externo" : "XauenDevs"}
          </span>

          <h2 class="text-2xl font-black leading-tight">
            {isExternal
              ? "Consulta todos los detalles del evento."
              : "Descubre esta charla."}
          </h2>

          <p class="text-sm leading-relaxed text-black/65">
            {isExternal
              ? "Fecha, ubicación, programa e información actualizada directamente en la web oficial del evento."
              : "Consulta los detalles de la charla y, si quieres asistir, añade el evento directamente a tu calendario."}
          </p>

          {
            isExternal ? (
              <a
                href={externalEvent.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-flex w-fit rounded-full !bg-black px-5 py-3 font-bold !text-white transition-transform hover:-translate-y-0.5 hover:!bg-black"
              >
                Web del evento ↗
              </a>
            ) : pivoEvent.saraosLink ? (
              <a
                href={pivoEvent.saraosLink}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-flex w-fit rounded-full !bg-black px-5 py-3 font-bold !text-white transition-transform hover:-translate-y-0.5 hover:!bg-black"
              >
                Más información ↗
              </a>
            ) : null
          }

          {!isExternal && (
            <section class="mt-2 rounded-2xl bg-black/5 p-5" data-rsvp data-event-id={eventId}>
              <span class="text-xs font-bold uppercase tracking-[0.14em]">Asistencia</span>
              <h3 class="mt-2 text-xl font-black">¿Te apuntas?</h3>
              <p class="mt-1 text-sm leading-relaxed text-black/60">Reserva tu plaza para esta Pivo&Code.</p>
              <p class="mt-3 text-sm font-semibold" data-rsvp-count>Comprobando plazas…</p>
              <form class="mt-4 flex flex-col gap-3" data-rsvp-form>
                <label class="flex flex-col gap-1.5">
                  <span class="text-xs font-bold uppercase tracking-wide text-black/60">Nombre</span>
                  <input required name="name" autocomplete="name" maxlength="100" placeholder="Tu nombre" class="rounded-xl border border-black/10 bg-white/60 px-3 py-2.5 text-sm outline-none transition focus:border-black/30 focus:ring-2 focus:ring-black/10" />
                </label>
                <label class="flex flex-col gap-1.5">
                  <span class="text-xs font-bold uppercase tracking-wide text-black/60">Email</span>
                  <input required name="email" type="email" autocomplete="email" maxlength="254" placeholder="tu@email.com" class="rounded-xl border border-black/10 bg-white/60 px-3 py-2.5 text-sm outline-none transition focus:border-black/30 focus:ring-2 focus:ring-black/10" />
                </label>
                <label class="flex items-start gap-2 text-xs leading-relaxed text-black/60">
                  <input required name="consent" type="checkbox" class="mt-0.5 accent-black" />
                  <span>Acepto que XauenDevs guarde estos datos para gestionar mi asistencia a este evento.</span>
                </label>
                <button type="submit" class="mt-1 rounded-full bg-black px-5 py-3 text-sm font-bold text-white transition-transform hover:-translate-y-0.5 disabled:cursor-wait disabled:opacity-60">Quiero asistir →</button>
                <p class="hidden text-sm font-semibold" data-rsvp-message></p>
              </form>
            </section>
          )}

          <div class="mt-2 border-t border-black/10 pt-4">
            <span class="text-xs font-bold uppercase tracking-[0.14em]">
              Añadir al calendario
            </span>
            <div class="mt-3 flex flex-wrap gap-2">
              <a
                href={googleCalendarUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex rounded-full bg-black px-4 py-2 text-xs font-bold text-white transition-transform hover:-translate-y-0.5"
              >
                Google Calendar
              </a>
              <a
                href={icsUrl}
                download={`${slugify(event.title)}.ics`}
                class="inline-flex rounded-full border border-black/20 px-4 py-2 text-xs font-bold transition-colors hover:bg-black/10"
              >
                Descargar .ics
              </a>
            </div>
          </div>

          {event.place && (
            <div class="mt-2 overflow-hidden rounded-2xl border border-black/10 bg-white/30">
              <div class="h-64 w-full md:h-72">
                <iframe
                  src={mapsEmbedUrl}
                  title={`Mapa de ${event.place}`}
                  class="size-full border-0"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                ></iframe>
              </div>
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between px-4 py-3 text-sm font-bold text-primary transition-colors hover:bg-white/30"
              >
                <span>Cómo llegar</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          )}

          <div class="mt-2 border-t border-black/10 pt-5">
            <span class="text-xs font-bold uppercase tracking-[0.14em]">
              Compartir evento
            </span>
            <p class="mt-2 text-sm leading-relaxed text-black/60">
              WhatsApp lleva el texto listo. En LinkedIn copiamos el mensaje y abrimos el editor para que solo tengas que pegarlo.
            </p>
            <div class="mt-3 flex flex-wrap gap-2">
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex rounded-full bg-black px-4 py-2 text-xs font-bold text-white transition-transform hover:-translate-y-0.5"
              >
                WhatsApp
              </a>
              <button
                type="button"
                data-linkedin-share={shareMessage}
                class="inline-flex rounded-full bg-black px-4 py-2 text-xs font-bold text-white transition-transform hover:-translate-y-0.5"
              >
                LinkedIn
              </button>
              <button
                type="button"
                data-copy-share-message={shareMessage}
                class="inline-flex rounded-full border border-black/20 px-4 py-2 text-xs font-bold transition-colors hover:bg-black/10"
              >
                Copiar mensaje
              </button>
            </div>
          </div>


        </aside>
      </div>
    </article>

    {
      !isExternal && pivoEvent.videoId && (
        <section class="overflow-hidden rounded-[2.5rem] bg-primary p-4 md:p-6">
          <div class="mb-5 px-2">
            <span class="text-accent text-xs font-bold uppercase tracking-[0.16em]">
              Vídeo
            </span>
            <h2 class="mt-1 text-2xl font-bold text-white">
              Revive la charla
            </h2>
          </div>
          <div class="aspect-video overflow-hidden rounded-2xl">
            <iframe
              class="size-full"
              src={`https://www.youtube.com/embed/${pivoEvent.videoId}`}
              title={event.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        </section>
      )
    }
  </main>
<script>
  document.querySelectorAll<HTMLElement>("[data-rsvp]").forEach((rsvp) => {
    const eventId = rsvp.dataset.eventId;
    const form = rsvp.querySelector<HTMLFormElement>("[data-rsvp-form]");
    const count = rsvp.querySelector<HTMLElement>("[data-rsvp-count]");
    const message = rsvp.querySelector<HTMLElement>("[data-rsvp-message]");

    if (!eventId || !form || !count || !message) return;

    const loadCount = async () => {
      try {
        const response = await fetch("/api/rsvp?eventId=" + encodeURIComponent(eventId));
        if (!response.ok) throw new Error();
        const data = await response.json();
        count.textContent = data.count + " " + (data.count === 1 ? "persona apunta" : "personas apuntadas");
      } catch {
        count.textContent = "No se pudo consultar la asistencia.";
      }
    };

    void loadCount();

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
      const formData = new FormData(form);

      message.classList.add("hidden");
      submit?.setAttribute("disabled", "true");

      try {
        const response = await fetch("/api/rsvp", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            eventId,
            name: formData.get("name"),
            email: formData.get("email"),
            consent: formData.get("consent") === "on",
          }),
        });
        const data = await response.json();

        if (!response.ok) throw new Error(data.error || "No se pudo completar la inscripción.");

        form.reset();
        count.textContent = data.count + " " + (data.count === 1 ? "persona apunta" : "personas apuntadas");
        message.textContent = "¡Apuntado! Te esperamos en la Pivo&Code. ✓";
        message.className = "text-sm font-semibold text-black";
      } catch (error) {
        message.textContent = error instanceof Error ? error.message : "No se pudo completar la inscripción.";
        message.className = "text-sm font-semibold text-red-800";
      } finally {
        submit?.removeAttribute("disabled");
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-copy-share-message]").forEach((button) => {
    button.addEventListener("click", async () => {
      const message = button.dataset.copyShareMessage;
      if (!message) return;

      try {
        await navigator.clipboard.writeText(message);
        const originalText = button.textContent;
        button.textContent = "Mensaje copiado ✓";
        window.setTimeout(() => {
          button.textContent = originalText;
        }, 2000);
      } catch {
        button.textContent = "No se pudo copiar";
        window.setTimeout(() => {
          button.textContent = "Copiar mensaje";
        }, 2000);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-linkedin-share]").forEach((button) => {
    button.addEventListener("click", async () => {
      const message = button.dataset.linkedinShare;
      if (!message) return;

      window.open(
        "https://www.linkedin.com/sharing/share-offsite/?url=" + encodeURIComponent(window.location.href),
        "_blank",
        "noopener,noreferrer",
      );

      try {
        await navigator.clipboard.writeText(message);
        const originalText = button.textContent;
        button.textContent = "Texto copiado ✓";
        window.setTimeout(() => {
          button.textContent = originalText;
        }, 2000);
      } catch {
        button.textContent = "No se pudo copiar";
        window.setTimeout(() => {
          button.textContent = "LinkedIn";
        }, 2000);
      }
    });
  });
</script>

</Layout>
