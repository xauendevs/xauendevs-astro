---
import Layout from "@/layouts/Layout.astro";
import EventSidebar from "@/components/events/EventSidebar.astro";
import EventFacts from "@/components/events/EventFacts.astro";
import { getPivosStrapi } from "@/lib/get-info-pivos";
import { getPivoTags } from "@/lib/get-pivo-tags";
import { getExternalEventsStrapi } from "@/lib/get-info-external-events";
import { slugify } from "@/lib/event-slug";
import { getSeason } from "@/lib/season";
import type { Pivo } from "@/types/Pivo";
import type { ExternalEvent } from "@/types/ExternalEvent";

// SSR: la temporada se decide en cada petición (ver src/lib/site-theme.ts).
export const prerender = false;

const slug = Astro.params.slug;
const pivos = (await getPivosStrapi()) ?? [];
const externalEvents = (await getExternalEventsStrapi()) ?? [];
const foundPivo = pivos.find((item) => slugify(item.title) === slug);
const foundExternal = foundPivo ? undefined : externalEvents.find((item) => slugify(item.title) === slug);

if (!foundPivo && !foundExternal) {
  return Astro.redirect("/eventos");
}

const kind: "pivo" | "external" = foundPivo ? "pivo" : "external";
const event: Pivo | ExternalEvent = foundPivo ? { ...foundPivo, tags: getPivoTags(foundPivo.title) } : foundExternal!;
const festive = !!(await getSeason(Astro));
const STRAPI_HOST = import.meta.env.STRAPI_HOST;
const isExternal = kind === "external";
const pivoEvent = event as Pivo;
const externalEvent = event as ExternalEvent;
const tags = isExternal ? externalEvent.tags : getPivoTags(pivoEvent.title);
const date = event.date;

const formattedDate = date.toLocaleDateString("es-ES", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "Europe/Madrid",
});
// «viernes 23 de octubre · 19:00», para el resumen bajo el título
const shortDate = date.toLocaleDateString("es-ES", { weekday: "long", day: "numeric", month: "long", timeZone: "Europe/Madrid" }).replace(",", "");

const formattedTime = date.toLocaleTimeString("es-ES", {
  hour: "2-digit",
  minute: "2-digit",
  timeZone: "Europe/Madrid",
});

const description =
  event.description ||
  (isExternal
    ? "Evento tecnológico en Jaén."
    : `Charla de XauenDevs: ${event.title}.`);

const title = `${event.title} · XauenDevs`;
const locationQuery = (isExternal ? externalEvent.mapQuery : undefined) || [event.place, "Jaén, España"].filter(Boolean).join(", ");
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(locationQuery)}`;
const mapsEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(locationQuery)}&output=embed`;
const eventImage = isExternal
  ? externalEvent.image
  : pivoEvent.image
    ? `${STRAPI_HOST}${pivoEvent.image}`
    : undefined;

const ogParams = new URLSearchParams({
  title: event.title,
  date: `${formattedDate} · ${formattedTime}`,
  place: event.place || "Jaén",
  organizer: isExternal ? externalEvent.organizer : "XauenDevs",
  description: description,
  label: isExternal ? "EVENTO EXTERNO" : "PIVO&CODE",
});

if (tags.length > 0) {
  ogParams.set("tags", tags.slice(0, 3).join(" · "));
}

const socialImage = `/api/og.png?${ogParams.toString()}`;

const calendarEnd = "endDate" in event && event.endDate
  ? event.endDate
  : new Date(date.getTime() + 60 * 60 * 1000);
const calendarStart = date.toISOString().replace(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z");
const calendarEndValue = calendarEnd.toISOString().replace(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z");
const calendarLocation = encodeURIComponent(event.place || "Jaén, España");
const calendarTitle = encodeURIComponent(event.title);
const calendarDescription = encodeURIComponent(description);
const googleCalendarUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${calendarTitle}&dates=${calendarStart}/${calendarEndValue}&details=${calendarDescription}&location=${calendarLocation}`;
const escapeIcs = (value: string) =>
  value.replace(/\\/g, "\\\\").replace(/;/g, "\\;").replace(/,/g, "\\,").replace(/\r?\n/g, "\\n");
const icsContent = [
  "BEGIN:VCALENDAR",
  "VERSION:2.0",
  "PRODID:-//XauenDevs//Eventos//ES",
  "BEGIN:VEVENT",
  `UID:${slugify(event.title)}@xauendevs.io`,
  `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z")}`,
  `DTSTART:${calendarStart}`,
  `DTEND:${calendarEndValue}`,
  `SUMMARY:${escapeIcs(event.title)}`,
  `DESCRIPTION:${escapeIcs(description)}`,
  `LOCATION:${escapeIcs(event.place || "Jaén, España")}`,
  "END:VEVENT",
  "END:VCALENDAR",
].join("\r\n");
const icsUrl = `data:text/calendar;charset=utf-8,${encodeURIComponent(icsContent)}`;
const eventOrigin = import.meta.env.PROD ? Astro.site : new URL(Astro.url.origin);
const eventUrl = new URL(Astro.url.pathname, eventOrigin).href;
const eventId = slugify(event.title);
const isPast = date.getTime() < Date.now();
const eventDate = date.toLocaleDateString("es-ES", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const eventTime = date.toLocaleTimeString("es-ES", {
  hour: "2-digit",
  minute: "2-digit",
  timeZone: "Europe/Madrid",
});
const shareMessage = [
  "🚨 Ojo con esto…",
  "",
  `¿Te apuntas a *${event.title}*? 👀`,
  "",
  description,
  "",
  `📆 ${eventDate}, ${eventTime}`,
  `📍 ${event.place || "Jaén"}`,
  "",
  "Organizado por:",
  `📣 ${isExternal ? externalEvent.organizer : "XauenDevs"}`,
  "",
  "Más información y apuntes:",
  eventUrl,
].join("\n");
---

<Layout title={title} description={description} image={socialImage} imageType="image/png">
  <main class="flex min-w-0 flex-col gap-6 pb-12 sm:gap-8 sm:pb-16 md:gap-10">
    <a
      href="/eventos"
      class="inline-flex min-h-11 max-w-full items-center gap-2 self-start text-base font-semibold text-black/75 underline decoration-transparent decoration-2 underline-offset-4 transition-colors hover:decoration-accent fest:text-white/80"
    >
      ← Volver a eventos
    </a>

    <article class="min-w-0 overflow-hidden rounded-3xl border border-primary/10 fest:border-white/10 bg-primary/[0.025] fest:bg-white/[0.025] sm:rounded-[2.5rem]">
      {eventImage && (
        <div class="relative aspect-[1200/630] overflow-hidden bg-primary fest:bg-night md:h-[26rem] md:aspect-auto">
          <img
            src={eventImage}
            alt=""
            class="size-full object-cover object-bottom"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary fest:from-night via-primary/35 fest:via-night/35 to-transparent"></div>
          <div class="absolute inset-0 bg-primary/10 fest:bg-night/10"></div>
        </div>
      )}

      <div class="relative isolate min-w-0 overflow-hidden bg-[#0d0d0d] fest:bg-night px-5 py-6 text-white sm:px-7 sm:py-8 md:px-12 md:py-10">
        <div class="pointer-events-none absolute -right-24 -top-32 h-80 w-80 rounded-full bg-accent/25 blur-3xl fest:hidden"></div>
        {festive && <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-cover bg-[position:100%_50%] bg-no-repeat md:bg-[position:50%_70%]" style="background-image:var(--season-overlay)"></div>}

        <div class="relative min-w-0 max-w-5xl">
          <p class="text-base font-semibold text-accent fest:text-season">
            {isExternal ? `Evento externo · organiza ${externalEvent.organizer}` : "Pivo&Code de XauenDevs"}
          </p>

          <h1 class="mt-3 max-w-5xl break-words text-3xl font-black tracking-tight sm:text-4xl md:text-5xl">
            {event.title}
          </h1>

          <p class="mt-5 text-lg text-white/90 md:text-xl">
            <span class="font-semibold first-letter:uppercase inline-block">{shortDate} · {formattedTime}</span>
            {event.place && <span> · {event.place}</span>}
          </p>
          {isPast && !isExternal && <p class="mt-2 text-base text-white/75">Esta charla ya se celebró.</p>}

          <div class="mt-7 flex flex-wrap items-center gap-3">
            {!isExternal && !isPast && (
              <a href="#rsvp" class="inline-flex min-h-12 items-center rounded-full bg-accent px-6 font-bold text-black transition hover:-translate-y-0.5 fest:text-season-ink motion-reduce:transition-none">
                Apuntarme <span aria-hidden="true" class="ml-1.5">↓</span>
              </a>
            )}
            {!isExternal && isPast && pivoEvent.videoId && (
              <a href="#video" class="inline-flex min-h-12 items-center rounded-full bg-accent px-6 font-bold text-black transition hover:-translate-y-0.5 fest:text-season-ink motion-reduce:transition-none">
                Ver el vídeo <span aria-hidden="true" class="ml-1.5">↓</span>
              </a>
            )}
            {isExternal && externalEvent.url && (
              <a href={externalEvent.url} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center rounded-full bg-accent px-6 font-bold text-black transition hover:-translate-y-0.5 fest:text-season-ink motion-reduce:transition-none">
                Web del evento <span aria-hidden="true" class="ml-1.5">↗</span>
              </a>
            )}
            {tags.filter((tag) => tag !== "Charlas").map((tag) => (
              <span class="rounded-full bg-white/10 px-3 py-1 text-sm font-medium text-white/85">{tag}</span>
            ))}
          </div>

        </div>
      </div>

      <!-- En móvil: datos → apuntarse → descripción. En escritorio, la barra lateral ocupa la columna derecha. -->
      <div class="grid min-w-0 grid-cols-1 gap-6 p-4 sm:gap-8 sm:p-6 md:gap-10 md:p-10 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start">
        <div class="min-w-0 lg:col-start-1 lg:row-start-1">
          <EventFacts
            date={formattedDate}
            time={formattedTime}
            duration={!isExternal ? "Dura alrededor de 1 hora" : undefined}
            place={event.place}
            organizer={isExternal ? externalEvent.organizer : undefined}
            mapsUrl={mapsUrl}
          />
        </div>

        <EventSidebar
          class="lg:col-start-2 lg:row-span-2 lg:row-start-1"
          isExternal={isExternal}
          externalUrl={isExternal ? externalEvent.url : undefined}
          saraosLink={!isExternal ? pivoEvent.saraosLink : undefined}
          eventId={eventId}
          isPast={isPast}
          googleCalendarUrl={googleCalendarUrl}
          icsUrl={icsUrl}
          icsFilename={`${slugify(event.title)}.ics`}
          eventPlace={event.place}
          mapsEmbedUrl={mapsEmbedUrl}
          mapsUrl={mapsUrl}
          shareMessage={shareMessage}
          eventTitle={event.title}
          eventDate={eventDate}
          eventTime={eventTime}
          eventUrl={eventUrl}
          calendarUrl={googleCalendarUrl}
          eventStart={calendarStart}
          eventEnd={calendarEndValue}
          videoId={!isExternal ? pivoEvent.videoId : undefined}
        />

        <div class="flex min-w-0 flex-col gap-6 sm:gap-8 lg:col-start-1 lg:row-start-2">

          <section
            class="min-w-0 rounded-3xl border border-primary/10 fest:border-white/10 bg-primary/[0.025] fest:bg-white/[0.025] p-4 sm:rounded-[2rem] sm:p-6 md:p-7"
            aria-labelledby="event-description-title"
          >
            <h2 id="event-description-title" class="text-2xl font-bold">
              Sobre el evento
            </h2>
            <div class="mt-4 max-w-3xl space-y-4 break-words text-base leading-relaxed text-black/80 fest:text-white/80 md:text-lg">
              {
                description
                  .split(/\n\s*\n/)
                  .map((paragraph) => paragraph.trim())
                  .filter(Boolean)
                  .map((paragraph) => <p class="whitespace-pre-line">{paragraph}</p>)
              }
            </div>
          </section>

          {
            !isExternal && pivoEvent.speakers && pivoEvent.speakers.length > 0 && (
              <section aria-labelledby="event-speakers-title">
                <h2 id="event-speakers-title" class="text-2xl font-bold">
                  {pivoEvent.speakers.length > 1 ? "Ponentes" : "Ponente"}
                </h2>
                <div class="mt-4 flex flex-wrap gap-4">
                  {pivoEvent.speakers?.map((speaker) => (
                    <div class="flex min-w-0 max-w-full items-center gap-3 rounded-2xl border border-primary/10 fest:border-white/10 px-3 py-3 sm:px-4">
                      <img
                        src={`${import.meta.env.STRAPI_HOST}${speaker.photo}`}
                        alt={speaker.name}
                        class="size-10 shrink-0 rounded-full object-cover"
                      />
                      <span class="min-w-0 break-words font-semibold">{speaker.name}</span>
                    </div>
                  ))}
                </div>
              </section>
            )
          }
        </div>

      </div>
    </article>

    {
      !isExternal && pivoEvent.videoId && (
        <section id="video" class="min-w-0 overflow-hidden rounded-3xl bg-primary fest:bg-night fest:ring-1 fest:ring-season/30 p-3 sm:rounded-[2.5rem] sm:p-4 md:p-6">
          <div class="mb-5 px-2">
            <h2 class="text-2xl font-bold text-white">
              Revive la charla
            </h2>
          </div>
          <div class="aspect-video overflow-hidden rounded-2xl">
            <iframe
              class="size-full"
              src={`https://www.youtube.com/embed/${pivoEvent.videoId}`}
              title={event.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        </section>
      )
    }
  </main>
<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-share-message]").forEach((button) => {
    button.addEventListener("click", async () => {
      const message = button.dataset.copyShareMessage;
      if (!message) return;

      try {
        await navigator.clipboard.writeText(message);
        const originalText = button.textContent;
        button.textContent = "Mensaje copiado ✓";
        window.setTimeout(() => {
          button.textContent = originalText;
        }, 2000);
      } catch {
        button.textContent = "No se pudo copiar";
        window.setTimeout(() => {
          button.textContent = "Copiar mensaje";
        }, 2000);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-linkedin-share]").forEach((button) => {
    button.addEventListener("click", async () => {
      const message = button.dataset.linkedinShare;
      if (!message) return;

      window.open(
        "https://www.linkedin.com/sharing/share-offsite/?url=" + encodeURIComponent(window.location.href),
        "_blank",
        "noopener,noreferrer",
      );

      try {
        await navigator.clipboard.writeText(message);
        const originalText = button.textContent;
        button.textContent = "Texto copiado ✓";
        window.setTimeout(() => {
          button.textContent = originalText;
        }, 2000);
      } catch {
        button.textContent = "No se pudo copiar";
        window.setTimeout(() => {
          button.textContent = "LinkedIn";
        }, 2000);
      }
    });
  });
</script>

</Layout>
