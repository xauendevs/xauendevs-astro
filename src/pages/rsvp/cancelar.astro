---
import Layout from "@/layouts/Layout.astro";

// Se llega desde el email de inscripción. Usa el Layout de la web (menú, pie y temporada) y no se indexa.
export const prerender = false;
---

<Layout title="Cancelar asistencia · XauenDevs" description="Gestiona tu inscripción a una Pivo&Code de XauenDevs." private>
  <main class="mx-auto flex max-w-2xl flex-col py-6 sm:py-10">
    <section class="overflow-hidden rounded-3xl bg-black/[0.04] fest:bg-white/[0.05] fest:ring-1 fest:ring-season/40">
      <div class="h-2 bg-black fest:bg-season"></div>

      <div class="p-6 sm:p-10">
        <p class="text-base font-semibold">Pivo&Code</p>
        <h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl" data-title tabindex="-1" style="outline:none">Tu inscripción</h1>
        <p class="mt-3 text-lg leading-relaxed text-black/80 fest:text-white/80" data-message role="status">
          Comprobando tu inscripción…
        </p>

        <div class="mt-7 hidden" data-confirm>
          <dl class="grid gap-4 rounded-2xl bg-white p-5 text-black sm:p-6 fest:bg-white/[0.06] fest:text-white">
            <div>
              <dt class="text-sm font-medium text-black/70 fest:text-white/70">Evento</dt>
              <dd class="mt-1 text-xl font-bold" data-event></dd>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <dt class="text-sm font-medium text-black/70 fest:text-white/70">A nombre de</dt>
                <dd class="mt-1 font-semibold" data-name></dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-black/70 fest:text-white/70">Cuándo y dónde</dt>
                <dd class="mt-1 font-semibold" data-when></dd>
              </div>
            </div>
          </dl>

          <p class="mt-6 text-base text-black/80 fest:text-white/80">
            Si cancelas, tu plaza queda libre para otra persona. Podrás volver a apuntarte mientras queden plazas.
          </p>

          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <button
              type="button"
              class="inline-flex min-h-12 items-center justify-center rounded-full bg-black px-6 font-bold text-white transition hover:-translate-y-0.5 disabled:cursor-wait disabled:opacity-60 fest:bg-season fest:text-season-ink"
              data-cancel
            >
              Sí, cancelar mi asistencia
            </button>
            <a
              href="/eventos"
              class="inline-flex min-h-12 items-center justify-center rounded-full border-2 border-black px-6 font-bold transition hover:bg-black hover:text-white fest:border-white fest:hover:bg-white fest:hover:text-black"
              data-keep
            >
              No, mantener mi plaza
            </a>
          </div>
        </div>

        <div class="mt-7 hidden flex-wrap gap-3" data-after>
          <a
            href="/eventos"
            class="inline-flex min-h-12 items-center rounded-full bg-black px-6 font-bold text-white transition hover:-translate-y-0.5 fest:bg-season fest:text-season-ink"
            data-after-link
          >
            Ver la agenda
          </a>
        </div>
      </div>
    </section>
  </main>

  <script>
    const slugify = (value: string) =>
      value
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "")
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/(^-|-$)/g, "");

    const init = () => {
      const title = document.querySelector<HTMLElement>("[data-title]");
      const message = document.querySelector<HTMLElement>("[data-message]");
      const confirm = document.querySelector<HTMLElement>("[data-confirm]");
      const cancel = document.querySelector<HTMLButtonElement>("[data-cancel]");
      const keep = document.querySelector<HTMLAnchorElement>("[data-keep]");
      const after = document.querySelector<HTMLElement>("[data-after]");
      const afterLink = document.querySelector<HTMLAnchorElement>("[data-after-link]");
      if (!title || !message || !confirm || !cancel || !keep || !after || !afterLink || title.dataset.ready) return;
      title.dataset.ready = "1";

      const field = (key: string) => document.querySelector<HTMLElement>(`[data-${key}]`)!;
      const code = new URLSearchParams(location.search).get("rsvpid")?.trim().toUpperCase();

      const fail = (error: unknown, fallback: string) => {
        message.textContent = error instanceof Error ? error.message : fallback;
        after.classList.remove("hidden");
        after.classList.add("flex");
      };

      if (!code) {
        fail(new Error("Falta el código de inscripción. Usa el enlace del email que te enviamos."), "");
        return;
      }

      fetch("/api/rsvp?rsvpid=" + encodeURIComponent(code))
        .then(async (response) => {
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || "No se pudo consultar la inscripción.");

          field("event").textContent = data.eventTitle;
          field("name").textContent = data.name;
          field("when").textContent = [`${data.eventDate} · ${data.eventTime}`, data.eventPlace].filter(Boolean).join(" · ");
          if (data.eventTitle) {
            const href = `/eventos/${slugify(data.eventTitle)}`;
            keep.href = href;
            afterLink.href = href;
            afterLink.textContent = "Volver al evento";
          }
          message.textContent = "Hemos encontrado tu inscripción. ¿Quieres cancelarla?";
          confirm.classList.remove("hidden");
        })
        .catch((error) => fail(error, "No se pudo consultar la inscripción."));

      cancel.addEventListener("click", async () => {
        cancel.disabled = true;
        cancel.textContent = "Cancelando…";

        try {
          const response = await fetch("/api/rsvp", {
            method: "DELETE",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ rsvpid: code }),
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || "No se pudo cancelar la inscripción.");

          confirm.classList.add("hidden");
          title.textContent = "Asistencia cancelada";
          message.textContent = "Tu plaza ha quedado libre. Si cambias de idea, puedes volver a apuntarte desde la ficha del evento.";
          after.classList.remove("hidden");
          after.classList.add("flex");
          title.focus();
        } catch (error) {
          message.textContent = error instanceof Error ? error.message : "No se pudo cancelar la inscripción.";
          cancel.disabled = false;
          cancel.textContent = "Sí, cancelar mi asistencia";
        }
      });
    };

    init();
    document.addEventListener("astro:page-load", init);
  </script>
</Layout>
