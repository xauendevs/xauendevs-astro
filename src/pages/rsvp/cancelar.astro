---
---
<main class="min-h-screen bg-[#f3f1eb] px-4 py-16 text-black">
  <section class="mx-auto max-w-xl rounded-3xl border border-black/10 bg-white p-8 shadow-sm">
    <p class="text-xs font-black uppercase tracking-[0.14em]">XauenDevs · Pivo&Code</p>
    <h1 class="mt-4 text-3xl font-black">Gestionar inscripción</h1>
    <p class="mt-3 text-sm leading-relaxed text-black/60" data-message>Comprobando tu inscripción…</p>

    <div class="mt-6 hidden rounded-2xl bg-black/5 p-5" data-confirm>
      <p class="font-bold" data-name></p>
      <p class="mt-1 text-sm text-black/60" data-event></p>
      <button type="button" class="mt-5 rounded-full bg-black px-5 py-3 text-sm font-bold text-white disabled:cursor-wait disabled:opacity-60" data-cancel>
        Cancelar mi asistencia
      </button>
    </div>

    <a href="/" class="mt-6 inline-block text-sm font-bold underline underline-offset-4">Volver a XauenDevs</a>
  </section>
</main>

<script>
  const params = new URLSearchParams(location.search);
  const code = params.get("rsvpid")?.trim().toUpperCase();
  const message = document.querySelector<HTMLElement>("[data-message]");
  const confirm = document.querySelector<HTMLElement>("[data-confirm]");
  const name = document.querySelector<HTMLElement>("[data-name]");
  const event = document.querySelector<HTMLElement>("[data-event]");
  const cancel = document.querySelector<HTMLButtonElement>("[data-cancel]");

  if (!code) {
    message.textContent = "Falta el código de inscripción.";
  } else {
    fetch("/api/rsvp?rsvpid=" + encodeURIComponent(code))
      .then(async (response) => {
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "No se pudo consultar la inscripción.");
        name.textContent = data.name;
        event.textContent = "Inscripción: " + data.eventId;
        confirm.classList.remove("hidden");
        message.textContent = "Hemos encontrado tu inscripción. Comprueba los datos antes de cancelarla.";
      })
      .catch((error) => {
        message.textContent = error instanceof Error ? error.message : "No se pudo consultar la inscripción.";
      });
  }

  cancel?.addEventListener("click", async () => {
    cancel.setAttribute("disabled", "true");
    try {
      const response = await fetch("/api/rsvp", {
        method: "DELETE",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ rsvpid: code }),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || "No se pudo cancelar la inscripción.");
      confirm.classList.add("hidden");
      message.textContent = "Tu asistencia ha sido cancelada correctamente.";
    } catch (error) {
      message.textContent = error instanceof Error ? error.message : "No se pudo cancelar la inscripción.";
      cancel.removeAttribute("disabled");
    }
  });
</script>
