---
import Layout from "@/layouts/Layout.astro";

// Se llega desde el email de inscripción. Usa el Layout de la web (menú, pie y temporada) y no se indexa.
export const prerender = false;
---

<Layout title="Confirmar asistencia · XauenDevs" description="Confirma tu asistencia a una Pivo&Code de XauenDevs." private>
  <main class="mx-auto flex max-w-4xl flex-col py-6 sm:py-10">
    <section class="overflow-hidden rounded-3xl bg-black/[0.04] fest:bg-white/[0.05] fest:ring-1 fest:ring-season/40">
      <div class="h-2 bg-accent fest:bg-season"></div>

      <div class="p-6 sm:p-10">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_220px] lg:items-center">
          <div>
            <p class="text-base font-semibold" data-kicker>Pivo&Code</p>
            <h1 class="mt-2 max-w-xl text-4xl font-black leading-tight tracking-tight sm:text-5xl" data-title tabindex="-1" style="outline:none">
              Confirmando tu asistencia…
            </h1>
            <p class="mt-4 max-w-xl text-lg leading-relaxed text-black/80 fest:text-white/80" data-message role="status">
              Un momento, estamos confirmando tu plaza.
            </p>
            <div class="mt-7 flex flex-wrap gap-3" data-actions></div>
          </div>

          <!-- Dos jarras de cerveza: la «pivo» de Pivo&Code -->
          <div class="relative hidden h-48 lg:block" aria-hidden="true">
            <div class="absolute left-6 top-14 h-28 w-16 -rotate-12 rounded-b-[1.7rem] rounded-t-md border-[5px] border-black bg-accent fest:border-white/90 fest:bg-season"></div>
            <div class="absolute left-14 top-5 h-8 w-16 -rotate-12 rounded-full border-[5px] border-black bg-white fest:border-white/90"></div>
            <div class="absolute right-6 top-14 h-28 w-16 rotate-12 rounded-b-[1.7rem] rounded-t-md border-[5px] border-black bg-accent fest:border-white/90 fest:bg-season"></div>
            <div class="absolute right-14 top-5 h-8 w-16 rotate-12 rounded-full border-[5px] border-black bg-white fest:border-white/90"></div>
          </div>
        </div>

        <dl class="mt-8 hidden gap-4 rounded-2xl bg-white p-5 text-black sm:grid-cols-3 sm:p-6 fest:bg-white/[0.06] fest:text-white" data-card>
          <div class="sm:col-span-3">
            <dt class="text-sm font-medium text-black/70 fest:text-white/70">Evento</dt>
            <dd class="mt-1 text-xl font-bold" data-event></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-black/70 fest:text-white/70">A nombre de</dt>
            <dd class="mt-1 font-semibold" data-name></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-black/70 fest:text-white/70">Cuándo</dt>
            <dd class="mt-1 font-semibold"><span data-date></span> · <span data-time></span></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-black/70 fest:text-white/70">Dónde</dt>
            <dd class="mt-1 font-semibold" data-place></dd>
          </div>
        </dl>

        <p class="mt-6 hidden text-base text-black/80 fest:text-white/80" data-cancel-hint>
          ¿Al final no puedes venir? En el mismo email tienes un enlace para cancelar y liberar tu plaza.
        </p>
      </div>
    </section>
  </main>

  <script>
    const slugify = (value: string) =>
      value
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "")
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/(^-|-$)/g, "");

    const init = () => {
      const title = document.querySelector<HTMLElement>("[data-title]");
      const message = document.querySelector<HTMLElement>("[data-message]");
      const card = document.querySelector<HTMLElement>("[data-card]");
      const actions = document.querySelector<HTMLElement>("[data-actions]");
      const hint = document.querySelector<HTMLElement>("[data-cancel-hint]");
      if (!title || !message || !card || !actions || !hint || title.dataset.ready) return;
      title.dataset.ready = "1";

      const field = (key: string) => document.querySelector<HTMLElement>(`[data-${key}]`);
      const button = (href: string, text: string, primary: boolean, external = false) => {
        const link = document.createElement("a");
        link.href = href;
        link.textContent = text;
        if (external) {
          link.target = "_blank";
          link.rel = "noopener noreferrer";
        }
        link.className = primary
          ? "inline-flex min-h-12 items-center rounded-full bg-black px-6 font-bold text-white transition hover:-translate-y-0.5 fest:bg-season fest:text-season-ink"
          : "inline-flex min-h-12 items-center rounded-full border-2 border-black px-6 font-bold transition hover:bg-black hover:text-white fest:border-white fest:hover:bg-white fest:hover:text-black";
        actions.appendChild(link);
      };

      const showError = (error: unknown) => {
        title.textContent = "No hemos podido confirmar tu plaza";
        message.textContent =
          (error instanceof Error ? error.message : "No se pudo confirmar la inscripción.") +
          " Si el enlace no funciona, vuelve a apuntarte desde la ficha del evento.";
        card.classList.add("hidden");
        button("/eventos", "Ver la agenda", true);
        title.focus();
      };

      const code = new URLSearchParams(location.search).get("rsvpid")?.trim().toUpperCase();
      if (!code) {
        showError(new Error("Falta el código de confirmación."));
        return;
      }

      fetch("/api/rsvp/confirmar?rsvpid=" + encodeURIComponent(code))
        .then(async (response) => {
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || "No se pudo confirmar la inscripción.");

          title.textContent = data.alreadyConfirmed ? "Tu plaza ya estaba confirmada" : "¡Plaza confirmada!";
          message.textContent = `Genial, ${data.name}. Nos vemos en la Pivo&Code.`;
          field("event")!.textContent = data.eventTitle;
          field("name")!.textContent = data.name;
          field("date")!.textContent = data.eventDate;
          field("time")!.textContent = data.eventTime;
          field("place")!.textContent = data.eventPlace;
          card.classList.remove("hidden");
          card.classList.add("grid");
          hint.classList.remove("hidden");

          if (data.calendarUrl) button(data.calendarUrl, "Añadir al calendario", true, true);
          if (data.eventTitle) button(`/eventos/${slugify(data.eventTitle)}`, "Ver el evento", false);
          title.focus();
        })
        .catch(showError);
    };

    init();
    document.addEventListener("astro:page-load", init);
  </script>
</Layout>
