---
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>Asistencia confirmada · XauenDevs</title>
  </head>
  <body class="m-0">
    <main class="min-h-screen bg-[#f3f1eb] px-4 py-8 text-black sm:px-6 sm:py-12">
      <div class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-4xl items-center justify-center sm:min-h-[calc(100vh-6rem)]">
        <section class="w-full overflow-hidden rounded-[2.5rem] border border-black/10 bg-white shadow-[0_24px_80px_rgba(0,0,0,0.09)]">
          <div class="h-2 bg-[#f4d400]"></div>

          <div class="p-7 sm:p-10 lg:p-12">
            <div class="flex items-center justify-between gap-4">
              <p class="text-[11px] font-black uppercase tracking-[0.2em] text-black/45">XauenDevs · Pivo&Code</p>
              <span class="rounded-full bg-black/5 px-3.5 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-black/45">RSVP</span>
            </div>

            <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_260px] lg:items-center">
              <div>
                <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#f4d400] text-2xl font-black shadow-[4px_4px_0_#000]" aria-hidden="true">
                  ✓
                </div>

                <h1 class="max-w-xl text-4xl font-black leading-[0.98] tracking-[-0.035em] sm:text-5xl">
                  <span data-title>Confirmando tu asistencia…</span>
                </h1>

                <p class="mt-5 max-w-xl text-base leading-7 text-black/60" data-message>
                  Un momento, estamos confirmando tu plaza.
                </p>

                <div class="mt-7 flex flex-wrap gap-3" data-actions></div>
              </div>

              <div class="relative hidden h-56 lg:block" aria-hidden="true">
                <div class="absolute inset-8 rounded-full bg-[#f4d400]/20 blur-2xl"></div>
                <div class="absolute left-8 top-16 h-28 w-16 -rotate-12 rounded-b-[1.7rem] rounded-t-md border-[5px] border-black bg-[#f4d400] shadow-[5px_5px_0_#000]"></div>
                <div class="absolute left-16 top-7 h-8 w-16 -rotate-12 rounded-full border-[5px] border-black bg-white"></div>
                <div class="absolute right-8 top-16 h-28 w-16 rotate-12 rounded-b-[1.7rem] rounded-t-md border-[5px] border-black bg-[#f4d400] shadow-[5px_5px_0_#000]"></div>
                <div class="absolute right-16 top-7 h-8 w-16 rotate-12 rounded-full border-[5px] border-black bg-white"></div>
                <span class="absolute left-1/2 top-4 text-3xl font-black">✦</span>
                <span class="absolute left-5 top-28 text-xl font-black text-[#f4d400]">✦</span>
                <span class="absolute right-2 bottom-9 text-2xl font-black text-[#f4d400]">✦</span>
              </div>
            </div>

            <div class="mt-10 hidden overflow-hidden rounded-3xl border border-black/10 bg-[#f7f6f2]" data-card>
              <div class="p-6 sm:p-7">
                <p class="text-[10px] font-black uppercase tracking-[0.16em] text-black/40">Tu inscripción</p>
                <p class="mt-2 text-xl font-black" data-name></p>
                <p class="mt-1 text-sm font-bold text-black/45" data-event></p>

                <div class="mt-6 grid gap-3 border-t border-black/10 pt-5 sm:grid-cols-3">
                  <div>
                    <p class="text-[10px] font-black uppercase tracking-wider text-black/35">Cuándo</p>
                    <p class="mt-1 text-sm font-semibold" data-date></p>
                    <p class="text-sm text-black/55" data-time></p>
                  </div>
                  <div>
                    <p class="text-[10px] font-black uppercase tracking-wider text-black/35">Dónde</p>
                    <p class="mt-1 text-sm font-semibold" data-place></p>
                  </div>
                </div>
              </div>
            </div>

            <a href="/" class="mt-8 inline-flex items-center gap-2 text-sm font-bold underline decoration-black/25 underline-offset-4 transition hover:decoration-black">
              <span aria-hidden="true">←</span> Volver a XauenDevs
            </a>
          </div>
        </section>
      </div>
    </main>

    <script>
      const params = new URLSearchParams(location.search);
      const code = params.get("rsvpid")?.trim().toUpperCase();
      const title = document.querySelector<HTMLElement>("[data-title]");
      const message = document.querySelector<HTMLElement>("[data-message]");
      const card = document.querySelector<HTMLElement>("[data-card]");
      const name = document.querySelector<HTMLElement>("[data-name]");
      const event = document.querySelector<HTMLElement>("[data-event]");
      const date = document.querySelector<HTMLElement>("[data-date]");
      const time = document.querySelector<HTMLElement>("[data-time]");
      const place = document.querySelector<HTMLElement>("[data-place]");
      const actions = document.querySelector<HTMLElement>("[data-actions]");

      if (!title || !message || !card || !name || !event || !date || !time || !place || !actions) {
        throw new Error("No se pudo inicializar la página de confirmación.");
      }

      const showError = (error: unknown) => {
        title.textContent = "No hemos podido confirmar";
        message.textContent = error instanceof Error ? error.message : "No se pudo confirmar la inscripción.";
        card.classList.add("hidden");
      };

      if (!code) {
        showError(new Error("Falta el código de confirmación."));
      } else {
        fetch("/api/rsvp/confirmar?rsvpid=" + encodeURIComponent(code))
          .then(async (response) => {
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || "No se pudo confirmar la inscripción.");

            title.textContent = "¡Asistencia confirmada!";
            message.innerHTML = "Genial, <strong>" + data.name + "</strong>. Tu plaza está confirmada. ¡Nos vemos en Pivo&Code!";
            name.textContent = data.name;
            event.textContent = data.eventTitle;
            date.textContent = data.eventDate;
            time.textContent = data.eventTime;
            place.textContent = data.eventPlace;
            card.classList.remove("hidden");

            if (data.calendarUrl) {
              const link = document.createElement("a");
              link.href = data.calendarUrl;
              link.target = "_blank";
              link.rel = "noopener noreferrer";
              link.textContent = "Añadir al calendario →";
              link.className = "inline-flex rounded-full bg-[#f4d400] px-6 py-3.5 text-sm font-black text-black shadow-[4px_4px_0_#000] transition hover:-translate-y-0.5";
              actions.appendChild(link);
            }
          })
          .catch(showError);
      }
    </script>
  </body>
</html>
