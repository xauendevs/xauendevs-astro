---
import Layout from "@/layouts/Layout.astro";
import SeasonFlyer from "@/components/season/SeasonFlyer.astro";
import { getSeason, SEASON_CONTENT } from "@/lib/season";

// SSR: el texto cambia con la temporada (ver src/lib/site-theme.ts).
export const prerender = false;

const season = await getSeason(Astro);
const message = season ? SEASON_CONTENT[season].notFound : "Esta página no existe o se ha movido.";
---

<Layout title="Página no encontrada · XauenDevs" description="La página que buscas no existe.">
  <main class="py-6 sm:py-10">
    <section
      class="relative isolate overflow-hidden rounded-3xl bg-black px-7 py-14 text-white fest:bg-night fest:ring-1 fest:ring-season/40 md:px-12 md:py-20"
      aria-labelledby="not-found-title"
    >
      {
        season && (
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 -z-10 bg-cover bg-[position:100%_50%] bg-no-repeat opacity-70 md:bg-[position:50%_70%]"
            style="background-image:var(--season-overlay)"
          />
        )
      }
      <SeasonFlyer class="bat-float pointer-events-none absolute right-10 top-10 hidden h-10 w-20 text-white/60 sm:block" />

      <p class="text-lg font-semibold text-accent fest:text-season">Error 404</p>
      <h1 id="not-found-title" class="mt-3 max-w-2xl text-4xl font-black tracking-tight md:text-6xl">
        {message}
      </h1>
      <p class="mt-5 max-w-xl text-lg text-white/85">
        Puede que el enlace esté mal escrito o que el evento ya no exista. Desde aquí puedes volver a lo importante.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/proxima-pivo"
          data-astro-reload
          class="inline-flex min-h-12 items-center rounded-full bg-accent px-6 font-bold text-black transition hover:-translate-y-0.5 fest:text-season-ink motion-reduce:transition-none"
        >
          Ver la próxima Pivo <span aria-hidden="true" class="ml-1.5">→</span>
        </a>
        <a
          href="/"
          class="inline-flex min-h-12 items-center rounded-full border border-white/40 px-6 font-bold transition hover:-translate-y-0.5 hover:border-white hover:bg-white/10 motion-reduce:transition-none"
        >
          Ir al inicio
        </a>
      </div>
    </section>
  </main>
</Layout>
