---
import Header from "@/sections/Header.astro";
import Layout from "@/layouts/Layout.astro";
import AboutUs from "@/sections/AboutUs.astro";
import Partners from "@/sections/Partners.astro";
import Pivos from "@/sections/Pivos.astro";
import Community from "@/sections/Community.astro";
import RealCommunity from "@/sections/RealCommunity.astro";
import { isHalloweenSeason } from "@/lib/season";

// Sin prerender: la temporada se decide en cada petición (ver src/lib/site-theme.ts).
export const prerender = false;
const halloween = await isHalloweenSeason(Astro);
---

<Layout
  title="XauenDevs 🫒 Desarrollo en Jaén"
  description="Comunidad de desarrollo y tecnología de la provincia de Jaén. ¡Únete!"
>
  <main class="flex flex-col gap-8">
    <Header />
    <AboutUs />
    {halloween && <RealCommunity />}
    <Pivos />
    <Community />
    <Partners />
  </main>
</Layout>

<style></style>
