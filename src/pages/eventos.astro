---
import Layout from "@/layouts/Layout.astro";
import PivoCard from "@/components/PivoCard.astro";
import { getPivosStrapi } from "@/lib/get-info-pivos";
import type { Pivo } from "@/types/Pivo";

export const prerender = true;

const events = (await getPivosStrapi()) ?? [];
const now = new Date();

const upcomingEvents = events
  .filter((event) => event.date >= now)
  .sort((a, b) => a.date.getTime() - b.date.getTime());

const pastEvents = events
  .filter((event) => event.date < now)
  .sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Layout
  title="Eventos tech en Jaén · XauenDevs"
  description="Agenda de eventos de tecnología y desarrollo en Jaén. Charlas, meetups y actividades de la comunidad."
>
  <main class="flex flex-col gap-12">
    <header class="flex flex-col gap-4">
      <span class="text-accent font-semibold text-lg">JAÉN TECH EVENTS</span>
      <h1 class="text-4xl md:text-6xl font-bold">Tecnología en Jaén</h1>
      <p class="text-xl max-w-3xl">
        Una agenda para descubrir qué está pasando en la comunidad tecnológica
        de Jaén.
      </p>
    </header>

    {
      upcomingEvents.length > 0 && (
        <section class="flex flex-col gap-6">
          <h2 class="text-3xl font-semibold">Próximos eventos</h2>
          <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 md:grid-cols-2">
            {upcomingEvents.map(
              ({ id, title, image, speakers, place, date, videoId }: Pivo) => (
                <PivoCard
                  id={id}
                  title={title}
                  image={image}
                  speakers={speakers}
                  place={place}
                  date={date}
                  videoId={videoId}
                  customClass="justify-self-center !max-w-none !w-full !min-w-fit"
                />
              )
            )}
          </div>
        </section>
      )
    }

    {
      pastEvents.length > 0 && (
        <section class="flex flex-col gap-6">
          <h2 class="text-3xl font-semibold">Eventos anteriores</h2>
          <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 md:grid-cols-2">
            {pastEvents.map(
              ({ id, title, image, speakers, place, date, videoId }: Pivo) => (
                <PivoCard
                  id={id}
                  title={title}
                  image={image}
                  speakers={speakers}
                  place={place}
                  date={date}
                  videoId={videoId}
                  customClass="justify-self-center !max-w-none !w-full !min-w-fit"
                />
              )
            )}
          </div>
        </section>
      )
    }
  </main>
</Layout>
