---
import Layout from "@/layouts/Layout.astro";
import PivoCard from "@/components/PivoCard.astro";
import ExternalEventCard from "@/components/ExternalEventCard.astro";
import { getPivosStrapi } from "@/lib/get-info-pivos";
import { getPivoTags } from "@/lib/get-pivo-tags";
import { slugify } from "@/lib/event-slug";
import { externalEvents } from "@/data/external-events";
import type { Pivo } from "@/types/Pivo";

export const prerender = true;

const events = (await getPivosStrapi()) ?? [];
const now = new Date();

const upcomingEvents = events
  .filter((event) => event.date >= now)
  .sort((a, b) => a.date.getTime() - b.date.getTime())
  .map((event) => ({ ...event, tags: getPivoTags(event.title) }));

const pastEvents = events
  .filter((event) => event.date < now)
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .map((event) => ({ ...event, tags: getPivoTags(event.title) }));

const upcomingExternalEvents = externalEvents
  .filter((event) => event.date >= now)
  .sort((a, b) => a.date.getTime() - b.date.getTime());

const totalUpcoming = upcomingEvents.length + upcomingExternalEvents.length;

const availableTags = Array.from(
  new Set([
    "Charlas",
    ...upcomingEvents.flatMap((event) => event.tags),
    ...pastEvents.flatMap((event) => event.tags),
    ...externalEvents.flatMap((event) => event.tags),
  ]),
);


---

<Layout
  title="Eventos tech en Jaén · XauenDevs"
  description="Agenda de eventos de tecnología y desarrollo en Jaén. Charlas, meetups y actividades de la comunidad."
>
  <div class="flex flex-col gap-14">
    <header class="relative overflow-hidden rounded-[2.5rem] border border-primary/10 bg-primary/[0.025] px-7 py-10 md:px-12 md:py-14">
      <div class="pointer-events-none absolute -right-20 -top-28 h-72 w-72 rounded-full bg-accent/20 blur-3xl"></div>

      <div class="relative flex flex-col gap-5">
        <div class="flex flex-wrap items-center gap-3">
          <span class="text-accent-text text-sm font-bold uppercase tracking-[0.16em]">
            JAÉN TECH EVENTS
          </span>
          {totalUpcoming > 0 && (
            <span class="rounded-full bg-accent px-3 py-1 text-xs font-bold">
              {totalUpcoming} próximos
            </span>
          )}
        </div>

        <h1 class="max-w-4xl text-4xl font-black tracking-tight md:text-6xl">
          Tecnología en Jaén.
          <span class="text-primary/35">Todo en un mismo sitio.</span>
        </h1>

        <p class="max-w-2xl text-lg leading-relaxed text-primary/65 md:text-xl">
          Charlas, meetups, talleres y eventos para descubrir qué está pasando
          en la comunidad tecnológica de Jaén.
        </p>
      </div>
    </header>

    <nav aria-label="Filtrar eventos" class="flex flex-col gap-5">
      <div class="flex flex-col gap-2">
        <span class="text-primary/40 text-xs font-bold uppercase tracking-[0.16em]">Tipo</span>
        <div class="flex flex-wrap items-center gap-2">
          <button type="button" data-type-filter="xauen" aria-pressed="false" class="filter-chip">XauenDevs</button>
          <button type="button" data-type-filter="external" aria-pressed="false" class="filter-chip">Eventos externos</button>
        </div>
      </div>
      <div class="flex flex-col gap-2">
        <span class="text-primary/40 text-xs font-bold uppercase tracking-[0.16em]">Tema</span>
        <div class="flex flex-wrap items-center gap-2">
          {availableTags.map((tag) => (
            <button type="button" data-tag-filter={tag} aria-pressed="false" class="filter-chip">{tag}</button>
          ))}
        </div>
        <p class="text-xs text-primary/45">Mostrar eventos de cualquiera de los temas seleccionados.</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" data-clear-filters class="hidden rounded-full px-3 py-2 text-xs font-semibold text-primary/45 underline underline-offset-4 hover:text-primary">Quitar filtros</button>
        <p data-filter-status class="text-xs font-semibold text-primary/45" role="status" aria-live="polite"><span data-filter-result>0 próximos</span></p>
      </div>
      <div data-filter-empty class="hidden rounded-2xl border border-primary/10 bg-primary/[0.025] p-5">
        <p class="font-semibold">No hay eventos que coincidan con estos filtros.</p>
        <button type="button" data-clear-filters-empty class="mt-2 font-semibold text-primary underline decoration-accent decoration-2 underline-offset-4">Quitar filtros</button>
      </div>
      <style>
        .filter-chip { border-radius:9999px; border:1px solid rgb(0 0 0 / .1); background:rgb(0 0 0 / .03); padding:.5rem 1rem; font-size:.875rem; font-weight:600; color:rgb(0 0 0 / .65); transition:border-color 150ms,background-color 150ms,color 150ms; }
        .filter-chip:hover { border-color:rgb(246 183 3 / .5); background:rgb(246 183 3 / .2); color:#000; }
        .filter-chip[aria-pressed="true"] { border-color:rgb(246 183 3); background:rgb(246 183 3); color:#000; }
      </style>
    </nav>
    {
      upcomingEvents.length > 0 && (
        <section data-event-section class="flex flex-col gap-7">
          <div class="flex flex-col gap-1">
            <span class="text-accent-text text-xs font-bold uppercase tracking-[0.16em]">
              XauenDevs
            </span>
            <h2 class="text-3xl font-bold tracking-tight">Próximamente</h2>
          </div>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
            {upcomingEvents.map(
              ({ id, title, image, speakers, place, date, videoId, tags }: Pivo) => (
                <div data-event-tags={(tags ?? []).join(",")} data-event-type="xauen" data-upcoming="true" data-event-organizer="XauenDevs">
                <PivoCard
                  id={id}
                  title={title}
                  image={image}
                  speakers={speakers}
                  place={place}
                  date={date}
                  videoId={videoId}
                  tags={tags}
                  detailUrl={`/eventos/${slugify(title)}`}
                  customClass="justify-self-center !max-w-none !w-full !min-w-fit"
                />
                </div>
              )
            )}
          </div>
        </section>
      )
    }

    {
      upcomingExternalEvents.length > 0 && (
        <section data-event-section class="flex flex-col gap-7">
          <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
            <div class="flex flex-col gap-1">
              <span class="text-accent-text text-xs font-bold uppercase tracking-[0.16em]">
                Comunidad tech
              </span>
              <h2 class="text-3xl font-bold tracking-tight">
                También está pasando
              </h2>
            </div>
            <p class="max-w-md text-sm leading-relaxed text-primary/55 md:text-right">
              Eventos de otras comunidades, empresas y organizaciones que
              pueden interesarte.
            </p>
          </div>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
            {upcomingExternalEvents.map((event) => (
              <div data-event-tags={event.tags.join(",")} data-event-type="external" data-upcoming="true" data-event-organizer={event.organizer}>
                <ExternalEventCard event={event} />
              </div>
            ))}
          </div>
        </section>
      )
    }

    <section class="relative overflow-hidden rounded-[2rem] bg-accent px-7 py-8 md:flex md:items-center md:justify-between md:gap-10 md:px-10">
      <div class="pointer-events-none absolute -right-10 -top-20 h-48 w-48 rounded-full bg-white/30 blur-3xl"></div>
      <div class="relative">
        <span class="text-xs font-bold uppercase tracking-[0.16em]">
          ¿Conoces algún evento?
        </span>
        <h2 class="mt-2 text-2xl font-black md:text-3xl">
          Ayúdanos a mantener la agenda al día.
        </h2>
        <p class="mt-2 max-w-2xl text-sm text-primary/65">
          Si conoces un evento relacionado con tecnología en Jaén, compártelo
          con la comunidad y lo revisamos.
        </p>
      </div>
      <a
        href="/proponer-evento"
        class="relative mt-6 inline-flex shrink-0 rounded-full !bg-black px-6 py-3 font-bold !text-white shadow-none transition-transform duration-200 hover:!bg-black hover:!text-white hover:-translate-y-0.5 hover:shadow-none md:mt-0"
      >
        Compartir evento →
      </a>
    </section>

    {
      pastEvents.length > 0 && (
        <section data-event-section class="border-t border-primary/10 pt-12">
          <div class="mb-6 flex flex-col gap-1">
            <span class="text-primary/35 text-xs font-bold uppercase tracking-[0.16em]">
              Archivo
            </span>
            <h2 class="text-2xl font-bold">Eventos anteriores</h2>
          </div>

          <div class="overflow-hidden rounded-3xl border border-primary/10">
            {pastEvents.map(({ title, speakers, place, date, tags }, index) => (
              <a
                href={`/eventos/${slugify(title)}`}
                data-event-tags={tags.join(",")}
                data-event-type="xauen"
                data-event-organizer="XauenDevs"
                class:list={[
                  "group flex flex-col gap-4 px-5 py-5 transition-colors hover:bg-primary/[0.025] md:flex-row md:items-center md:px-6",
                  index > 0 && "border-t border-primary/10",
                ]}
              >
                <time class="flex shrink-0 flex-col md:w-28" datetime={date.toISOString()}>
                  <span class="text-sm font-bold">
                    {date.toLocaleDateString("es-ES", {
                      day: "2-digit",
                      month: "short",
                    })}
                  </span>
                  <span class="text-xs text-primary/40">{date.getFullYear()}</span>
                </time>

                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="truncate font-semibold transition-colors group-hover:text-primary/70">
                      {title}
                    </h3>
                    {tags.map((tag) => (
                      <span class="rounded-full bg-primary/[0.05] px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide text-primary/45">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <p class="mt-1 truncate text-sm text-primary/50">
                    {speakers?.map((speaker) => speaker.name).join(" · ")}
                    {place && speakers?.length ? " · " : ""}
                    {place}
                  </p>
                </div>

                <span class="hidden text-primary/25 transition-transform group-hover:translate-x-1 md:block">
                  ↗
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </main>

  <script>
    const initializeEventFilters = () => {
    const tagButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tag-filter]"));
    const typeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-type-filter]"));
    const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-event-section]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-event-type]"));
    const clearButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-clear-filters], [data-clear-filters-empty]"));
    const filterResult = document.querySelector<HTMLElement>("[data-filter-result]");
    const filterEmpty = document.querySelector<HTMLElement>("[data-filter-empty]");
    const selectedTags = new Set();
    const selectedTypes = new Set();

    const matches = (card: HTMLElement) => {
      const tags = (card.dataset.eventTags || "").split(",").filter(Boolean);
      const matchesTopic = selectedTags.size === 0 || [...selectedTags].some((tag) => tags.includes(tag));
      const matchesType = selectedTypes.size === 0 || selectedTypes.has(card.dataset.eventType || "");
      return matchesTopic && matchesType;
    };

    const syncUrl = () => {
      const params = new URLSearchParams();
      if (selectedTypes.size) params.set("tipo", [...selectedTypes].join(","));
      if (selectedTags.size) params.set("tema", [...selectedTags].join(","));
      const query = params.toString();
      history.replaceState({}, "", query ? `${location.pathname}?${query}` : location.pathname);
    };

    const updateFilter = (sync = true) => {
      let visibleUpcoming = 0;
      cards.forEach((card) => {
        const visible = matches(card);
        card.classList.toggle("hidden", !visible);
        if (visible && card.dataset.upcoming === "true") visibleUpcoming++;
      });
      sections.forEach((section) => {
        section.classList.toggle("hidden", section.querySelectorAll('[data-event-tags]:not(.hidden)').length === 0);
      });
      [...tagButtons, ...typeButtons].forEach((button) => {
        const active = (button.dataset.tagFilter && selectedTags.has(button.dataset.tagFilter)) ||
          (button.dataset.typeFilter && selectedTypes.has(button.dataset.typeFilter));
        button.setAttribute("aria-pressed", String(Boolean(active)));
      });
      const hasFilters = selectedTags.size || selectedTypes.size;
      clearButtons.forEach((button) => button.classList.toggle("hidden", !hasFilters));
      filterEmpty?.classList.toggle("hidden", !hasFilters || visibleUpcoming > 0);
      if (filterResult) filterResult.textContent = visibleUpcoming === 1 ? "1 próximo evento coincide" : `${visibleUpcoming} próximos eventos coinciden`;
      if (sync) syncUrl();
    };

    const readUrl = () => {
      const params = new URLSearchParams(location.search);
      params.get("tipo")?.split(",").filter(Boolean).forEach((v) => selectedTypes.add(v));
      params.get("tema")?.split(",").filter(Boolean).forEach((v) => selectedTags.add(v));
    };

    tagButtons.forEach((button) => button.addEventListener("click", () => {
      const tag = button.dataset.tagFilter;
      if (!tag) return;
      selectedTags.has(tag) ? selectedTags.delete(tag) : selectedTags.add(tag);
      updateFilter();
    }));

    typeButtons.forEach((button) => button.addEventListener("click", () => {
      const type = button.dataset.typeFilter;
      if (!type) return;
      if (selectedTypes.has(type)) {
        selectedTypes.clear();
      } else {
        selectedTypes.clear();
        selectedTypes.add(type);
      }
      updateFilter();
    }));

    clearButtons.forEach((button) => button.addEventListener("click", () => {
      selectedTags.clear(); selectedTypes.clear(); updateFilter();
    }));

    readUrl();
    updateFilter(false);
    };

    initializeEventFilters();
    document.addEventListener("astro:page-load", initializeEventFilters);
  </script>
</Layout>
