---
import Layout from "@/layouts/Layout.astro";
import SeasonOverlay from "@/components/season/SeasonOverlay.astro";
import PivoCard from "@/components/PivoCard.astro";
import ExternalEventCard from "@/components/ExternalEventCard.astro";
import { getPivosStrapi } from "@/lib/get-info-pivos";
import { getPivoTags } from "@/lib/get-pivo-tags";
import { slugify } from "@/lib/event-slug";
import { getExternalEventsStrapi } from "@/lib/get-info-external-events";
import type { Pivo } from "@/types/Pivo";

// SSR: la temporada se decide en cada petición (ver src/lib/site-theme.ts).
export const prerender = false;

const events = (await getPivosStrapi()) ?? [];
const externalEvents = (await getExternalEventsStrapi()) ?? [];
const now = new Date();

const upcomingEvents = events
  .filter((event) => event.date >= now)
  .sort((a, b) => a.date.getTime() - b.date.getTime())
  .map((event) => ({ ...event, tags: getPivoTags(event.title) }));

const pastEvents = events
  .filter((event) => event.date < now)
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .map((event) => ({ ...event, tags: getPivoTags(event.title) }));

const upcomingExternalEvents = externalEvents
  .filter((event) => event.date >= now)
  .sort((a, b) => a.date.getTime() - b.date.getTime());

const totalUpcoming = upcomingEvents.length + upcomingExternalEvents.length;

const availableTags = Array.from(
  new Set([
    "Charlas",
    ...upcomingEvents.flatMap((event) => event.tags),
    ...pastEvents.flatMap((event) => event.tags),
    ...externalEvents.flatMap((event) => event.tags),
  ]),
);


---

<Layout
  title="Eventos tech en Jaén · XauenDevs"
  description="Agenda de eventos de tecnología y desarrollo en Jaén. Charlas, meetups y actividades de la comunidad."
>
  <main class="flex min-w-0 flex-col gap-8 py-2 sm:gap-10 md:gap-14">
    <header class="relative min-w-0 overflow-hidden rounded-3xl bg-black/[0.04] fest:bg-white/[0.04] px-5 py-7 sm:rounded-[2.5rem] sm:px-7 sm:py-10 md:px-12 md:py-14">
      <SeasonOverlay />

      <div class="relative flex flex-col gap-5">
        <h1 class="max-w-4xl break-words text-4xl font-black tracking-tight md:text-6xl">
          Agenda tech de Jaén
        </h1>

        <p class="max-w-2xl text-lg leading-relaxed text-black/80 fest:text-white/80 md:text-xl">
          Nuestras Pivo&Code y las charlas, meetups y talleres de otras comunidades, todo en un mismo sitio.
          {totalUpcoming > 0 && <strong class="font-bold"> {totalUpcoming === 1 ? "Hay 1 evento próximo." : `Hay ${totalUpcoming} eventos próximos.`}</strong>}
        </p>
      </div>
    </header>

    <nav aria-label="Filtrar eventos" class="flex flex-col gap-5 rounded-3xl bg-black/[0.04] p-5 fest:bg-white/[0.04] sm:p-6">
      <div class="flex flex-col gap-2">
        <span class="text-base font-bold">Quién lo organiza</span>
        <div class="-mx-1 flex items-center gap-2 overflow-x-auto px-1 pb-1 sm:flex-wrap sm:overflow-visible">
          <button type="button" data-type-filter="xauen" aria-pressed="false" class="filter-chip">XauenDevs</button>
          <button type="button" data-type-filter="external" aria-pressed="false" class="filter-chip">Eventos externos</button>
        </div>
      </div>
      <div class="flex flex-col gap-2">
        <span class="text-base font-bold">Tema</span>
        <div class="-mx-1 flex items-center gap-2 overflow-x-auto px-1 pb-1 sm:flex-wrap sm:overflow-visible">
          {availableTags.map((tag) => (
            <button type="button" data-tag-filter={tag} aria-pressed="false" class="filter-chip">{tag}</button>
          ))}
        </div>
        <p class="text-sm text-black/70 fest:text-white/70">Puedes elegir varios temas.</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" data-clear-filters class="hidden min-h-10 rounded-full px-3 text-sm font-semibold underline underline-offset-4">Quitar filtros</button>
        <p data-filter-status class="text-sm font-semibold text-black/75 fest:text-white/75" role="status" aria-live="polite"><span data-filter-result>0 próximos</span></p>
      </div>
      <div data-filter-empty class="hidden rounded-2xl bg-white p-5 fest:bg-white/[0.06]">
        <p class="font-semibold">No hay eventos que coincidan con estos filtros.</p>
        <button type="button" data-clear-filters-empty class="mt-2 font-semibold text-primary fest:text-white underline decoration-accent decoration-2 underline-offset-4">Quitar filtros</button>
      </div>
      <style>
        .filter-chip { flex-shrink:0; white-space:nowrap; min-height:2.5rem; border-radius:9999px; border:1px solid rgb(0 0 0 / .15); background:#fff; padding:.5rem 1rem; font-size:.9375rem; font-weight:600; color:#000; transition:border-color 150ms,background-color 150ms,color 150ms; }
        .filter-chip:hover { border-color:rgb(246 183 3); background:rgb(246 183 3 / .25); color:#000; }
        .filter-chip[aria-pressed="true"]::before { content:"\2713\00a0"; }
        :global([data-festive]) .filter-chip { border-color:rgb(255 255 255 / .15); background:rgb(255 255 255 / .04); color:rgb(255 255 255 / .75); }
        :global([data-festive]) .filter-chip:hover { border-color:rgb(var(--season-rgb) / .6); background:rgb(var(--season-rgb) / .18); color:#fff; }
        :global([data-festive]) .filter-chip[aria-pressed="true"] { border-color:rgb(var(--season-rgb)); background:rgb(var(--season-rgb)); color:#000; }
        .filter-chip[aria-pressed="true"] { border-color:rgb(246 183 3); background:rgb(246 183 3); color:#000; }
      </style>
    </nav>
    {
      upcomingEvents.length > 0 && (
        <section data-event-section class="flex min-w-0 flex-col gap-5 sm:gap-7">
          <h2 class="text-3xl font-black tracking-tight">Próximas Pivo&Code</h2>

          <div class="grid min-w-0 grid-cols-1 gap-4 sm:gap-5 md:grid-cols-2 lg:grid-cols-3">
            {upcomingEvents.map(
              ({ id, title, image, speakers, place, date, videoId, tags }: Pivo) => (
                <div class="min-w-0" data-event-tags={(tags ?? []).join(",")} data-event-type="xauen" data-upcoming="true" data-event-organizer="XauenDevs">
                <PivoCard
                  id={id}
                  title={title}
                  image={image}
                  speakers={speakers}
                  place={place}
                  date={date}
                  videoId={videoId}
                  tags={tags}
                  detailUrl={`/eventos/${slugify(title)}`}
                  customClass="!min-w-0 !max-w-full !w-full"
                />
                </div>
              )
            )}
          </div>
        </section>
      )
    }

    {
      upcomingExternalEvents.length > 0 && (
        <section data-event-section class="flex flex-col gap-7">
          <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
            <h2 class="text-3xl font-black tracking-tight">
              Otros eventos en Jaén
            </h2>
            <p class="max-w-md text-base leading-relaxed text-black/75 fest:text-white/75 md:text-right">
              Eventos de otras comunidades, empresas y organizaciones que
              pueden interesarte.
            </p>
          </div>

          <div class="grid min-w-0 grid-cols-1 gap-4 sm:gap-5 md:grid-cols-2 lg:grid-cols-3">
            {upcomingExternalEvents.map((event) => (
              <div class="min-w-0" data-event-tags={event.tags.join(",")} data-event-type="external" data-upcoming="true" data-event-organizer={event.organizer}>
                <ExternalEventCard event={event} />
              </div>
            ))}
          </div>
        </section>
      )
    }

    <section class="relative min-w-0 overflow-hidden rounded-3xl bg-accent px-5 py-6 fest:text-season-ink sm:rounded-[2rem] sm:px-7 sm:py-8 md:flex md:items-center md:justify-between md:gap-10 md:px-10">
      <div class="relative">
        <h2 class="text-2xl font-black md:text-3xl">
          ¿Conoces un evento que falta?
        </h2>
        <p class="mt-2 max-w-2xl text-base text-black/80 fest:text-season-ink/80">
          Si conoces un evento relacionado con tecnología en Jaén, compártelo
          con la comunidad y lo revisamos.
        </p>
      </div>
      <a
        href="/proponer-evento"
        class="relative mt-6 inline-flex min-h-12 shrink-0 items-center rounded-full !bg-black px-6 py-3 font-bold !text-white transition-transform duration-200 hover:-translate-y-0.5 md:mt-0"
      >
        Compartir evento →
      </a>
    </section>

    {
      pastEvents.length > 0 && (
        <section data-event-section class="pt-4">
          <h2 class="mb-6 text-3xl font-black tracking-tight">Charlas anteriores</h2>

          <div class="overflow-hidden rounded-3xl bg-black/[0.04] fest:bg-white/[0.04]">
            {pastEvents.map(({ title, speakers, place, date, tags }, index) => (
              <a
                href={`/eventos/${slugify(title)}`}
                data-event-tags={tags.join(",")}
                data-event-type="xauen"
                data-event-organizer="XauenDevs"
                class:list={[
                  "group flex flex-col gap-2 px-5 py-5 transition-colors hover:bg-black/[0.06] fest:hover:bg-white/[0.06] md:flex-row md:items-center md:gap-4 md:px-6",
                  index > 0 && "border-t border-black/10 fest:border-white/10",
                ]}
              >
                <time class="flex shrink-0 flex-col md:w-28" datetime={date.toISOString()}>
                  <span class="text-base font-bold">
                    {date.toLocaleDateString("es-ES", {
                      day: "numeric",
                      month: "short",
                      year: "numeric",
                      timeZone: "Europe/Madrid",
                    }).replace(".", "")}
                  </span>
                </time>

                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-base font-bold group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4 md:text-lg">
                      {title}
                    </h3>
                    {tags.filter((tag) => tag !== "Charlas").map((tag) => (
                      <span class="rounded-full bg-black/[0.07] px-2.5 py-0.5 text-[13px] font-medium fest:bg-white/10">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <p class="mt-1 text-sm text-black/75 fest:text-white/75">
                    {speakers?.map((speaker) => speaker.name).join(" · ")}
                    {place && speakers?.length ? " · " : ""}
                    {place}
                  </p>
                </div>

                <span class="hidden text-xl transition-transform group-hover:translate-x-1 md:block">
                  ↗
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </main>

  <script>
    const initializeEventFilters = () => {
    const tagButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tag-filter]"));
    const typeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-type-filter]"));
    const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-event-section]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-event-type]"));
    const clearButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-clear-filters], [data-clear-filters-empty]"));
    const filterResult = document.querySelector<HTMLElement>("[data-filter-result]");
    const filterEmpty = document.querySelector<HTMLElement>("[data-filter-empty]");
    const selectedTags = new Set<string>();
    const selectedTypes = new Set<string>();

    const matches = (card: HTMLElement) => {
      const tags = (card.dataset.eventTags || "").split(",").filter(Boolean);
      const matchesTopic = selectedTags.size === 0 || [...selectedTags].some((tag) => tags.includes(tag));
      const matchesType = selectedTypes.size === 0 || selectedTypes.has(card.dataset.eventType || "");
      return matchesTopic && matchesType;
    };

    const syncUrl = () => {
      const params = new URLSearchParams();
      if (selectedTypes.size) params.set("tipo", [...selectedTypes].join(","));
      if (selectedTags.size) params.set("tema", [...selectedTags].join(","));
      const query = params.toString();
      history.replaceState({}, "", query ? `${location.pathname}?${query}` : location.pathname);
    };

    const updateFilter = (sync = true) => {
      let visibleUpcoming = 0;
      cards.forEach((card) => {
        const visible = matches(card);
        card.classList.toggle("hidden", !visible);
        if (visible && card.dataset.upcoming === "true") visibleUpcoming++;
      });
      sections.forEach((section) => {
        section.classList.toggle("hidden", section.querySelectorAll('[data-event-tags]:not(.hidden)').length === 0);
      });
      [...tagButtons, ...typeButtons].forEach((button) => {
        const active = (button.dataset.tagFilter && selectedTags.has(button.dataset.tagFilter)) ||
          (button.dataset.typeFilter && selectedTypes.has(button.dataset.typeFilter));
        button.setAttribute("aria-pressed", String(Boolean(active)));
      });
      const hasFilters = selectedTags.size || selectedTypes.size;
      clearButtons.forEach((button) => button.classList.toggle("hidden", !hasFilters));
      filterEmpty?.classList.toggle("hidden", !hasFilters || visibleUpcoming > 0);
      if (filterResult) filterResult.textContent = visibleUpcoming === 1 ? "1 próximo evento coincide" : `${visibleUpcoming} próximos eventos coinciden`;
      if (sync) syncUrl();
    };

    const readUrl = () => {
      const params = new URLSearchParams(location.search);
      params.get("tipo")?.split(",").filter(Boolean).forEach((v) => selectedTypes.add(v));
      params.get("tema")?.split(",").filter(Boolean).forEach((v) => selectedTags.add(v));
    };

    tagButtons.forEach((button) => button.addEventListener("click", () => {
      const tag = button.dataset.tagFilter;
      if (!tag) return;
      selectedTags.has(tag) ? selectedTags.delete(tag) : selectedTags.add(tag);
      updateFilter();
    }));

    typeButtons.forEach((button) => button.addEventListener("click", () => {
      const type = button.dataset.typeFilter;
      if (!type) return;
      if (selectedTypes.has(type)) {
        selectedTypes.clear();
      } else {
        selectedTypes.clear();
        selectedTypes.add(type);
      }
      updateFilter();
    }));

    clearButtons.forEach((button) => button.addEventListener("click", () => {
      selectedTags.clear(); selectedTypes.clear(); updateFilter();
    }));

    readUrl();
    updateFilter(false);
    };

    initializeEventFilters();
    document.addEventListener("astro:page-load", initializeEventFilters);
  </script>
</Layout>
