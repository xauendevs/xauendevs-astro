---
import { getPivosStrapi } from "@/lib/get-info-pivos";
import { slugify } from "@/lib/event-slug";

// Keep this route dynamic so it always points to the next scheduled Pivo.
export const prerender = false;

const now = Date.now();
const pivos = (await getPivosStrapi()) ?? [];
const nextPivo = pivos
  .filter((pivo) => pivo.date instanceof Date && pivo.date.getTime() > now)
  .sort((a, b) => a.date.getTime() - b.date.getTime())[0];

if (!nextPivo) {
  return Astro.redirect("/eventos", 302);
}

return Astro.redirect(`/eventos/${slugify(nextPivo.title)}`, 302);
---
